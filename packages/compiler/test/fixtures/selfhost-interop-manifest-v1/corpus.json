{
	"version": 1,
	"cases": [
		{
			"id": "canonical-order",
			"accepted": true,
			"input": {
				"contractVersion": "1",
				"languageVersion": "1.0",
				"platform": "node",
				"entryPath": ".\\src\\main.virune",
				"sources": [
					{"path":"src\\z.virune","text":"fn z() -> Int { return 2 }\n"},
					{"path":"./src/part/../main.virune","text":"pub fn main() -> Int { return 1 }\n"}
				],
				"interopManifest": {
					"version": "1",
					"modules": [
						{"specifier":"zeta","metadata":{"z":1,"nested":{"b":true,"a":false},"a":2}},
						{"specifier":"@scope/alpha","metadata":{"values":[{"b":2,"a":1}],"flag":true}}
					]
				},
				"emit": {"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"entryPath": "src/main.virune",
			"sourcePaths": ["src/main.virune", "src/z.virune"],
			"moduleSpecifiers": ["@scope/alpha", "zeta"],
			"metadataKeys": [["flag", "values"], ["a", "nested", "z"]]
		},
		{
			"id": "duplicate-specifier",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"neutral","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{}},{"specifier":"example","metadata":{"a":1}}]},
				"emit":{"target":"es2022","sourceMap":false,"sourcesContent":false}
			},
			"errorPath": "$.interopManifest.modules",
			"errorIncludes": "duplicate specifier example"
		},
		{
			"id": "empty-specifier",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"browser","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"","metadata":{}}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":false}
			},
			"errorPath": "$.interopManifest.modules[0].specifier",
			"errorIncludes": "string must not be empty"
		},
		{
			"id": "invalid-import-kind",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{"imports":[{"kind":"dynamic"}]}}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.modules[0].metadata.imports[0].kind",
			"errorIncludes": "expected one of named, default, namespace, type-only, side-effect"
		},
		{
			"id": "invalid-runtime-format",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{"resolutionWitness":{"moduleSpecifier":"example","conditions":[],"platform":"node","providerVersion":"1","runtimeFormat":"amd"}}}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.modules[0].metadata.resolutionWitness.runtimeFormat",
			"errorIncludes": "expected one of esm, commonjs, builtin, bundler, unknown"
		},
		{
			"id": "invalid-version-type",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":1,"modules":[]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.version",
			"errorIncludes": "unsupported Interop Manifest version 1; expected \"1\""
		},
		{
			"id": "metadata-array",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":[]}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.modules[0].metadata",
			"errorIncludes": "expected an object"
		},
		{
			"id": "named-import-missing-name",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{"imports":[{"kind":"named"}]}}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.modules[0].metadata.imports[0].importedName",
			"errorIncludes": "importedName is required for named imports"
		},
		{
			"id": "stale-version",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"2","modules":[]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.version",
			"errorIncludes": "unsupported Interop Manifest version \"2\"; expected \"1\""
		},
		{
			"id": "typed-imports-and-witness",
			"accepted": true,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{"legacy":true,"imports":[{"kind":"type-only","importedName":"Shape"},{"kind":"default"},{"kind":"named","importedName":"value"},{"kind":"namespace"},{"kind":"side-effect"}],"resolutionWitness":{"moduleSpecifier":"example","conditions":["node","import"],"platform":"node","providerVersion":"1","runtimeFormat":"esm"}}}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"entryPath": "main.virune",
			"sourcePaths": ["main.virune"],
			"moduleSpecifiers": ["example"],
			"metadataKeys": [["imports", "legacy", "resolutionWitness"]]
		},
		{
			"id": "unknown-module-property",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{},"extra":true}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.modules[0].extra",
			"errorIncludes": "unknown property"
		},
		{
			"id": "witness-platform-mismatch",
			"accepted": false,
			"input": {
				"contractVersion":"1","languageVersion":"1.0","platform":"node","entryPath":"main.virune",
				"sources":[{"path":"main.virune","text":"pub fn main() -> Int { return 1 }\n"}],
				"interopManifest":{"version":"1","modules":[{"specifier":"example","metadata":{"resolutionWitness":{"moduleSpecifier":"example","conditions":[],"platform":"browser","providerVersion":"1"}}}]},
				"emit":{"target":"es2022","sourceMap":true,"sourcesContent":true}
			},
			"errorPath": "$.interopManifest.modules[0].metadata.resolutionWitness.platform",
			"errorIncludes": "must match input platform \"node\""
		}
	]
}
