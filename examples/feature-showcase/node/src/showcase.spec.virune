import { UserId, createUser } from "./domain.virune"

 test "domain model trims validated names" {
	let result = createUser(UserId.create(7), " Alice ", None)
	let valid = match result {
		Ok(user) => user.name == "Alice"
		Err(_) => false
	}
	expect(valid)
}

test "map and set operations compose" {
	let index = Map.set(Map.empty<String, Int>(), "users", 2)
	let tags = Set.add(Set.from(["directory"]), "showcase")
	expect(Map.size(index) == 1)
	expect(Set.has(tags, "showcase"))
}
