import { createUserFromInt, displayUser } from "./domain.virune"

fn cleanupLoad() -> Unit {
	return Unit
}

async fn loadPrimary() -> Result<String, String> {
	let created = createUserFromInt(1, " Alice ", Some("alice@example.com"))
	return match created {
		Ok(user) => Ok(displayUser(user))
		Err(_) => Err("primary user is invalid")
	}
}

async fn loadSecondary() -> Result<String, String> {
	let created = createUserFromInt(2, "Bob", None)
	return match created {
		Ok(user) => Ok(displayUser(user))
		Err(_) => Err("secondary user is invalid")
	}
}

pub async fn loadDirectory() -> Result<List<String>, String> {
	defer cleanupLoad()
	let loaded = await (parallel try {
		primary: loadPrimary(),
		secondary: loadSecondary(),
	})?
	return Ok([loaded.primary, loaded.secondary])
}
