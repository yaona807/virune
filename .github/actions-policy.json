{
	"schemaVersion": 2,
	"allowedReferences": {
		"actions/checkout": ["v7"],
		"actions/dependency-review-action": ["v5"],
		"actions/download-artifact": ["v8"],
		"actions/setup-node": ["v7"],
		"actions/upload-artifact": ["v7"],
		"github/codeql-action/analyze": ["v4"],
		"github/codeql-action/init": ["v4"]
	},
	"workflowPermissions": {
		"default": {
			"contents": "read"
		},
		"exceptions": {
			"codeql.yml": {
				"contents": "read",
				"security-events": "write"
			},
			"release-dry-run.yml": {
				"actions": "read",
				"contents": "read"
			},
			"release.yml": {
				"actions": "read",
				"contents": "write"
			}
		}
	}
}
