{
  "publicationReady": false,
  "forbidRegistryPublishThroughVersion": "1.0.0",
  "firstStableRegistryRelease": "1.1.0",
  "distTagPolicy": {
    "stable": "latest",
    "prerelease": "next",
    "nightly": null
  },
  "packages": [
    {
      "directory": "cli",
      "workspaceName": "virune"
    },
    {
      "directory": "compiler",
      "workspaceName": "@virune/compiler"
    },
    {
      "directory": "formatter",
      "workspaceName": "@virune/formatter"
    },
    {
      "directory": "js-interop",
      "workspaceName": "@virune/js-interop"
    },
    {
      "directory": "runtime",
      "workspaceName": "@virune/runtime"
    },
    {
      "directory": "stdlib",
      "workspaceName": "@virune/stdlib"
    }
  ],
  "excludedWorkspacePackages": [
    {
      "directory": "language-server",
      "workspaceName": "@virune/language-server"
    },
    {
      "directory": "vscode",
      "workspaceName": "virune-vscode"
    }
  ]
}
