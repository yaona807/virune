{
  "schemaVersion": 1,
  "stage": "prepublication-audit",
  "publicationReady": false,
  "unresolvedRequirements": [
    "registry-ownership",
    "trusted-publishing",
    "release-identity-integration",
    "public-registry-verification"
  ],
  "forbidRegistryPublishThroughVersion": "1.0.0",
  "firstStableRegistryRelease": "1.1.0",
  "trustedPublishingRequired": true,
  "publicVerificationRequired": true,
  "sameReviewedReleaseIdentityRequired": true,
  "packages": [
    {
      "directory": "cli",
      "name": "virune",
      "role": "cli"
    },
    {
      "directory": "compiler",
      "name": "@virune/compiler",
      "role": "cli-dependency"
    },
    {
      "directory": "formatter",
      "name": "@virune/formatter",
      "role": "cli-dependency"
    },
    {
      "directory": "js-interop",
      "name": "@virune/js-interop",
      "role": "cli-dependency"
    },
    {
      "directory": "runtime",
      "name": "@virune/runtime",
      "role": "cli-dependency"
    },
    {
      "directory": "stdlib",
      "name": "@virune/stdlib",
      "role": "cli-dependency"
    }
  ],
  "excludedWorkspacePackages": [
    {
      "directory": "language-server",
      "name": "@virune/language-server",
      "reason": "Implementation component of the official editor integration; not required by the npm CLI distribution contract."
    },
    {
      "directory": "vscode",
      "name": "virune-vscode",
      "reason": "Distributed as the official VS Code extension rather than as an npm runtime package."
    }
  ]
}
