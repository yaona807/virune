{
  "schemaVersion": 1,
  "publicationReady": false,
  "forbidRegistryPublishThroughVersion": "1.0.0",
  "firstStableRegistryRelease": "1.1.0",
  "distTagPolicy": {
    "stable": "latest",
    "prerelease": "next",
    "nightly": null
  },
  "packages": [
    {
      "directory": "cli",
      "workspaceName": "virune",
      "registryName": "virune",
      "role": "cli"
    },
    {
      "directory": "compiler",
      "workspaceName": "@virune/compiler",
      "registryName": "@virune/compiler",
      "role": "cli-dependency"
    },
    {
      "directory": "formatter",
      "workspaceName": "@virune/formatter",
      "registryName": "@virune/formatter",
      "role": "cli-dependency"
    },
    {
      "directory": "js-interop",
      "workspaceName": "@virune/js-interop",
      "registryName": "@virune/js-interop",
      "role": "cli-dependency"
    },
    {
      "directory": "runtime",
      "workspaceName": "@virune/runtime",
      "registryName": "@virune/runtime",
      "role": "cli-dependency"
    },
    {
      "directory": "stdlib",
      "workspaceName": "@virune/stdlib",
      "registryName": "@virune/stdlib",
      "role": "cli-dependency"
    }
  ],
  "excludedWorkspacePackages": [
    {
      "directory": "language-server",
      "workspaceName": "@virune/language-server",
      "reason": "Implementation component of the official editor integration; not required by the npm CLI distribution contract."
    },
    {
      "directory": "vscode",
      "workspaceName": "virune-vscode",
      "reason": "Distributed as the official VS Code extension rather than as an npm runtime package."
    }
  ]
}
