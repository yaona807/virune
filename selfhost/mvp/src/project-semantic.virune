//! Project-wide semantic context validation for the self-host compiler.

pub record ProjectSemanticSymbol derives Eq, Debug, Json {
	name: String
	declarationKind: String
	public: Bool
	effect: String
}

pub record ProjectSemanticReference derives Eq, Debug, Json {
	name: String
	targetModulePath: String
	targetName: String
	requiredEffect: String
}

pub record ProjectSemanticModule derives Eq, Debug, Json {
	path: String
	allowedEffects: List<String>
	symbols: List<ProjectSemanticSymbol>
	references: List<ProjectSemanticReference>
}

pub record ProjectSemanticRequest derives Eq, Debug, Json {
	modules: List<ProjectSemanticModule>
}

pub record ProjectSemanticDiagnostic derives Eq, Debug, Json {
	code: String
	severity: String
	message: String
	modulePath: String
	symbolName: String?
	targetModulePath: String?
	targetName: String?
}

pub record ProjectSemanticResult derives Eq, Debug, Json {
	accepted: Bool
	checkedModules: Int
	diagnostics: List<ProjectSemanticDiagnostic>
}

fn semanticDiagnostic(
	code: String,
	message: String,
	modulePath: String,
	symbolName: String?,
	targetModulePath: String?,
	targetName: String?,
) -> ProjectSemanticDiagnostic {
	return ProjectSemanticDiagnostic {
		code: code,
		severity: "error",
		message: message,
		modulePath: modulePath,
		symbolName: symbolName,
		targetModulePath: targetModulePath,
		targetName: targetName,
	}
}

fn containsText(values: List<String>, expected: String) -> Bool {
	for value in values {
		if value == expected {
			return true
		}
	}
	return false
}

fn moduleExists(modules: List<ProjectSemanticModule>, path: String) -> Bool {
	for module in modules {
		if module.path == path {
			return true
		}
	}
	return false
}

fn symbolExists(module: ProjectSemanticModule, name: String) -> Bool {
	for symbol in module.symbols {
		if symbol.name == name {
			return true
		}
	}
	return false
}

fn symbolPublic(module: ProjectSemanticModule, name: String) -> Bool {
	for symbol in module.symbols {
		if symbol.name == name {
			return symbol.public
		}
	}
	return false
}

fn targetSymbolExists(
	modules: List<ProjectSemanticModule>,
	modulePath: String,
	name: String,
) -> Bool {
	for module in modules {
		if module.path == modulePath {
			return symbolExists(module, name)
		}
	}
	return false
}

fn targetSymbolPublic(
	modules: List<ProjectSemanticModule>,
	modulePath: String,
	name: String,
) -> Bool {
	for module in modules {
		if module.path == modulePath {
			return symbolPublic(module, name)
		}
	}
	return false
}

fn duplicateSymbolDiagnostics(module: ProjectSemanticModule) -> List<ProjectSemanticDiagnostic> {
	let mut diagnostics: List<ProjectSemanticDiagnostic> = []
	let mut seen: List<String> = []
	for symbol in module.symbols {
		if String.length(symbol.name) == 0 {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3001",
				"Project symbol name must not be empty",
				module.path,
				Some(symbol.name),
				None,
				None,
			))
		} else if containsText(seen, symbol.name) {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3002",
				"Duplicate project symbol " + symbol.name,
				module.path,
				Some(symbol.name),
				None,
				None,
			))
		} else {
			seen = List.append(seen, symbol.name)
		}
	}
	return diagnostics
}

fn referenceDiagnostics(
	modules: List<ProjectSemanticModule>,
	module: ProjectSemanticModule,
) -> List<ProjectSemanticDiagnostic> {
	let mut diagnostics: List<ProjectSemanticDiagnostic> = []
	for reference in module.references {
		if !moduleExists(modules, reference.targetModulePath) {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3101",
				"Reference target module does not exist",
				module.path,
				Some(reference.name),
				Some(reference.targetModulePath),
				Some(reference.targetName),
			))
		} else if !targetSymbolExists(modules, reference.targetModulePath, reference.targetName) {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3102",
				"Reference target symbol does not exist",
				module.path,
				Some(reference.name),
				Some(reference.targetModulePath),
				Some(reference.targetName),
			))
		} else if reference.targetModulePath != module.path
			&& !targetSymbolPublic(modules, reference.targetModulePath, reference.targetName) {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3103",
				"Cross-module reference targets a private symbol",
				module.path,
				Some(reference.name),
				Some(reference.targetModulePath),
				Some(reference.targetName),
			))
		}
		if String.length(reference.requiredEffect) > 0
			&& !containsText(module.allowedEffects, reference.requiredEffect) {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3201",
				"Reference requires unavailable effect " + reference.requiredEffect,
				module.path,
				Some(reference.name),
				Some(reference.targetModulePath),
				Some(reference.targetName),
			))
		}
	}
	return diagnostics
}

pub fn checkProjectSemantics(request: ProjectSemanticRequest) -> ProjectSemanticResult {
	let mut diagnostics: List<ProjectSemanticDiagnostic> = []
	let mut seenModules: List<String> = []
	for module in request.modules {
		if String.length(module.path) == 0 {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3000",
				"Project module path must not be empty",
				module.path,
				None,
				None,
				None,
			))
		} else if containsText(seenModules, module.path) {
			diagnostics = List.append(diagnostics, semanticDiagnostic(
				"SHP3003",
				"Duplicate project module " + module.path,
				module.path,
				None,
				Some(module.path),
				None,
			))
		} else {
			seenModules = List.append(seenModules, module.path)
		}
		for diagnostic in duplicateSymbolDiagnostics(module) {
			diagnostics = List.append(diagnostics, diagnostic)
		}
	}
	for module in request.modules {
		for diagnostic in referenceDiagnostics(request.modules, module) {
			diagnostics = List.append(diagnostics, diagnostic)
		}
	}
	return ProjectSemanticResult {
		accepted: List.length(diagnostics) == 0,
		checkedModules: List.length(request.modules),
		diagnostics: diagnostics,
	}
}

fn decodeProjectSemanticRequest(encoded: String) -> Result<ProjectSemanticRequest, List<JsonError>> {
	let raw = Json.parse(encoded)?
	return Json.decode<ProjectSemanticRequest>(raw)
}

pub fn checkProjectSemanticsJson(encoded: String) -> Result<String, List<JsonError>> {
	return Json.encode<ProjectSemanticResult>(
		checkProjectSemantics(decodeProjectSemanticRequest(encoded)?),
	)
}
