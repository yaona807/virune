//! Canonical flat AST model for the Virune-authored frontend parser.

import { FrontendDiagnostic, FrontendSpan } from "./frontend-model.virune"

pub record FrontendAstNode derives Eq, Debug, Json {
	id: Int
	kind: String
	text: String
	span: FrontendSpan
	children: List<Int>
	documentation: List<String>
}

pub record FrontendParseResult derives Eq, Debug, Json {
	accepted: Bool
	root: Int
	nodes: List<FrontendAstNode>
	diagnostics: List<FrontendDiagnostic>
}

pub fn frontendAstNode(
	id: Int,
	kind: String,
	text: String,
	span: FrontendSpan,
	children: List<Int>,
	documentation: List<String>,
) -> FrontendAstNode {
	return FrontendAstNode {
		id: id,
		kind: kind,
		text: text,
		span: span,
		children: children,
		documentation: documentation,
	}
}
