import {
	MvpCompilation,
	MvpDiagnostic,
	MvpExport,
	MvpHirExpression,
	MvpHirFunction,
	MvpHirModule,
	MvpSpan,
	MvpStatement,
	MvpType,
	mvpDiagnostic,
} from "./model.virune"

record MvpEmitInput derives Json {
	hirModule: MvpHirModule?
	diagnostics: List<MvpDiagnostic>
	exports: List<MvpExport>
}

fn emptyDiagnostics() -> List<MvpDiagnostic> {
	let values: List<MvpDiagnostic> = []
	return values
}

fn emptyExports() -> List<MvpExport> {
	let values: List<MvpExport> = []
	return values
}

fn safeName(name: String) -> String {
	let reserved = [
		"await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete",
		"do", "else", "export", "extends", "false", "finally", "for", "function", "if", "import", "in",
		"instanceof", "let", "new", "null", "return", "static", "super", "switch", "this", "throw", "true",
		"try", "typeof", "var", "void", "while", "with", "yield",
	]
	for value in reserved {
		if value == name {
			return "$v_" + name
		}
	}
	return name
}

fn quote(value: String) -> String {
	let mut result = "\""
	let mut index = 0
	while index < String.length(value) {
		let character = String.slice(value, index, Some(index + 1))
		if character == "\\" {
			result = result + "\\\\"
		} else if character == "\"" {
			result = result + "\\\""
		} else if character == "\n" {
			result = result + "\\n"
		} else if character == "\r" {
			result = result + "\\r"
		} else if character == "\t" {
			result = result + "\\t"
		} else {
			result = result + character
		}
		index = index + 1
	}
	return result + "\""
}

fn indent(depth: Int) -> String {
	let mut result = ""
	let mut index = 0
	while index < depth {
		result = result + "\t"
		index = index + 1
	}
	return result
}

fn expressionAt(expressions: List<MvpHirExpression>, id: Int) -> MvpHirExpression? {
	return List.get(expressions, id)
}

fn statementAt(statements: List<MvpStatement>, id: Int) -> MvpStatement? {
	return List.get(statements, id)
}

fn emitArguments(ids: List<Int>, expressions: List<MvpHirExpression>) -> List<String> {
	let mut values: List<String> = []
	for id in ids {
		values = List.append(values, emitExpressionById(id, expressions))
	}
	return values
}

fn emitPatternById(id: Int, expressions: List<MvpHirExpression>) -> String {
	let value = expressionAt(expressions, id)
	return match value {
		Some(expression) => emitPattern(expression, expressions)
		None => "_"
	}
}

fn emitPattern(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	if expression.kind == "patternWildcard" {
		return "_"
	}
	if expression.kind == "patternBinding" {
		return safeName(expression.text)
	}
	if expression.kind == "patternLiteral" {
		return if expression.valueType == MvpType.StringType then quote(expression.text) else expression.text
	}
	if expression.kind == "patternConstructor" {
		if List.isEmpty(expression.children) {
			return expression.text
		}
		let values: List<String> = []
		let mut parts = values
		for childId in expression.children {
			parts = List.append(parts, emitPatternById(childId, expressions))
		}
		return expression.text + "(" + String.join(parts, ", ") + ")"
	}
	return "_"
}

fn emitMatchArm(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	if List.length(expression.children) != 2 {
		return "_ => undefined"
	}
	let patternId = match List.get(expression.children, 0) {
		Some(value) => value
		None => -1
	}
	let bodyId = match List.get(expression.children, 1) {
		Some(value) => value
		None => -1
	}
	return emitPatternById(patternId, expressions) + " => " + emitExpressionById(bodyId, expressions)
}

fn emitExpressionById(id: Int, expressions: List<MvpHirExpression>) -> String {
	let value = expressionAt(expressions, id)
	return match value {
		Some(expression) => emitExpression(expression, expressions)
		None => "undefined"
	}
}

fn emitList(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	return "[" + String.join(emitArguments(expression.children, expressions), ", ") + "]"
}

fn emitObject(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let mut entries: List<String> = []
	let mut index = 0
	while index + 1 < List.length(expression.children) {
		let keyId = match List.get(expression.children, index) {
			Some(value) => value
			None => -1
		}
		let valueId = match List.get(expression.children, index + 1) {
			Some(value) => value
			None => -1
		}
		let key = expressionAt(expressions, keyId)
		let keyText = match key {
			Some(keyExpression) => quote(keyExpression.text)
			None => quote("")
		}
		entries = List.append(entries, keyText + ": " + emitExpressionById(valueId, expressions))
		index = index + 2
	}
	return "{" + String.join(entries, ", ") + "}"
}

fn emitUnary(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let operandId = match List.get(expression.children, 0) {
		Some(value) => value
		None => -1
	}
	let operand = emitExpressionById(operandId, expressions)
	if expression.text == "!" {
		return "(!" + operand + ")"
	}
	if expression.text == "-" {
		return "(-" + operand + ")"
	}
	return operand
}

fn binaryRuntimeHelper(operator: String) -> String {
	if operator == "+" {
		return "intAdd"
	}
	if operator == "-" {
		return "intSubtract"
	}
	if operator == "*" {
		return "intMultiply"
	}
	if operator == "/" {
		return "intDivide"
	}
	if operator == "%" {
		return "intRemainder"
	}
	return ""
}

fn emitBinary(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let leftId = match List.get(expression.children, 0) {
		Some(value) => value
		None => -1
	}
	let rightId = match List.get(expression.children, 1) {
		Some(value) => value
		None => -1
	}
	let left = emitExpressionById(leftId, expressions)
	let right = emitExpressionById(rightId, expressions)
	let helper = binaryRuntimeHelper(expression.text)
	if String.length(helper) > 0 && expression.valueType == MvpType.IntType {
		return helper + "(" + left + ", " + right + ")"
	}
	if expression.text == "==" {
		return "viruneEquals(" + left + ", " + right + ")"
	}
	if expression.text == "!=" {
		return "(!viruneEquals(" + left + ", " + right + "))"
	}
	return "(" + left + " " + expression.text + " " + right + ")"
}

fn emitCall(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let values = emitArguments(expression.children, expressions)
	let callee = safeName(expression.text)
	if List.isEmpty(values) {
		return callee + "($ctx)"
	}
	return callee + "(" + String.join(values, ", ") + ", $ctx)"
}

fn emitExternalVariant(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let values = emitArguments(expression.children, expressions)
	let callee = safeName(expression.text)
	if List.isEmpty(values) {
		return callee + "()"
	}
	return callee + "(" + String.join(values, ", ") + ")"
}

fn emitVariant(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let values = emitArguments(expression.children, expressions)
	return "({$tag: " + quote(expression.text) + ", $values: [" + String.join(values, ", ") + "]})"
}

fn emitMember(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let objectId = match List.get(expression.children, 0) {
		Some(value) => value
		None => -1
	}
	return emitExpressionById(objectId, expressions) + "." + safeName(expression.text)
}

fn emitIndex(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let objectId = match List.get(expression.children, 0) {
		Some(value) => value
		None => -1
	}
	let indexId = match List.get(expression.children, 1) {
		Some(value) => value
		None => -1
	}
	return emitExpressionById(objectId, expressions) + "[" + emitExpressionById(indexId, expressions) + "]"
}

fn emitMatch(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	if List.isEmpty(expression.children) {
		return "undefined"
	}
	let subjectId = match List.get(expression.children, 0) {
		Some(value) => value
		None => -1
	}
	let mut arms: List<String> = []
	let mut index = 1
	while index < List.length(expression.children) {
		let armId = match List.get(expression.children, index) {
			Some(value) => value
			None => -1
		}
		let arm = expressionAt(expressions, armId)
		match arm {
			Some(armExpression) => {
				if armExpression.kind == "matchArm" {
					arms = List.append(arms, emitMatchArm(armExpression, expressions))
				}
			}
			None => {}
		}
		index = index + 1
	}
	return "matchValue(" + emitExpressionById(subjectId, expressions) + ", [" + String.join(arms, ", ") + "])"
}

fn emitExpression(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	if expression.kind == "literal" {
		return if expression.valueType == MvpType.StringType then quote(expression.text) else expression.text
	}
	if expression.kind == "local" {
		return safeName(expression.text)
	}
	if expression.kind == "function" {
		return safeName(expression.text)
	}
	if expression.kind == "list" {
		return emitList(expression, expressions)
	}
	if expression.kind == "object" {
		return emitObject(expression, expressions)
	}
	if expression.kind == "unary" {
		return emitUnary(expression, expressions)
	}
	if expression.kind == "binary" {
		return emitBinary(expression, expressions)
	}
	if expression.kind == "call" {
		return emitCall(expression, expressions)
	}
	if expression.kind == "externalVariant" {
		return emitExternalVariant(expression, expressions)
	}
	if expression.kind == "variant" {
		return emitVariant(expression, expressions)
	}
	if expression.kind == "member" {
		return emitMember(expression, expressions)
	}
	if expression.kind == "index" {
		return emitIndex(expression, expressions)
	}
	if expression.kind == "match" {
		return emitMatch(expression, expressions)
	}
	return "undefined"
}

fn emitStatementById(
	id: Int,
	function: MvpHirFunction,
	depth: Int,
) -> List<String> {
	let value = statementAt(function.statements, id)
	return match value {
		Some(statement) => emitStatement(statement, function, depth)
		None => []
	}
}

fn emitStatementIds(
	ids: List<Int>,
	function: MvpHirFunction,
	depth: Int,
) -> List<String> {
	let mut lines: List<String> = []
	for id in ids {
		for line in emitStatementById(id, function, depth) {
			lines = List.append(lines, line)
		}
	}
	return lines
}

fn emitStatement(
	statement: MvpStatement,
	function: MvpHirFunction,
	depth: Int,
) -> List<String> {
	let prefix = indent(depth)
	return match statement {
		LetValue(name, mutable, _, initializerId, _) => [prefix + (if mutable then "let " else "const ") + safeName(name) + " = " + emitExpressionById(initializerId, function.expressions) + ";"]
		AssignValue(name, expressionId, _) => [prefix + safeName(name) + " = " + emitExpressionById(expressionId, function.expressions) + ";"]
		ForValue(name, iterableId, bodyIds, _) => {
			let mut lines = [prefix + "for (const " + safeName(name) + " of " + emitExpressionById(iterableId, function.expressions) + ") {"]
			for line in emitStatementIds(bodyIds, function, depth + 1) {
				lines = List.append(lines, line)
			}
			List.append(lines, prefix + "}")
		}
		WhileValue(conditionId, bodyIds, _) => {
			let mut lines = [prefix + "while (" + emitExpressionById(conditionId, function.expressions) + ") {"]
			for line in emitStatementIds(bodyIds, function, depth + 1) {
				lines = List.append(lines, line)
			}
			List.append(lines, prefix + "}")
		}
		IfValue(conditionId, thenIds, elseIds, _) => {
			let mut lines = [prefix + "if (" + emitExpressionById(conditionId, function.expressions) + ") {"]
			for line in emitStatementIds(thenIds, function, depth + 1) {
				lines = List.append(lines, line)
			}
			lines = List.append(lines, prefix + "}")
			if !List.isEmpty(elseIds) {
				lines = List.append(lines, prefix + "else {")
				for line in emitStatementIds(elseIds, function, depth + 1) {
					lines = List.append(lines, line)
				}
				lines = List.append(lines, prefix + "}")
			}
			lines
		}
		BreakValue(_) => [prefix + "break;"]
		ContinueValue(_) => [prefix + "continue;"]
		ReturnValue(expressionId, _) => [prefix + "return " + emitExpressionById(expressionId, function.expressions) + ";"]
	}
}

fn emitFunction(function: MvpHirFunction) -> String {
	let mut parameters: List<String> = []
	for parameter in function.parameters {
		parameters = List.append(parameters, safeName(parameter.name))
	}
	parameters = List.append(parameters, "$ctx = rootTaskContext()")
	let prefix = if function.isPublic then "export " else ""
	let mut lines = [prefix + "function " + safeName(function.name) + "(" + String.join(parameters, ", ") + ") {"]
	lines = List.append(lines, "\ttry {")
	for line in emitStatementIds(function.statementIds, function, 2) {
		lines = List.append(lines, line)
	}
	lines = List.append(lines, "\t} catch ($error) {")
	lines = List.append(lines, "\t\tif (isPropagation($error)) return $error.value;")
	lines = List.append(lines, "\t\tthrow $error;")
	lines = List.append(lines, "\t}")
	lines = List.append(lines, "}")
	return String.join(lines, "\n")
}

fn emitModule(module: MvpHirModule) -> String {
	let mut blocks: List<String> = []
	for function in module.functions {
		blocks = List.append(blocks, emitFunction(function))
	}
	return String.join(blocks, "\n\n") + (if List.isEmpty(blocks) then "" else "\n")
}

fn failureCompilation(diagnostics: List<MvpDiagnostic>, exports: List<MvpExport>) -> MvpCompilation {
	return MvpCompilation {
		accepted: false,
		diagnostics: diagnostics,
		exports: exports,
		codeBody: "",
	}
}

pub fn emitMvpJson(encoded: String) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let input = Json.decode<MvpEmitInput>(raw)?
	if !List.isEmpty(input.diagnostics) {
		return Json.encode<MvpCompilation>(failureCompilation(input.diagnostics, input.exports))
	}
	return match input.hirModule {
		Some(module) => Json.encode<MvpCompilation>(MvpCompilation {
			accepted: true,
			diagnostics: emptyDiagnostics(),
			exports: input.exports,
			codeBody: emitModule(module),
		})
		None => Json.encode<MvpCompilation>(failureCompilation(
			[mvpDiagnostic("L4001", "Emitter requires a checked HIR module", MvpSpan { start: input.exports |> List.first() |> match { Some(value) => value.span.start, None => MvpPosition { offset: 0, line: 1, column: 1 } }, end: input.exports |> List.first() |> match { Some(value) => value.span.end, None => MvpPosition { offset: 0, line: 1, column: 1 } } })],
			input.exports,
		))
	}
}
