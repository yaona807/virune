//! Readable ES2022 emitter for the checked MVP HIR.

import {
	MvpCompilation,
	MvpDiagnostic,
	MvpExport,
	MvpHirExpression,
	MvpHirFunction,
	MvpHirModule,
	MvpHirStatement,
	MvpParameter,
	MvpType,
} from "./model.virune"

record MvpCheckTransport derives Json {
	hirModule: MvpHirModule?
	diagnostics: List<MvpDiagnostic>
	exports: List<MvpExport>
}

fn parameterNames(parameters: List<MvpParameter>) -> List<String> {
	let mut values: List<String> = []
	for parameter in parameters {
		values = List.append(values, parameter.name)
	}
	return values
}

fn expressionAt(expressions: List<MvpHirExpression>, expressionId: Int) -> MvpHirExpression {
	return match List.get(expressions, expressionId) {
		Some(value) => value
		None => panic("Missing HIR expression arena entry")
	}
}

fn statementAt(statements: List<MvpHirStatement>, statementId: Int) -> MvpHirStatement {
	return match List.get(statements, statementId) {
		Some(value) => value
		None => panic("Missing HIR statement arena entry")
	}
}

fn childAt(expression: MvpHirExpression, index: Int) -> Int {
	return match List.get(expression.children, index) {
		Some(value) => value
		None => panic("Missing HIR child expression arena index")
	}
}

fn emitArguments(expressionIds: List<Int>, expressions: List<MvpHirExpression>) -> List<String> {
	let mut values: List<String> = []
	for expressionId in expressionIds {
		values = List.append(values, emitExpression(expressionId, expressions))
	}
	return values
}

fn emitCall(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let values = emitArguments(expression.children, expressions)
	if List.isEmpty(values) {
		return expression.text + "($ctx)"
	}
	return expression.text + "(" + String.join(values, ", ") + ", $ctx)"
}

fn emitList(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	return "[" + String.join(emitArguments(expression.children, expressions), ", ") + "]"
}

fn emitRecordField(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	return expression.text + ": " + emitExpression(childAt(expression, 0), expressions)
}

fn emitRecord(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	return "({" + String.join(emitArguments(expression.children, expressions), ", ") + "})"
}

fn emitConditional(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let condition = emitExpression(childAt(expression, 0), expressions)
	let consequent = emitExpression(childAt(expression, 1), expressions)
	let alternate = emitExpression(childAt(expression, 2), expressions)
	return "(" + condition + " ? " + consequent + " : " + alternate + ")"
}

fn emitIndex(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let target = emitExpression(childAt(expression, 0), expressions)
	let index = emitExpression(childAt(expression, 1), expressions)
	return "(" + target + ")[" + index + "]"
}

fn emitUnary(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let value = emitExpression(childAt(expression, 0), expressions)
	if expression.text == "-" && expression.valueType == MvpType.IntType {
		return "intNegate(" + value + ")"
	}
	return "(" + expression.text + value + ")"
}

fn emitBinary(expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let leftCode = emitExpression(childAt(expression, 0), expressions)
	let rightCode = emitExpression(childAt(expression, 1), expressions)
	if expression.text == "==" {
		return "viruneEquals(" + leftCode + ", " + rightCode + ")"
	}
	if expression.text == "!=" {
		return "!viruneEquals(" + leftCode + ", " + rightCode + ")"
	}
	if expression.valueType == MvpType.IntType {
		if expression.text == "+" {
			return "intAdd(" + leftCode + ", " + rightCode + ")"
		}
		if expression.text == "-" {
			return "intSubtract(" + leftCode + ", " + rightCode + ")"
		}
		if expression.text == "*" {
			return "intMultiply(" + leftCode + ", " + rightCode + ")"
		}
		if expression.text == "/" {
			return "intDivide(" + leftCode + ", " + rightCode + ")"
		}
		if expression.text == "%" {
			return "intRemainder(" + leftCode + ", " + rightCode + ")"
		}
	}
	return "(" + leftCode + " " + expression.text + " " + rightCode + ")"
}

fn patternPayload(valueCode: String, index: Int) -> String {
	return "(" + valueCode + ").$values[" + Debug.format(index) + "]"
}

fn emitPatternCondition(patternId: Int, valueCode: String, expressions: List<MvpHirExpression>) -> String {
	let pattern = expressionAt(expressions, patternId)
	if pattern.kind == "patternWildcard" || pattern.kind == "patternBinding" {
		return "true"
	}
	if pattern.kind == "patternLiteral" {
		return "viruneEquals(" + valueCode + ", " + pattern.text + ")"
	}
	if pattern.kind == "patternVariant" {
		let mut conditions: List<String> = ["(" + valueCode + "?.$tag === \"" + pattern.text + "\")"]
		let mut index = 0
		for childId in pattern.children {
			conditions = List.append(conditions, emitPatternCondition(childId, patternPayload(valueCode, index), expressions))
			index = index + 1
		}
		return "(" + String.join(conditions, " && ") + ")"
	}
	return panic("Unknown HIR match pattern kind " + pattern.kind)
}

fn emitPatternBindings(patternId: Int, valueCode: String, expressions: List<MvpHirExpression>, depth: Int) -> String {
	let pattern = expressionAt(expressions, patternId)
	if pattern.kind == "patternBinding" {
		return indentation(depth) + "const " + pattern.text + " = " + valueCode + ";\n"
	}
	if pattern.kind != "patternVariant" {
		return ""
	}
	let mut code = ""
	let mut index = 0
	for childId in pattern.children {
		code = code + emitPatternBindings(childId, patternPayload(valueCode, index), expressions, depth)
		index = index + 1
	}
	return code
}

fn emitMatch(expressionId: Int, expression: MvpHirExpression, expressions: List<MvpHirExpression>) -> String {
	let targetCode = emitExpression(childAt(expression, 0), expressions)
	let temporary = "$match" + Debug.format(expressionId)
	let mut code = "(() => {\n\tconst " + temporary + " = " + targetCode + ";\n"
	let mut index = 1
	while index < List.length(expression.children) {
		let arm = expressionAt(expressions, childAt(expression, index))
		let patternId = childAt(arm, 0)
		let bodyId = childAt(arm, 1)
		let condition = emitPatternCondition(patternId, temporary, expressions)
		let bindings = emitPatternBindings(patternId, temporary, expressions, 2)
		code = code + "\tif (" + condition + ") {\n" + bindings + "\t\treturn " + emitExpression(bodyId, expressions) + ";\n\t}\n"
		index = index + 1
	}
	return code + "\tthrow new Error(\"Non-exhaustive match\");\n})()"
}

fn emitExpression(expressionId: Int, expressions: List<MvpHirExpression>) -> String {
	let expression = expressionAt(expressions, expressionId)
	if expression.kind == "bool" || expression.kind == "number" || expression.kind == "string" {
		return expression.text
	}
	if expression.kind == "unit" {
		return "undefined"
	}
	if expression.kind == "local" {
		return expression.text
	}
	if expression.kind == "call" {
		return emitCall(expression, expressions)
	}
	if expression.kind == "list" {
		return emitList(expression, expressions)
	}
	if expression.kind == "recordField" {
		return emitRecordField(expression, expressions)
	}
	if expression.kind == "record" {
		return emitRecord(expression, expressions)
	}
	if expression.kind == "if" {
		return emitConditional(expression, expressions)
	}
	if expression.kind == "match" {
		return emitMatch(expressionId, expression, expressions)
	}
	if expression.kind == "try" {
		return "propagate(" + emitExpression(childAt(expression, 0), expressions) + ")"
	}
	if expression.kind == "index" {
		return emitIndex(expression, expressions)
	}
	if expression.kind == "unary" {
		return emitUnary(expression, expressions)
	}
	if expression.kind == "binary" {
		return emitBinary(expression, expressions)
	}
	return panic("Unknown HIR expression kind " + expression.kind)
}

fn indentation(depth: Int) -> String {
	let mut value = ""
	let mut index = 0
	while index < depth {
		value = value + "\t"
		index = index + 1
	}
	return value
}

fn emitStatement(statementId: Int, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>, depth: Int) -> String {
	let statement = statementAt(statements, statementId)
	let prefix = indentation(depth)
	return match statement {
		HirLet(name, mutable, _, expressionId, _) => prefix + (if mutable then "let " else "const ") + name + " = " + emitExpression(expressionId, expressions) + ";\n"
		HirAssign(name, _, expressionId, _) => prefix + name + " = " + emitExpression(expressionId, expressions) + ";\n"
		HirFor(name, _, iterableExpressionId, bodyStatementIds, _) => prefix + "for (const " + name + " of " + emitExpression(iterableExpressionId, expressions) + ") {\n" + emitStatements(bodyStatementIds, statements, expressions, depth + 1) + prefix + "}\n"
		HirWhile(conditionExpressionId, bodyStatementIds, _) => prefix + "while (" + emitExpression(conditionExpressionId, expressions) + ") {\n" + emitStatements(bodyStatementIds, statements, expressions, depth + 1) + prefix + "}\n"
		HirIf(conditionExpressionId, consequentStatementIds, alternateStatementIds, _) => prefix + "if (" + emitExpression(conditionExpressionId, expressions) + ") {\n" + emitStatements(consequentStatementIds, statements, expressions, depth + 1) + prefix + "}" + (if List.isEmpty(alternateStatementIds) then "\n" else " else {\n" + emitStatements(alternateStatementIds, statements, expressions, depth + 1) + prefix + "}\n")
		HirBreak(_) => prefix + "break;\n"
		HirContinue(_) => prefix + "continue;\n"
		HirReturn(expressionId, _) => prefix + "return " + emitExpression(expressionId, expressions) + ";\n"
	}
}

fn emitStatements(statementIds: List<Int>, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>, depth: Int) -> String {
	let mut code = ""
	for statementId in statementIds {
		code = code + emitStatement(statementId, statements, expressions, depth)
	}
	return code
}

fn emitFunction(function: MvpHirFunction) -> String {
	let names = parameterNames(function.parameters)
	let parameters = if List.isEmpty(names) then "$ctx = rootTaskContext()" else String.join(names, ", ") + ", $ctx = rootTaskContext()"
	let prefix = if function.isPublic then "export " else ""
	return prefix + "function " + function.name + "(" + parameters + ") {\n" +
		"\ttry {\n" +
		emitStatements(function.statementIds, function.statements, function.expressions, 2) +
		"\t} catch ($error) {\n" +
		"\t\tif (isPropagation($error)) return $error.value;\n" +
		"\t\tthrow $error;\n" +
		"\t}\n" +
		"}\n\n"
}

fn emitMvp(moduleValue: MvpHirModule) -> String {
	let mut code = ""
	for function in moduleValue.functions {
		code = code + emitFunction(function)
	}
	return code
}

pub fn emitMvpJson(encoded: String) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let checked = Json.decode<MvpCheckTransport>(raw)?
	if List.isNotEmpty(checked.diagnostics) || match checked.hirModule { Some(_) => false, None => true } {
		return Json.encode<MvpCompilation>(MvpCompilation {
			accepted: false,
			diagnostics: checked.diagnostics,
			codeBody: "",
			exports: checked.exports,
		})
	}
	let hir = match checked.hirModule {
		Some(value) => value
		None => MvpHirModule { functions: [] }
	}
	return Json.encode<MvpCompilation>(MvpCompilation {
		accepted: true,
		diagnostics: [],
		codeBody: emitMvp(hir),
		exports: checked.exports,
	})
}
