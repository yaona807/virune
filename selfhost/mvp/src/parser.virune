//! Direct AST parser for the minimal self-host compiler grammar.

import {
	MvpDiagnostic,
	MvpExpression,
	MvpFunction,
	MvpImport,
	MvpImportBinding,
	MvpModule,
	MvpParameter,
	MvpPosition,
	MvpSpan,
	MvpStatement,
	MvpToken,
	MvpTokenKind,
	MvpType,
	errorDiagnostic,
	listType,
	optionalType,
	span,
	typeName,
} from "./model.virune"

record MvpLexTransport derives Json {
	tokens: List<MvpToken>
	diagnostics: List<MvpDiagnostic>
}

record Cursor {
	tokens: List<MvpToken>
	index: Int
}

record ParsedType {
	cursor: Cursor
	value: MvpType
}

record ParsedExpression {
	cursor: Cursor
	expressionId: Int
	expressions: List<MvpExpression>
}

record ParsedStatement {
	cursor: Cursor
	value: MvpStatement
	expressions: List<MvpExpression>
}

record ParsedFunction {
	cursor: Cursor
	value: MvpFunction
}

record ParsedImport {
	cursor: Cursor
	value: MvpImport
}

record ParsedParameter {
	cursor: Cursor
	value: MvpParameter
}

record ParsedName {
	cursor: Cursor
	text: String
	span: MvpSpan
}

record MvpParseResult derives Json {
	parsedModule: MvpModule?
	diagnostics: List<MvpDiagnostic>
}

fn zeroPosition() -> MvpPosition {
	return MvpPosition { offset: 0, line: 1, column: 1 }
}

fn fallbackToken() -> MvpToken {
	let position = zeroPosition()
	return MvpToken { kind: MvpTokenKind.EndOfFile, text: "", span: span(position, position) }
}

fn tokenAt(cursor: Cursor) -> MvpToken {
	return match List.get(cursor.tokens, cursor.index) {
		Some(value) => value
		None => match List.last(cursor.tokens) {
			Some(value) => value
			None => fallbackToken()
		}
	}
}

fn expressionAt(expressions: List<MvpExpression>, expressionId: Int, valueSpan: MvpSpan) -> Result<MvpExpression, MvpDiagnostic> {
	return match List.get(expressions, expressionId) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing MVP expression arena entry", valueSpan))
	}
}

fn addExpression(cursor: Cursor, expressions: List<MvpExpression>, expression: MvpExpression) -> ParsedExpression {
	return ParsedExpression {
		cursor: cursor,
		expressionId: List.length(expressions),
		expressions: List.append(expressions, expression),
	}
}

fn advance(cursor: Cursor) -> Cursor {
	return Cursor { tokens: cursor.tokens, index: cursor.index + 1 }
}

fn skipNewLines(cursor: Cursor) -> Cursor {
	let mut result = cursor
	while tokenAt(result).kind == MvpTokenKind.NewLine {
		result = advance(result)
	}
	return result
}

fn parseError(message: String, token: MvpToken) -> MvpDiagnostic {
	return errorDiagnostic("L0002", message, token.span)
}

fn expectText(cursor: Cursor, text: String) -> Result<Cursor, MvpDiagnostic> {
	let token = tokenAt(cursor)
	if token.text != text {
		return Err(parseError("Expected " + text + " but found " + token.text, token))
	}
	return Ok(advance(cursor))
}

fn decodedString(token: MvpToken) -> Result<String, MvpDiagnostic> {
	if token.kind != MvpTokenKind.StringLiteral || String.length(token.text) < 2 {
		return Err(parseError("Expected import specifier string", token))
	}
	return Ok(String.slice(token.text, 1, Some(String.length(token.text) - 1)))
}

fn parseNamedType(cursor: Cursor) -> Result<ParsedName, MvpDiagnostic> {
	let base = parseQualifiedName(cursor)?
	let mut current = base.cursor
	let mut text = base.text
	let mut end = base.span.end
	if tokenAt(current).text != "<" {
		return Ok(base)
	}
	text = text + "<"
	current = advance(current)
	if tokenAt(current).text == ">" {
		return Err(parseError("Expected generic type argument", tokenAt(current)))
	}
	let mut first = true
	while tokenAt(current).text != ">" {
		if !first {
			current = expectText(current, ",")?
			text = text + ", "
		}
		let argument = parseType(current)?
		text = text + typeName(argument.value)
		current = argument.cursor
		first = false
	}
	let close = tokenAt(current)
	current = advance(current)
	text = text + ">"
	end = close.span.end
	return Ok(ParsedName { cursor: current, text: text, span: span(base.span.start, end) })
}

fn parseBaseType(cursor: Cursor) -> Result<ParsedType, MvpDiagnostic> {
	let token = tokenAt(cursor)
	if token.text == "List" {
		let afterOpen = expectText(advance(cursor), "<")?
		let elementType = parseType(afterOpen)?
		let afterClose = expectText(elementType.cursor, ">")?
		return match listType(elementType.value) {
			Some(value) => Ok(ParsedType { cursor: afterClose, value: value })
			None => Err(parseError("MVP List element type must be a scalar or named type", token))
		}
	}
	let parsed = if token.text == "Bool" then MvpType.BoolType else if token.text == "Int" then MvpType.IntType else if token.text == "Float" then MvpType.FloatType else if token.text == "String" then MvpType.StringType else if token.text == "Unit" then MvpType.UnitType else MvpType.ErrorType
	if parsed != MvpType.ErrorType {
		return Ok(ParsedType { cursor: advance(cursor), value: parsed })
	}
	if token.kind != MvpTokenKind.Identifier {
		return Err(parseError("Expected type name", token))
	}
	let named = parseNamedType(cursor)?
	return Ok(ParsedType { cursor: named.cursor, value: MvpType.NamedType(named.text) })
}

fn parseType(cursor: Cursor) -> Result<ParsedType, MvpDiagnostic> {
	let parsed = parseBaseType(cursor)?
	if tokenAt(parsed.cursor).text != "?" {
		return Ok(parsed)
	}
	return match optionalType(parsed.value) {
		Some(value) => Ok(ParsedType { cursor: advance(parsed.cursor), value: value })
		None => Err(parseError("MVP optional type must wrap a scalar, named, or scalar/named List type", tokenAt(parsed.cursor)))
	}
}

fn parseImport(cursor: Cursor) -> Result<ParsedImport, MvpDiagnostic> {
	let start = tokenAt(cursor)
	let mut current = skipNewLines(expectText(cursor, "import")?)
	current = skipNewLines(expectText(current, "{")?)
	let mut bindings: List<MvpImportBinding> = []
	while tokenAt(current).text != "}" {
		let imported = tokenAt(current)
		if imported.kind != MvpTokenKind.Identifier {
			return Err(parseError("Expected imported name", imported))
		}
		current = advance(current)
		let mut localName = imported.text
		let mut bindingEnd = imported.span.end
		if tokenAt(current).text == "as" {
			let local = tokenAt(advance(current))
			if local.kind != MvpTokenKind.Identifier {
				return Err(parseError("Expected local import name after as", local))
			}
			localName = local.text
			bindingEnd = local.span.end
			current = advance(advance(current))
		}
		bindings = List.append(bindings, MvpImportBinding {
			importedName: imported.text,
			localName: localName,
			span: span(imported.span.start, bindingEnd),
		})
		current = skipNewLines(current)
		if tokenAt(current).text == "," {
			current = skipNewLines(advance(current))
			continue
		}
		break
	}
	current = skipNewLines(expectText(current, "}")?)
	current = expectText(current, "from")?
	let source = tokenAt(current)
	let specifier = decodedString(source)?
	current = consumeLineEnd(advance(current))?
	return Ok(ParsedImport {
		cursor: current,
		value: MvpImport {
			specifier: specifier,
			bindings: bindings,
			span: span(start.span.start, source.span.end),
		},
	})
}

fn parseParameter(cursor: Cursor) -> Result<ParsedParameter, MvpDiagnostic> {
	let nameToken = tokenAt(cursor)
	if nameToken.kind != MvpTokenKind.Identifier {
		return Err(parseError("Expected parameter name", nameToken))
	}
	let afterName = expectText(advance(cursor), ":")?
	let parsedType = parseType(afterName)?
	return Ok(ParsedParameter {
		cursor: parsedType.cursor,
		value: MvpParameter {
			name: nameToken.text,
			valueType: parsedType.value,
			span: span(nameToken.span.start, tokenAt(parsedType.cursor).span.start),
		},
	})
}

fn parseFunction(cursor: Cursor) -> Result<ParsedFunction, MvpDiagnostic> {
	let startCursor = skipNewLines(cursor)
	let startToken = tokenAt(startCursor)
	let isPublic = startToken.text == "pub"
	let afterPublic = if isPublic then advance(startCursor) else startCursor
	let afterFn = expectText(afterPublic, "fn")?
	let nameToken = tokenAt(afterFn)
	if nameToken.kind != MvpTokenKind.Identifier {
		return Err(parseError("Expected function name", nameToken))
	}
	let mut current = skipNewLines(expectText(advance(afterFn), "(")?)
	let mut parameters: List<MvpParameter> = []
	if tokenAt(current).text != ")" {
		while true {
			let parsed = parseParameter(current)?
			current = skipNewLines(parsed.cursor)
			parameters = List.append(parameters, parsed.value)
			if tokenAt(current).text == "," {
				current = skipNewLines(advance(current))
				if tokenAt(current).text == ")" {
					break
				}
				continue
			}
			break
		}
	}
	current = expectText(current, ")")?
	current = expectText(current, "->")?
	let parsedReturn = parseType(current)?
	current = expectText(parsedReturn.cursor, "{")?
	current = skipNewLines(current)
	let mut statements: List<MvpStatement> = []
	let mut expressions: List<MvpExpression> = []
	while tokenAt(current).text != "}" && tokenAt(current).kind != MvpTokenKind.EndOfFile {
		let parsedStatement = parseStatement(current, expressions)?
		statements = List.append(statements, parsedStatement.value)
		expressions = parsedStatement.expressions
		current = skipNewLines(parsedStatement.cursor)
	}
	let closeToken = tokenAt(current)
	current = expectText(current, "}")?
	return Ok(ParsedFunction {
		cursor: current,
		value: MvpFunction {
			isPublic: isPublic,
			name: nameToken.text,
			parameters: parameters,
			returnType: parsedReturn.value,
			expressions: expressions,
			statements: statements,
			span: span(startToken.span.start, closeToken.span.end),
		},
	})
}

fn consumeLineEnd(cursor: Cursor) -> Result<Cursor, MvpDiagnostic> {
	let token = tokenAt(cursor)
	if token.kind == MvpTokenKind.NewLine {
		return Ok(skipNewLines(cursor))
	}
	if token.text == "}" || token.kind == MvpTokenKind.EndOfFile {
		return Ok(cursor)
	}
	return Err(parseError("Expected end of statement", token))
}

fn parseStatement(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedStatement, MvpDiagnostic> {
	let start = tokenAt(cursor)
	if start.text == "let" {
		let nameToken = tokenAt(advance(cursor))
		if nameToken.kind != MvpTokenKind.Identifier {
			return Err(parseError("Expected local name", nameToken))
		}
		let mut current = advance(advance(cursor))
		let mut annotation: MvpType? = None
		if tokenAt(current).text == ":" {
			let parsedType = parseType(advance(current))?
			annotation = Some(parsedType.value)
			current = parsedType.cursor
		}
		current = expectText(current, "=")?
		let parsedExpression = parseExpression(current, expressions)?
		let expression = expressionAt(parsedExpression.expressions, parsedExpression.expressionId, start.span)?
		return Ok(ParsedStatement {
			cursor: consumeLineEnd(parsedExpression.cursor)?,
			value: MvpStatement.LetValue(nameToken.text, annotation, parsedExpression.expressionId, span(start.span.start, expression.span.end)),
			expressions: parsedExpression.expressions,
		})
	}
	if start.text == "return" {
		let next = tokenAt(advance(cursor))
		if next.kind == MvpTokenKind.NewLine || next.text == "}" || next.kind == MvpTokenKind.EndOfFile {
			let parsedUnit = addExpression(advance(cursor), expressions, MvpExpression {
				kind: "unit",
				text: "Unit",
				literalType: Some(MvpType.UnitType),
				children: [],
				span: start.span,
			})
			return Ok(ParsedStatement {
				cursor: consumeLineEnd(parsedUnit.cursor)?,
				value: MvpStatement.ReturnValue(parsedUnit.expressionId, start.span),
				expressions: parsedUnit.expressions,
			})
		}
		let parsedExpression = parseExpression(advance(cursor), expressions)?
		let expression = expressionAt(parsedExpression.expressions, parsedExpression.expressionId, start.span)?
		return Ok(ParsedStatement {
			cursor: consumeLineEnd(parsedExpression.cursor)?,
			value: MvpStatement.ReturnValue(parsedExpression.expressionId, span(start.span.start, expression.span.end)),
			expressions: parsedExpression.expressions,
		})
	}
	return Err(parseError("MVP supports only let and return statements", start))
}

fn appendBinary(operator: MvpToken, leftId: Int, right: ParsedExpression, arena: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let left = expressionAt(arena, leftId, operator.span)?
	let rightValue = expressionAt(right.expressions, right.expressionId, operator.span)?
	return Ok(addExpression(right.cursor, right.expressions, MvpExpression {
		kind: "binary",
		text: operator.text,
		literalType: None,
		children: [leftId, right.expressionId],
		span: span(left.span.start, rightValue.span.end),
	}))
}

fn parseExpression(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	return parseOr(cursor, expressions)
}

fn parseOr(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parseAnd(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "||" {
		let operator = tokenAt(current)
		let right = parseAnd(advance(current), arena)?
		let added = appendBinary(operator, expressionId, right, arena)?
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseAnd(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parseEquality(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "&&" {
		let operator = tokenAt(current)
		let right = parseEquality(advance(current), arena)?
		let added = appendBinary(operator, expressionId, right, arena)?
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseEquality(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parseComparison(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "==" || tokenAt(current).text == "!=" {
		let operator = tokenAt(current)
		let right = parseComparison(advance(current), arena)?
		let added = appendBinary(operator, expressionId, right, arena)?
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseComparison(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parseAdditive(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "<" || tokenAt(current).text == "<=" || tokenAt(current).text == ">" || tokenAt(current).text == ">=" {
		let operator = tokenAt(current)
		let right = parseAdditive(advance(current), arena)?
		let added = appendBinary(operator, expressionId, right, arena)?
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseAdditive(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parseMultiplicative(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "+" || tokenAt(current).text == "-" {
		let operator = tokenAt(current)
		let right = parseMultiplicative(advance(current), arena)?
		let added = appendBinary(operator, expressionId, right, arena)?
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseMultiplicative(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parseUnary(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "*" || tokenAt(current).text == "/" || tokenAt(current).text == "%" {
		let operator = tokenAt(current)
		let right = parseUnary(advance(current), arena)?
		let added = appendBinary(operator, expressionId, right, arena)?
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseUnary(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let token = tokenAt(cursor)
	if token.text == "!" || token.text == "-" {
		let parsed = parseUnary(advance(cursor), expressions)?
		let operand = expressionAt(parsed.expressions, parsed.expressionId, token.span)?
		return Ok(addExpression(parsed.cursor, parsed.expressions, MvpExpression {
			kind: "unary",
			text: token.text,
			literalType: None,
			children: [parsed.expressionId],
			span: span(token.span.start, operand.span.end),
		}))
	}
	return parsePostfix(cursor, expressions)
}

fn parsePostfix(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let parsed = parsePrimary(cursor, expressions)?
	let mut current = parsed.cursor
	let mut expressionId = parsed.expressionId
	let mut arena = parsed.expressions
	while tokenAt(current).text == "[" {
		let base = expressionAt(arena, expressionId, tokenAt(current).span)?
		let parsedIndex = parseExpression(advance(current), arena)?
		let close = tokenAt(parsedIndex.cursor)
		let afterClose = expectText(parsedIndex.cursor, "]")?
		let added = addExpression(afterClose, parsedIndex.expressions, MvpExpression {
			kind: "index",
			text: "[]",
			literalType: None,
			children: [expressionId, parsedIndex.expressionId],
			span: span(base.span.start, close.span.end),
		})
		current = added.cursor
		expressionId = added.expressionId
		arena = added.expressions
	}
	return Ok(ParsedExpression { cursor: current, expressionId: expressionId, expressions: arena })
}

fn parseQualifiedName(cursor: Cursor) -> Result<ParsedName, MvpDiagnostic> {
	let first = tokenAt(cursor)
	if first.kind != MvpTokenKind.Identifier {
		return Err(parseError("Expected identifier", first))
	}
	let mut current = advance(cursor)
	let mut text = first.text
	let mut end = first.span.end
	while tokenAt(current).text == "." {
		let memberCursor = advance(current)
		let member = tokenAt(memberCursor)
		if member.kind != MvpTokenKind.Identifier {
			return Err(parseError("Expected identifier after .", member))
		}
		text = text + "." + member.text
		end = member.span.end
		current = advance(memberCursor)
	}
	return Ok(ParsedName { cursor: current, text: text, span: span(first.span.start, end) })
}

fn parseListLiteral(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let open = tokenAt(cursor)
	let mut current = skipNewLines(advance(cursor))
	let mut arena = expressions
	let mut children: List<Int> = []
	if tokenAt(current).text != "]" {
		while true {
			let parsedElement = parseExpression(current, arena)?
			children = List.append(children, parsedElement.expressionId)
			arena = parsedElement.expressions
			current = skipNewLines(parsedElement.cursor)
			if tokenAt(current).text == "," {
				current = skipNewLines(advance(current))
				if tokenAt(current).text == "]" {
					break
				}
				continue
			}
			break
		}
	}
	let close = tokenAt(current)
	let afterClose = expectText(current, "]")?
	return Ok(addExpression(afterClose, arena, MvpExpression {
		kind: "list",
		text: "[]",
		literalType: None,
		children: children,
		span: span(open.span.start, close.span.end),
	}))
}

fn parseRecordLiteral(name: ParsedName, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let mut current = skipNewLines(advance(name.cursor))
	let mut arena = expressions
	let mut children: List<Int> = []
	if tokenAt(current).text != "}" {
		while true {
			let field = tokenAt(current)
			if field.kind != MvpTokenKind.Identifier {
				return Err(parseError("Expected record field name", field))
			}
			current = skipNewLines(expectText(advance(current), ":")?)
			let parsedValue = parseExpression(current, arena)?
			let value = expressionAt(parsedValue.expressions, parsedValue.expressionId, field.span)?
			let parsedField = addExpression(parsedValue.cursor, parsedValue.expressions, MvpExpression {
				kind: "recordField",
				text: field.text,
				literalType: None,
				children: [parsedValue.expressionId],
				span: span(field.span.start, value.span.end),
			})
			children = List.append(children, parsedField.expressionId)
			arena = parsedField.expressions
			current = skipNewLines(parsedField.cursor)
			if tokenAt(current).text == "," {
				current = skipNewLines(advance(current))
				if tokenAt(current).text == "}" {
					break
				}
				continue
			}
			break
		}
	}
	let close = tokenAt(current)
	let afterClose = expectText(current, "}")?
	return Ok(addExpression(afterClose, arena, MvpExpression {
		kind: "record",
		text: name.text,
		literalType: None,
		children: children,
		span: span(name.span.start, close.span.end),
	}))
}

fn parseConditionalExpression(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let start = tokenAt(cursor)
	let condition = parseExpression(skipNewLines(advance(cursor)), expressions)?
	let afterThen = skipNewLines(expectText(skipNewLines(condition.cursor), "then")?)
	let consequent = parseExpression(afterThen, condition.expressions)?
	let afterElse = skipNewLines(expectText(skipNewLines(consequent.cursor), "else")?)
	let alternate = parseExpression(afterElse, consequent.expressions)?
	let alternateValue = expressionAt(alternate.expressions, alternate.expressionId, start.span)?
	return Ok(addExpression(alternate.cursor, alternate.expressions, MvpExpression {
		kind: "if",
		text: "if",
		literalType: None,
		children: [condition.expressionId, consequent.expressionId, alternate.expressionId],
		span: span(start.span.start, alternateValue.span.end),
	}))
}

fn parsePrimary(cursor: Cursor, expressions: List<MvpExpression>) -> Result<ParsedExpression, MvpDiagnostic> {
	let token = tokenAt(cursor)
	if token.text == "if" {
		return parseConditionalExpression(cursor, expressions)
	}
	if token.text == "true" || token.text == "false" {
		return Ok(addExpression(advance(cursor), expressions, MvpExpression {
			kind: "bool", text: token.text, literalType: Some(MvpType.BoolType), children: [], span: token.span,
		}))
	}
	if token.kind == MvpTokenKind.Number {
		let numberType = if String.contains(token.text, ".") then MvpType.FloatType else MvpType.IntType
		return Ok(addExpression(advance(cursor), expressions, MvpExpression {
			kind: "number", text: token.text, literalType: Some(numberType), children: [], span: token.span,
		}))
	}
	if token.kind == MvpTokenKind.StringLiteral {
		return Ok(addExpression(advance(cursor), expressions, MvpExpression {
			kind: "string", text: token.text, literalType: Some(MvpType.StringType), children: [], span: token.span,
		}))
	}
	if token.text == "Unit" {
		return Ok(addExpression(advance(cursor), expressions, MvpExpression {
			kind: "unit", text: token.text, literalType: Some(MvpType.UnitType), children: [], span: token.span,
		}))
	}
	if token.text == "[" {
		return parseListLiteral(cursor, expressions)
	}
	if token.text == "(" {
		let parsed = parseExpression(advance(cursor), expressions)?
		return Ok(ParsedExpression { cursor: expectText(parsed.cursor, ")")?, expressionId: parsed.expressionId, expressions: parsed.expressions })
	}
	if token.kind == MvpTokenKind.Identifier {
		let name = parseQualifiedName(cursor)?
		let afterName = name.cursor
		if tokenAt(afterName).text == "{" {
			return parseRecordLiteral(name, expressions)
		}
		if tokenAt(afterName).text != "(" {
			return Ok(addExpression(afterName, expressions, MvpExpression {
				kind: "identifier", text: name.text, literalType: None, children: [], span: name.span,
			}))
		}
		let mut current = skipNewLines(advance(afterName))
		let mut arena = expressions
		let mut children: List<Int> = []
		if tokenAt(current).text != ")" {
			while true {
				let parsedArgument = parseExpression(current, arena)?
				children = List.append(children, parsedArgument.expressionId)
				arena = parsedArgument.expressions
				current = skipNewLines(parsedArgument.cursor)
				if tokenAt(current).text == "," {
					current = skipNewLines(advance(current))
					if tokenAt(current).text == ")" {
						break
					}
					continue
				}
				break
			}
		}
		let close = tokenAt(current)
		return Ok(addExpression(expectText(current, ")")?, arena, MvpExpression {
			kind: "call", text: name.text, literalType: None, children: children, span: span(name.span.start, close.span.end),
		}))
	}
	return Err(parseError("Expected expression", token))
}

fn hasImportLocalName(names: List<String>, name: String) -> Bool {
	for value in names {
		if value == name {
			return true
		}
	}
	return false
}

fn validateImports(imports: List<MvpImport>) -> Result<Unit, MvpDiagnostic> {
	let mut localNames: List<String> = []
	for importValue in imports {
		for binding in importValue.bindings {
			if hasImportLocalName(localNames, binding.localName) {
				return Err(errorDiagnostic("L1001", "Duplicate imported name " + binding.localName, binding.span))
			}
			localNames = List.append(localNames, binding.localName)
		}
	}
	return Ok(Unit)
}

fn parseModule(tokens: List<MvpToken>) -> Result<MvpModule, MvpDiagnostic> {
	let mut cursor = skipNewLines(Cursor { tokens: tokens, index: 0 })
	let mut imports: List<MvpImport> = []
	let mut functions: List<MvpFunction> = []
	while tokenAt(cursor).kind != MvpTokenKind.EndOfFile {
		if tokenAt(cursor).text == "import" {
			let parsedImport = parseImport(cursor)?
			imports = List.append(imports, parsedImport.value)
			cursor = skipNewLines(parsedImport.cursor)
			continue
		}
		let parsed = parseFunction(cursor)?
		functions = List.append(functions, parsed.value)
		cursor = skipNewLines(parsed.cursor)
	}
	validateImports(imports)?
	return Ok(MvpModule { functions: functions })
}

fn parseMvp(tokens: List<MvpToken>) -> MvpParseResult {
	return match parseModule(tokens) {
		Ok(value) => MvpParseResult { parsedModule: Some(value), diagnostics: [] }
		Err(diagnostic) => MvpParseResult { parsedModule: None, diagnostics: [diagnostic] }
	}
}

pub fn parseMvpJson(encoded: String) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let lexed = Json.decode<MvpLexTransport>(raw)?
	if List.isNotEmpty(lexed.diagnostics) {
		return Json.encode<MvpParseResult>(MvpParseResult { parsedModule: None, diagnostics: lexed.diagnostics })
	}
	return Json.encode<MvpParseResult>(parseMvp(lexed.tokens))
}
