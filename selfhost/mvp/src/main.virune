//! Minimal vertical self-host compiler slice.
//!
//! Each stage exposes only a Result-based JSON boundary. Internal compiler
//! models remain private to their implementation modules, while the TypeScript
//! Host adapts the final payload to Kernel Contract v1.

import { checkMvpJson } from "./checker.virune"
import { emitMvpJson } from "./emitter.virune"
import { lexFrontend } from "./frontend-lexer.virune"
import { parseFrontendCore } from "./frontend-parser-core.virune"
import { checkFrontendDataTypesJson } from "./frontend-semantic.virune"
import { buildFrontendSymbolScopeJson } from "./frontend-symbol-scope.virune"
import { checkFrontendTypeOperationsJson } from "./frontend-type-operations.virune"
import { lexMvpJson } from "./lexer.virune"
import { parseMvpJson } from "./parser.virune"

@jsExport
pub fn compileMvp(source: String) -> Result<String, List<JsonError>> {
	let lexed = lexMvpJson(source)?
	let parsed = parseMvpJson(lexed)?
	let checked = checkMvpJson(parsed)?
	return emitMvpJson(checked)
}

@jsExport
pub fn lexFrontendContract(source: String) -> Result<String, List<JsonError>> {
	return lexFrontend(source)
}

@jsExport
pub fn parseFrontendContract(source: String) -> Result<String, List<JsonError>> {
	return parseFrontendCore(source)
}

@jsExport
pub fn checkFrontendDataTypesContract(source: String) -> Result<String, List<JsonError>> {
	return checkFrontendDataTypesJson(source)
}

@jsExport
pub fn checkFrontendTypeOperationsContract(request: String) -> Result<String, List<JsonError>> {
	return checkFrontendTypeOperationsJson(request)
}

@jsExport
pub fn buildFrontendSymbolScopeContract(request: String) -> Result<String, List<JsonError>> {
	return buildFrontendSymbolScopeJson(request)
}
