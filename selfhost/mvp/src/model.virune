//! Data-only model for the minimal self-host compiler slice.

pub record MvpPosition derives Eq, Hash, Debug, Json {
	offset: Int
	line: Int
	column: Int
}

pub record MvpSpan derives Eq, Hash, Debug, Json {
	start: MvpPosition
	end: MvpPosition
}

pub enum MvpTokenKind derives Eq, Hash, Debug, Json {
	Identifier
	Number
	StringLiteral
	Symbol
	NewLine
	EndOfFile
}

pub record MvpToken derives Eq, Debug, Json {
	kind: MvpTokenKind
	text: String
	span: MvpSpan
}

pub enum MvpListElementType derives Eq, Hash, Debug, Json {
	BoolElement
	IntElement
	FloatElement
	StringElement
	UnitElement
}

pub enum MvpOptionalElementType derives Eq, Hash, Debug, Json {
	BoolOptionalElement
	IntOptionalElement
	FloatOptionalElement
	StringOptionalElement
	UnitOptionalElement
	BoolListOptionalElement
	IntListOptionalElement
	FloatListOptionalElement
	StringListOptionalElement
	UnitListOptionalElement
}

pub enum MvpType derives Eq, Hash, Debug, Json {
	BoolType
	IntType
	FloatType
	StringType
	UnitType
	ListType(MvpListElementType)
	OptionalType(MvpOptionalElementType)
	NamedType(String)
	NamedListType(String)
	NamedOptionalType(String)
	NamedListOptionalType(String)
	ErrorType
}

pub record MvpImportBinding derives Eq, Debug, Json {
	importedName: String
	localName: String
	span: MvpSpan
}

pub record MvpImport derives Eq, Debug, Json {
	specifier: String
	bindings: List<MvpImportBinding>
	span: MvpSpan
}

/// Flat AST node. Child expressions are arena indexes in `MvpFunction.expressions`.
pub record MvpExpression derives Json {
	kind: String
	text: String
	literalType: MvpType?
	children: List<Int>
	span: MvpSpan
}

/// Flat statement node. Nested statement bodies are arena indexes in `MvpFunction.statements`.
pub enum MvpStatement derives Json {
	LetValue(String, Bool, MvpType?, Int, MvpSpan)
	AssignValue(String, Int, MvpSpan)
	ForValue(String, Int, List<Int>, MvpSpan)
	IfValue(Int, List<Int>, List<Int>, MvpSpan)
	ReturnValue(Int, MvpSpan)
}

pub record MvpParameter derives Json {
	name: String
	valueType: MvpType
	span: MvpSpan
}

pub record MvpFunction derives Json {
	isPublic: Bool
	name: String
	parameters: List<MvpParameter>
	returnType: MvpType
	expressions: List<MvpExpression>
	statementIds: List<Int>
	statements: List<MvpStatement>
	span: MvpSpan
}

pub record MvpModule derives Json {
	functions: List<MvpFunction>
}

/// Flat checked HIR node. Child expressions are arena indexes in the function.
pub record MvpHirExpression derives Json {
	kind: String
	text: String
	valueType: MvpType
	children: List<Int>
	span: MvpSpan
}

/// Flat checked HIR statement. Nested bodies are arena indexes in `MvpHirFunction.statements`.
pub enum MvpHirStatement derives Json {
	HirLet(String, Bool, MvpType, Int, MvpSpan)
	HirAssign(String, MvpType, Int, MvpSpan)
	HirFor(String, MvpType, Int, List<Int>, MvpSpan)
	HirIf(Int, List<Int>, List<Int>, MvpSpan)
	HirReturn(Int, MvpSpan)
}

pub record MvpHirFunction derives Json {
	isPublic: Bool
	name: String
	parameters: List<MvpParameter>
	returnType: MvpType
	expressions: List<MvpHirExpression>
	statementIds: List<Int>
	statements: List<MvpHirStatement>
	span: MvpSpan
}

pub record MvpHirModule derives Json {
	functions: List<MvpHirFunction>
}

pub record MvpDiagnostic derives Eq, Debug, Json {
	code: String
	severity: String
	message: String
	span: MvpSpan
}

pub record MvpExport derives Eq, Debug, Json {
	name: String
	declarationKind: String
}

pub record MvpCompilation derives Eq, Debug, Json {
	accepted: Bool
	diagnostics: List<MvpDiagnostic>
	codeBody: String
	exports: List<MvpExport>
}

pub fn span(start: MvpPosition, end: MvpPosition) -> MvpSpan {
	return MvpSpan { start: start, end: end }
}

fn listElementTypeName(value: MvpListElementType) -> String {
	return match value {
		BoolElement => "Bool"
		IntElement => "Int"
		FloatElement => "Float"
		StringElement => "String"
		UnitElement => "Unit"
	}
}

fn optionalElementTypeName(value: MvpOptionalElementType) -> String {
	return match value {
		BoolOptionalElement => "Bool"
		IntOptionalElement => "Int"
		FloatOptionalElement => "Float"
		StringOptionalElement => "String"
		UnitOptionalElement => "Unit"
		BoolListOptionalElement => "List<Bool>"
		IntListOptionalElement => "List<Int>"
		FloatListOptionalElement => "List<Float>"
		StringListOptionalElement => "List<String>"
		UnitListOptionalElement => "List<Unit>"
	}
}

pub fn listType(elementType: MvpType) -> MvpType? {
	return match elementType {
		BoolType => Some(MvpType.ListType(MvpListElementType.BoolElement))
		IntType => Some(MvpType.ListType(MvpListElementType.IntElement))
		FloatType => Some(MvpType.ListType(MvpListElementType.FloatElement))
		StringType => Some(MvpType.ListType(MvpListElementType.StringElement))
		UnitType => Some(MvpType.ListType(MvpListElementType.UnitElement))
		NamedType(name) => Some(MvpType.NamedListType(name))
		_ => None
	}
}

pub fn listElementType(value: MvpType) -> MvpType? {
	return match value {
		ListType(BoolElement) => Some(MvpType.BoolType)
		ListType(IntElement) => Some(MvpType.IntType)
		ListType(FloatElement) => Some(MvpType.FloatType)
		ListType(StringElement) => Some(MvpType.StringType)
		ListType(UnitElement) => Some(MvpType.UnitType)
		NamedListType(name) => Some(MvpType.NamedType(name))
		_ => None
	}
}

pub fn optionalType(elementType: MvpType) -> MvpType? {
	return match elementType {
		BoolType => Some(MvpType.OptionalType(MvpOptionalElementType.BoolOptionalElement))
		IntType => Some(MvpType.OptionalType(MvpOptionalElementType.IntOptionalElement))
		FloatType => Some(MvpType.OptionalType(MvpOptionalElementType.FloatOptionalElement))
		StringType => Some(MvpType.OptionalType(MvpOptionalElementType.StringOptionalElement))
		UnitType => Some(MvpType.OptionalType(MvpOptionalElementType.UnitOptionalElement))
		ListType(BoolElement) => Some(MvpType.OptionalType(MvpOptionalElementType.BoolListOptionalElement))
		ListType(IntElement) => Some(MvpType.OptionalType(MvpOptionalElementType.IntListOptionalElement))
		ListType(FloatElement) => Some(MvpType.OptionalType(MvpOptionalElementType.FloatListOptionalElement))
		ListType(StringElement) => Some(MvpType.OptionalType(MvpOptionalElementType.StringListOptionalElement))
		ListType(UnitElement) => Some(MvpType.OptionalType(MvpOptionalElementType.UnitListOptionalElement))
		NamedType(name) => Some(MvpType.NamedOptionalType(name))
		NamedListType(name) => Some(MvpType.NamedListOptionalType(name))
		_ => None
	}
}

pub fn optionalElementType(value: MvpType) -> MvpType? {
	return match value {
		OptionalType(BoolOptionalElement) => Some(MvpType.BoolType)
		OptionalType(IntOptionalElement) => Some(MvpType.IntType)
		OptionalType(FloatOptionalElement) => Some(MvpType.FloatType)
		OptionalType(StringOptionalElement) => Some(MvpType.StringType)
		OptionalType(UnitOptionalElement) => Some(MvpType.UnitType)
		OptionalType(BoolListOptionalElement) => Some(MvpType.ListType(MvpListElementType.BoolElement))
		OptionalType(IntListOptionalElement) => Some(MvpType.ListType(MvpListElementType.IntElement))
		OptionalType(FloatListOptionalElement) => Some(MvpType.ListType(MvpListElementType.FloatElement))
		OptionalType(StringListOptionalElement) => Some(MvpType.ListType(MvpListElementType.StringElement))
		OptionalType(UnitListOptionalElement) => Some(MvpType.ListType(MvpListElementType.UnitElement))
		NamedOptionalType(name) => Some(MvpType.NamedType(name))
		NamedListOptionalType(name) => Some(MvpType.NamedListType(name))
		_ => None
	}
}

pub fn typeName(value: MvpType) -> String {
	return match value {
		BoolType => "Bool"
		IntType => "Int"
		FloatType => "Float"
		StringType => "String"
		UnitType => "Unit"
		ListType(elementType) => "List<" + listElementTypeName(elementType) + ">"
		OptionalType(elementType) => optionalElementTypeName(elementType) + "?"
		NamedType(name) => name
		NamedListType(name) => "List<" + name + ">"
		NamedOptionalType(name) => name + "?"
		NamedListOptionalType(name) => "List<" + name + ">?"
		ErrorType => "<error>"
	}
}

pub fn errorDiagnostic(code: String, message: String, valueSpan: MvpSpan) -> MvpDiagnostic {
	return MvpDiagnostic {
		code: code,
		severity: "error",
		message: message,
		span: valueSpan,
	}
}
