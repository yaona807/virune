import { parseFrontendCore } from "./frontend-parser-core.virune"

fn encoded(source: String) -> String {
	return match parseFrontendCore(source) {
		Ok(value) => value
		Err(_) => ""
	}
}

test "declaration parser expands record fields and nested type references" {
	let source = "/// Envelope docs\npub record Envelope<T> {\n\tvalue: Map<String, List<T?>>\n\tpair: (Int, String)\n\titems: [T]\n}\npub fn main() -> Int {\n\treturn 0\n}\n"
	let result = encoded(source)
	expect(String.contains(result, "\"accepted\":true"))
	expect(String.contains(result, "\"kind\":\"RecordField\""))
	expect(String.contains(result, "\"text\":\"value\""))
	expect(String.contains(result, "\"kind\":\"GenericTypeReference\""))
	expect(String.contains(result, "\"kind\":\"OptionalTypeReference\""))
	expect(String.contains(result, "\"kind\":\"TupleTypeReference\""))
	expect(String.contains(result, "\"kind\":\"ListTypeReference\""))
	expect(String.contains(result, "\"documentation\":[\"Envelope docs\"]"))
}

test "declaration parser expands enum payload and alias types" {
	let source = "pub enum Outcome<T, E> {\n\tOk(T)\n\tErr(E)\n\tEmpty\n}\npub newtype UserId = Int\npub type Handler<T> = (T) -> Outcome<T, String>\npub fn main() -> Int {\n\treturn 0\n}\n"
	let result = encoded(source)
	expect(String.contains(result, "\"accepted\":true"))
	expect(String.contains(result, "\"kind\":\"EnumVariant\""))
	expect(String.contains(result, "\"text\":\"Ok\""))
	expect(String.contains(result, "\"text\":\"Empty\""))
	expect(String.contains(result, "\"kind\":\"NewtypeDeclaration\""))
	expect(String.contains(result, "\"kind\":\"TypeAliasDeclaration\""))
	expect(String.contains(result, "\"kind\":\"FunctionTypeReference\""))
}

test "declaration parser reports malformed declaration details" {
	let source = "pub record Broken<T> {\n\tmissing T\n\tvalid: List<T>\n}\npub enum Fault<E> {\n\tBad(E\n\tEmpty\n}\npub fn main() -> Int {\n\treturn 0\n}\n"
	let result = encoded(source)
	expect(String.contains(result, "\"accepted\":false"))
	expect(String.contains(result, "Expected :"))
	expect(String.contains(result, "enum payload"))
	expect(String.contains(result, "\"text\":\"valid\""))
	expect(String.contains(result, "\"text\":\"main\""))
}
