//! Symbol registration, type checking, and explicit HIR lowering for the MVP.

import {
	MvpDiagnostic,
	MvpExpression,
	MvpExport,
	MvpFunction,
	MvpHirExpression,
	MvpHirFunction,
	MvpHirModule,
	MvpHirStatement,
	MvpListElementType,
	MvpModule,
	MvpOptionalElementType,
	MvpParameter,
	MvpPosition,
	MvpSpan,
	MvpStatement,
	MvpType,
	errorDiagnostic,
	listElementType,
	listType,
	optionalElementType,
	optionalType,
	span,
	typeName,
} from "./model.virune"

record MvpParseTransport derives Json {
	parsedModule: MvpModule?
	diagnostics: List<MvpDiagnostic>
}

record Signature {
	name: String
	parameters: List<MvpType>
	returnType: MvpType
	isPublic: Bool
	span: MvpSpan
}

record MvpExternalSignature derives Json {
	name: String
	parameters: List<MvpType>
	returnType: MvpType
	span: MvpSpan
}

record Binding {
	name: String
	valueType: MvpType
	mutable: Bool
}

record CheckContext {
	signatures: List<Signature>
	bindings: List<Binding>
	returnType: MvpType
	loopDepth: Int
	sourceExpressions: List<MvpExpression>
	sourceStatements: List<MvpStatement>
}

record CheckedExpression {
	expressionId: Int
	expressions: List<MvpHirExpression>
	valueType: MvpType
}

record CheckedArguments {
	expressionIds: List<Int>
	expressions: List<MvpHirExpression>
}

record CheckedPattern {
	expressionId: Int
	bindings: List<Binding>
	expressions: List<MvpHirExpression>
}

record CheckedStatement {
	statementId: Int
	bindings: List<Binding>
	statements: List<MvpHirStatement>
	expressions: List<MvpHirExpression>
}

record CheckedBlock {
	statementIds: List<Int>
	statements: List<MvpHirStatement>
	expressions: List<MvpHirExpression>
}

record MvpCheckResult derives Json {
	hirModule: MvpHirModule?
	diagnostics: List<MvpDiagnostic>
	exports: List<MvpExport>
}

fn zeroSpan() -> MvpSpan {
	let position = MvpPosition { offset: 0, line: 1, column: 1 }
	return span(position, position)
}

fn typeMismatch(actual: MvpType, expected: MvpType, valueSpan: MvpSpan) -> MvpDiagnostic {
	return errorDiagnostic("L2043", typeName(actual) + " cannot be used as " + typeName(expected), valueSpan)
}

fn typesCompatible(actual: MvpType, expected: MvpType) -> Bool {
	if actual == expected || actual == MvpType.ErrorType || expected == MvpType.ErrorType {
		return true
	}
	let actualName = match actual {
		NamedType(name) => name
		_ => ""
	}
	let expectedName = match expected {
		NamedType(name) => name
		_ => ""
	}
	return actualName != "" && expectedName != "" && compactTypeName(actualName) == compactTypeName(expectedName)
}

fn preferredType(left: MvpType, right: MvpType) -> MvpType {
	if left == MvpType.ErrorType {
		return right
	}
	return left
}

fn parameterTypes(parameters: List<MvpParameter>) -> List<MvpType> {
	let mut values: List<MvpType> = []
	for parameter in parameters {
		values = List.append(values, parameter.valueType)
	}
	return values
}

fn sourceExports(moduleValue: MvpModule) -> List<MvpExport> {
	let mut values: List<MvpExport> = []
	for function in moduleValue.functions {
		if function.isPublic {
			values = List.append(values, MvpExport { name: function.name, declarationKind: "FunctionDeclaration" })
		}
	}
	return values
}

fn findSignature(signatures: List<Signature>, name: String) -> Signature? {
	for signature in signatures {
		if signature.name == name {
			return Some(signature)
		}
	}
	return None
}

fn findBinding(bindings: List<Binding>, name: String) -> Binding? {
	for binding in bindings {
		if binding.name == name {
			return Some(binding)
		}
	}
	return None
}

fn sourceExpressionAt(context: CheckContext, expressionId: Int) -> Result<MvpExpression, MvpDiagnostic> {
	return match List.get(context.sourceExpressions, expressionId) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing source expression arena entry", zeroSpan()))
	}
}

fn sourceStatementAt(context: CheckContext, statementId: Int) -> Result<MvpStatement, MvpDiagnostic> {
	return match List.get(context.sourceStatements, statementId) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing source statement arena entry", zeroSpan()))
	}
}

fn childAt(node: MvpExpression, index: Int) -> Result<Int, MvpDiagnostic> {
	return match List.get(node.children, index) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing child expression arena index", node.span))
	}
}

fn expectedAt(values: List<MvpType>, index: Int, valueSpan: MvpSpan) -> Result<MvpType, MvpDiagnostic> {
	return match List.get(values, index) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing expected argument type", valueSpan))
	}
}

fn addHir(expressions: List<MvpHirExpression>, node: MvpHirExpression, valueType: MvpType) -> CheckedExpression {
	return CheckedExpression {
		expressionId: List.length(expressions),
		expressions: List.append(expressions, node),
		valueType: valueType,
	}
}

fn addHirStatement(statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>, bindings: List<Binding>, statement: MvpHirStatement) -> CheckedStatement {
	return CheckedStatement {
		statementId: List.length(statements),
		bindings: bindings,
		statements: List.append(statements, statement),
		expressions: expressions,
	}
}

fn isNumeric(value: MvpType) -> Bool {
	return value == MvpType.IntType || value == MvpType.FloatType
}

fn isOrdered(value: MvpType) -> Bool {
	return isNumeric(value) || value == MvpType.StringType
}

fn literalType(node: MvpExpression) -> Result<MvpType, MvpDiagnostic> {
	return match node.literalType {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Literal expression is missing its type", node.span))
	}
}

fn compactTypeName(value: String) -> String {
	let mut result = ""
	for character in String.codePoints(value) {
		if character != " " && character != "\t" && character != "\r" && character != "\n" {
			result = result + character
		}
	}
	return result
}

fn genericArgument(value: String, requestedIndex: Int) -> String? {
	let chars = String.codePoints(value)
	let mut started = false
	let mut depth = 0
	let mut argumentIndex = 0
	let mut result = ""
	for character in chars {
		if character == "<" {
			if !started {
				started = true
				depth = 1
				continue
			}
			depth = depth + 1
			if argumentIndex == requestedIndex {
				result = result + character
			}
			continue
		}
		if !started {
			continue
		}
		if character == ">" {
			depth = depth - 1
			if depth == 0 {
				return if argumentIndex == requestedIndex then Some(compactTypeName(result)) else None
			}
			if argumentIndex == requestedIndex {
				result = result + character
			}
			continue
		}
		if character == "," && depth == 1 {
			if argumentIndex == requestedIndex {
				return Some(compactTypeName(result))
			}
			argumentIndex = argumentIndex + 1
			result = ""
			continue
		}
		if argumentIndex == requestedIndex {
			result = result + character
		}
	}
	return None
}

fn typeFromName(value: String) -> MvpType {
	let compact = compactTypeName(value)
	if String.length(compact) > 1 && String.slice(compact, String.length(compact) - 1, None) == "?" {
		let wrapped = typeFromName(String.slice(compact, 0, Some(String.length(compact) - 1)))
		return match wrapped {
			BoolType => MvpType.OptionalType(MvpOptionalElementType.BoolOptionalElement)
			IntType => MvpType.OptionalType(MvpOptionalElementType.IntOptionalElement)
			FloatType => MvpType.OptionalType(MvpOptionalElementType.FloatOptionalElement)
			StringType => MvpType.OptionalType(MvpOptionalElementType.StringOptionalElement)
			UnitType => MvpType.OptionalType(MvpOptionalElementType.UnitOptionalElement)
			ListType(BoolElement) => MvpType.OptionalType(MvpOptionalElementType.BoolListOptionalElement)
			ListType(IntElement) => MvpType.OptionalType(MvpOptionalElementType.IntListOptionalElement)
			ListType(FloatElement) => MvpType.OptionalType(MvpOptionalElementType.FloatListOptionalElement)
			ListType(StringElement) => MvpType.OptionalType(MvpOptionalElementType.StringListOptionalElement)
			ListType(UnitElement) => MvpType.OptionalType(MvpOptionalElementType.UnitListOptionalElement)
			NamedType(name) => MvpType.NamedOptionalType(name)
			NamedListType(name) => MvpType.NamedListOptionalType(name)
			_ => MvpType.ErrorType
		}
	}
	if compact == "Bool" {
		return MvpType.BoolType
	}
	if compact == "Int" {
		return MvpType.IntType
	}
	if compact == "Float" {
		return MvpType.FloatType
	}
	if compact == "String" {
		return MvpType.StringType
	}
	if compact == "Unit" {
		return MvpType.UnitType
	}
	if String.length(compact) >= 5 && String.slice(compact, 0, Some(5)) == "List<" {
		let elementName = genericArgument(compact, 0)
		if match elementName { Some(_) => true, None => false } {
			let elementType = match elementName { Some(name) => typeFromName(name), None => MvpType.ErrorType }
			return match listType(elementType) {
				Some(result) => result
				None => MvpType.ErrorType
			}
		}
	}
	return MvpType.NamedType(compact)
}


fn namedBaseTypeName(value: String) -> String {
	let mut result = ""
	for character in String.codePoints(value) {
		if character == "<" {
			return result
		}
		result = result + character
	}
	return result
}

fn typeArgumentName(value: String, index: Int) -> String {
	return match genericArgument(value, index) {
		Some(name) => name
		None => "<error>"
	}
}

fn qualifiedSegments(value: String) -> List<String> {
	let mut values: List<String> = []
	let mut current = ""
	for character in String.codePoints(value) {
		if character == "." {
			values = List.append(values, current)
			current = ""
		} else {
			current = current + character
		}
	}
	values = List.append(values, current)
	return values
}

fn signatureType(signature: Signature) -> MvpType {
	let mut parameterNames: List<String> = []
	for parameter in signature.parameters {
		parameterNames = List.append(parameterNames, typeName(parameter))
	}
	return MvpType.NamedType("fn(" + String.join(parameterNames, ",") + ")->" + typeName(signature.returnType))
}

fn functionTypeText(value: MvpType) -> String? {
	return match value {
		NamedType(name) => if String.length(name) >= 6 && String.slice(name, 0, Some(3)) == "fn(" && String.contains(name, ")->") then Some(name) else None
		_ => None
	}
}

fn functionParameterNames(value: String) -> List<String> {
	let mut values: List<String> = []
	let mut current = ""
	let mut depth = 0
	let mut index = 3
	while index < String.length(value) {
		let character = String.slice(value, index, Some(index + 1))
		if character == ")" && depth == 0 {
			if String.length(current) > 0 {
				values = List.append(values, compactTypeName(current))
			}
			return values
		}
		if character == "<" || character == "(" {
			depth = depth + 1
			current = current + character
		} else if character == ">" || character == ")" {
			depth = depth - 1
			current = current + character
		} else if character == "," && depth == 0 {
			values = List.append(values, compactTypeName(current))
			current = ""
		} else {
			current = current + character
		}
		index = index + 1
	}
	return values
}

fn functionReturnName(value: String) -> String {
	let marker = ")->"
	let mut index = 0
	while index + String.length(marker) <= String.length(value) {
		if String.slice(value, index, Some(index + String.length(marker))) == marker {
			return compactTypeName(String.slice(value, index + String.length(marker), None))
		}
		index = index + 1
	}
	return "<error>"
}

fn namedFieldType(typeNameValue: String, fieldName: String) -> MvpType {
	let compact = compactTypeName(typeNameValue)
	let base = namedBaseTypeName(compact)
	if base == "ControlFlowFunctionBuildResult" && fieldName == "functions" {
		return typeFromName("List<SemanticFlowFunction>")
	}
	if base == "ControlFlowFunctionBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List<SemanticFlowDiagnostic>")
	}
	if base == "EffectFunctionBuildResult" && fieldName == "functions" {
		return typeFromName("List<SemanticEffectFunction>")
	}
	if base == "EffectFunctionBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List<SemanticEffectDiagnostic>")
	}
	if base == "DeferScopeBuildResult" && fieldName == "scopes" {
		return typeFromName("List<SemanticDeferScope>")
	}
	if base == "DeferScopeBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List<SemanticDeferDiagnostic>")
	}
	if base == "SymbolScopeBuildResult" && fieldName == "scopes" {
		return typeFromName("List<SemanticScope>")
	}
	if base == "SymbolScopeBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List<SemanticScopeDiagnostic>")
	}
	if base == "SymbolScopeSymbolBuildResult" && fieldName == "symbols" {
		return typeFromName("List<SemanticSymbol>")
	}
	if base == "SymbolScopeSymbolBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List<SemanticScopeDiagnostic>")
	}
	if base == "VisibilitySymbolBuildResult" && fieldName == "symbols" {
		return typeFromName("List<SemanticModuleSymbol>")
	}
	if base == "VisibilitySymbolBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List<SemanticVisibilityDiagnostic>")
	}
	if base == "MvpExternalSignature" && fieldName == "name" {
		return typeFromName("String")
	}
	if base == "MvpExternalSignature" && fieldName == "parameters" {
		return typeFromName("List<MvpType>")
	}
	if base == "MvpExternalSignature" && fieldName == "returnType" {
		return typeFromName("MvpType")
	}
	if base == "MvpExternalSignature" && fieldName == "span" {
		return typeFromName("MvpSpan")
	}
	if base == "AccessBuildResult" && fieldName == "accesses" {
		return typeFromName("List" + "<" + "SemanticModuleAccessResult" + ">")
	}
	if base == "AccessBuildResult" && fieldName == "diagnostics" {
		return typeFromName("List" + "<" + "SemanticVisibilityDiagnostic" + ">")
	}
	if base == "Binding" && fieldName == "mutable" {
		return typeFromName("Bool")
	}
	if base == "Binding" && fieldName == "name" {
		return typeFromName("String")
	}
	if base == "Binding" && fieldName == "valueType" {
		return typeFromName("MvpType")
	}
	if base == "CallableHolder" && fieldName == "callback" {
		return typeFromName("fn" + "(" + "Int" + ")->" + "Int")
	}
	if base == "CanonicalProjectCompilerDependencyV1" && fieldName == "modulePath" {
		return typeFromName("String")
	}
	if base == "CanonicalProjectCompilerDependencyV1" && fieldName == "public" {
		return typeFromName("Bool")
	}
	if base == "CanonicalProjectCompilerDependencyV1" && fieldName == "resolvedPath" {
		return typeFromName("String" + "?")
	}
	if base == "CanonicalProjectCompilerDependencyV1" && fieldName == "sourceKind" {
		return typeFromName("String")
	}
	if base == "CanonicalProjectCompilerDependencyV1" && fieldName == "specifier" {
		return typeFromName("String")
	}
	if base == "CanonicalProjectCompilerDependencyV1" && fieldName == "typeOnly" {
		return typeFromName("Bool")
	}
