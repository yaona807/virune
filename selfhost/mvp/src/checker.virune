//! Symbol registration, type checking, and explicit HIR lowering for the MVP.

import {
	MvpDiagnostic,
	MvpExpression,
	MvpExport,
	MvpFunction,
	MvpHirExpression,
	MvpHirFunction,
	MvpHirModule,
	MvpHirStatement,
	MvpModule,
	MvpParameter,
	MvpPosition,
	MvpSpan,
	MvpStatement,
	MvpType,
	errorDiagnostic,
	listElementType,
	listType,
	optionalElementType,
	optionalType,
	span,
	typeName,
} from "./model.virune"

record MvpParseTransport derives Json {
	parsedModule: MvpModule?
	diagnostics: List<MvpDiagnostic>
}

record Signature {
	name: String
	parameters: List<MvpType>
	returnType: MvpType
	isPublic: Bool
	span: MvpSpan
}

record Binding {
	name: String
	valueType: MvpType
	mutable: Bool
}

record CheckContext {
	signatures: List<Signature>
	bindings: List<Binding>
	returnType: MvpType
	sourceExpressions: List<MvpExpression>
	sourceStatements: List<MvpStatement>
}

record CheckedExpression {
	expressionId: Int
	expressions: List<MvpHirExpression>
	valueType: MvpType
}

record CheckedArguments {
	expressionIds: List<Int>
	expressions: List<MvpHirExpression>
}

record CheckedPattern {
	expressionId: Int
	bindings: List<Binding>
	expressions: List<MvpHirExpression>
}

record CheckedStatement {
	statementId: Int
	bindings: List<Binding>
	statements: List<MvpHirStatement>
	expressions: List<MvpHirExpression>
}

record CheckedBlock {
	statementIds: List<Int>
	statements: List<MvpHirStatement>
	expressions: List<MvpHirExpression>
}

record MvpCheckResult derives Json {
	hirModule: MvpHirModule?
	diagnostics: List<MvpDiagnostic>
	exports: List<MvpExport>
}

fn zeroSpan() -> MvpSpan {
	let position = MvpPosition { offset: 0, line: 1, column: 1 }
	return span(position, position)
}

fn typeMismatch(actual: MvpType, expected: MvpType, valueSpan: MvpSpan) -> MvpDiagnostic {
	return errorDiagnostic("L2043", typeName(actual) + " cannot be used as " + typeName(expected), valueSpan)
}

fn typesCompatible(actual: MvpType, expected: MvpType) -> Bool {
	return actual == expected || actual == MvpType.ErrorType || expected == MvpType.ErrorType
}

fn preferredType(left: MvpType, right: MvpType) -> MvpType {
	if left == MvpType.ErrorType {
		return right
	}
	return left
}

fn parameterTypes(parameters: List<MvpParameter>) -> List<MvpType> {
	let mut values: List<MvpType> = []
	for parameter in parameters {
		values = List.append(values, parameter.valueType)
	}
	return values
}

fn sourceExports(moduleValue: MvpModule) -> List<MvpExport> {
	let mut values: List<MvpExport> = []
	for function in moduleValue.functions {
		if function.isPublic {
			values = List.append(values, MvpExport { name: function.name, declarationKind: "FunctionDeclaration" })
		}
	}
	return values
}

fn findSignature(signatures: List<Signature>, name: String) -> Signature? {
	for signature in signatures {
		if signature.name == name {
			return Some(signature)
		}
	}
	return None
}

fn findBinding(bindings: List<Binding>, name: String) -> Binding? {
	for binding in bindings {
		if binding.name == name {
			return Some(binding)
		}
	}
	return None
}

fn sourceExpressionAt(context: CheckContext, expressionId: Int) -> Result<MvpExpression, MvpDiagnostic> {
	return match List.get(context.sourceExpressions, expressionId) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing source expression arena entry", zeroSpan()))
	}
}

fn sourceStatementAt(context: CheckContext, statementId: Int) -> Result<MvpStatement, MvpDiagnostic> {
	return match List.get(context.sourceStatements, statementId) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing source statement arena entry", zeroSpan()))
	}
}

fn childAt(node: MvpExpression, index: Int) -> Result<Int, MvpDiagnostic> {
	return match List.get(node.children, index) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing child expression arena index", node.span))
	}
}

fn expectedAt(values: List<MvpType>, index: Int, valueSpan: MvpSpan) -> Result<MvpType, MvpDiagnostic> {
	return match List.get(values, index) {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Missing expected argument type", valueSpan))
	}
}

fn addHir(expressions: List<MvpHirExpression>, node: MvpHirExpression, valueType: MvpType) -> CheckedExpression {
	return CheckedExpression {
		expressionId: List.length(expressions),
		expressions: List.append(expressions, node),
		valueType: valueType,
	}
}

fn addHirStatement(statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>, bindings: List<Binding>, statement: MvpHirStatement) -> CheckedStatement {
	return CheckedStatement {
		statementId: List.length(statements),
		bindings: bindings,
		statements: List.append(statements, statement),
		expressions: expressions,
	}
}

fn isNumeric(value: MvpType) -> Bool {
	return value == MvpType.IntType || value == MvpType.FloatType
}

fn isOrdered(value: MvpType) -> Bool {
	return isNumeric(value) || value == MvpType.StringType
}

fn literalType(node: MvpExpression) -> Result<MvpType, MvpDiagnostic> {
	return match node.literalType {
		Some(value) => Ok(value)
		None => Err(errorDiagnostic("L9001", "Literal expression is missing its type", node.span))
	}
}

fn compactTypeName(value: String) -> String {
	let mut result = ""
	for character in String.codePoints(value) {
		if character != " " && character != "\t" && character != "\r" && character != "\n" {
			result = result + character
		}
	}
	return result
}

fn genericArgument(value: String, requestedIndex: Int) -> String? {
	let chars = String.codePoints(value)
	let mut started = false
	let mut depth = 0
	let mut argumentIndex = 0
	let mut result = ""
	for character in chars {
		if character == "<" {
			if !started {
				started = true
				depth = 1
				continue
			}
			depth = depth + 1
			if argumentIndex == requestedIndex {
				result = result + character
			}
			continue
		}
		if !started {
			continue
		}
		if character == ">" {
			depth = depth - 1
			if depth == 0 {
				return if argumentIndex == requestedIndex then Some(compactTypeName(result)) else None
			}
			if argumentIndex == requestedIndex {
				result = result + character
			}
			continue
		}
		if character == "," && depth == 1 {
			if argumentIndex == requestedIndex {
				return Some(compactTypeName(result))
			}
			argumentIndex = argumentIndex + 1
			result = ""
			continue
		}
		if argumentIndex == requestedIndex {
			result = result + character
		}
	}
	return None
}

fn typeFromName(value: String) -> MvpType {
	let compact = compactTypeName(value)
	if compact == "Bool" {
		return MvpType.BoolType
	}
	if compact == "Int" {
		return MvpType.IntType
	}
	if compact == "Float" {
		return MvpType.FloatType
	}
	if compact == "String" {
		return MvpType.StringType
	}
	if compact == "Unit" {
		return MvpType.UnitType
	}
	if String.contains(compact, "List<") {
		let elementName = genericArgument(compact, 0)
		if match elementName { Some(_) => true, None => false } {
			let elementType = match elementName { Some(name) => typeFromName(name), None => MvpType.ErrorType }
			return match listType(elementType) {
				Some(result) => result
				None => MvpType.ErrorType
			}
		}
	}
	return MvpType.NamedType(compact)
}

fn namedVariantPayloadType(typeNameValue: String, variantName: String, index: Int) -> MvpType {
	if String.contains(typeNameValue, "Result<") {
		let requested = if variantName == "Ok" then 0 else if variantName == "Err" then 1 else -1
		if requested >= 0 && index == 0 {
			return match genericArgument(typeNameValue, requested) {
				Some(name) => typeFromName(name)
				None => MvpType.ErrorType
			}
		}
	}
	if typeNameValue == "MvpType" && index == 0 {
		if variantName == "ListType" {
			return MvpType.NamedType("MvpListElementType")
		}
		if variantName == "OptionalType" {
			return MvpType.NamedType("MvpOptionalElementType")
		}
		if variantName == "NamedType" || variantName == "NamedListType" || variantName == "NamedOptionalType" || variantName == "NamedListOptionalType" {
			return MvpType.StringType
		}
	}
	return MvpType.ErrorType
}

fn variantPayloadType(targetType: MvpType, variantName: String, index: Int) -> MvpType {
	if variantName == "Some" && index == 0 {
		return match optionalElementType(targetType) {
			Some(value) => value
			None => MvpType.ErrorType
		}
	}
	return match targetType {
		NamedType(name) => namedVariantPayloadType(name, variantName, index)
		_ => MvpType.ErrorType
	}
}

fn checkLiteral(node: MvpExpression, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let valueType = literalType(node)?
	return Ok(addHir(expressions, MvpHirExpression {
		kind: node.kind,
		text: node.text,
		valueType: valueType,
		children: [],
		span: node.span,
	}, valueType))
}

fn checkIdentifier(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	if standardConstructorName(node.text) == "None" {
		return Err(errorDiagnostic("L2020", "Cannot infer the Optional type of None without an expected type", node.span))
	}
	return match findBinding(context.bindings, node.text) {
		Some(value) => Ok(addHir(expressions, MvpHirExpression {
			kind: "local",
			text: node.text,
			valueType: value.valueType,
			children: [],
			span: node.span,
		}, value.valueType))
		None => Err(errorDiagnostic("L1010", "Unknown name " + node.text, node.span))
	}
}
fn checkArguments(node: MvpExpression, expected: List<MvpType>, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedArguments, MvpDiagnostic> {
	if List.length(node.children) != List.length(expected) {
		return Err(errorDiagnostic("L2012", "Expected " + Debug.format(List.length(expected)) + " arguments, received " + Debug.format(List.length(node.children)), node.span))
	}
	let mut expressionIds: List<Int> = []
	let mut arena = expressions
	let mut index = 0
	while index < List.length(node.children) {
		let sourceId = childAt(node, index)?
		let expectedType = expectedAt(expected, index, node.span)?
		let checked = checkExpectedExpression(sourceId, expectedType, context, arena)?
		expressionIds = List.append(expressionIds, checked.expressionId)
		arena = checked.expressions
		index = index + 1
	}
	return Ok(CheckedArguments { expressionIds: expressionIds, expressions: arena })
}
fn checkKnownCall(node: MvpExpression, signature: Signature, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let checkedArguments = checkArguments(node, signature.parameters, context, expressions)?
	return Ok(addHir(checkedArguments.expressions, MvpHirExpression {
		kind: "call",
		text: signature.name,
		valueType: signature.returnType,
		children: checkedArguments.expressionIds,
		span: node.span,
	}, signature.returnType))
}

fn checkCall(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let constructorName = standardConstructorName(node.text)
	if constructorName == "Some" {
		if List.length(node.children) != 1 {
			return Err(errorDiagnostic("L2012", "Some expects 1 argument, received " + Debug.format(List.length(node.children)), node.span))
		}
		let sourceId = childAt(node, 0)?
		let checked = checkExpression(sourceId, context, expressions)?
		return match optionalType(checked.valueType) {
			Some(valueType) => Ok(checkedVariant(node, constructorName, valueType, [checked.expressionId], checked.expressions))
			None => Err(errorDiagnostic("L2020", "Cannot infer an Optional type for Some from " + typeName(checked.valueType), node.span))
		}
	}
	if constructorName == "Ok" || constructorName == "Err" {
		return Err(errorDiagnostic("L2020", "Cannot infer the complete Result type for " + constructorName + " without an expected type", node.span))
	}
	if constructorName == "None" {
		return Err(errorDiagnostic("L2012", "None is a value and does not accept arguments", node.span))
	}
	return match findSignature(context.signatures, node.text) {
		Some(value) => checkKnownCall(node, value, context, expressions)
		None => Err(errorDiagnostic("L1010", "Unknown name " + node.text, node.span))
	}
}
fn standardConstructorName(value: String) -> String {
	if value == "Some" || value == "Option.Some" {
		return "Some"
	}
	if value == "None" || value == "Option.None" {
		return "None"
	}
	if value == "Ok" || value == "Result.Ok" {
		return "Ok"
	}
	if value == "Err" || value == "Result.Err" {
		return "Err"
	}
	return ""
}

fn checkedVariant(node: MvpExpression, constructorName: String, valueType: MvpType, childIds: List<Int>, expressions: List<MvpHirExpression>) -> CheckedExpression {
	return addHir(expressions, MvpHirExpression {
		kind: "variant",
		text: constructorName,
		valueType: valueType,
		children: childIds,
		span: node.span,
	}, valueType)
}

fn resultPayloadType(expectedType: MvpType, constructorName: String) -> MvpType? {
	let resultName = match expectedType {
		NamedType(name) => name
		_ => ""
	}
	if !String.contains(resultName, "Result<") {
		return None
	}
	let requestedIndex = if constructorName == "Ok" then 0 else if constructorName == "Err" then 1 else -1
	if requestedIndex < 0 {
		return None
	}
	return match genericArgument(resultName, requestedIndex) {
		Some(name) => Some(typeFromName(name))
		None => None
	}
}

fn checkExpectedVariant(node: MvpExpression, expectedType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let constructorName = standardConstructorName(node.text)
	if constructorName == "None" {
		if node.kind != "identifier" || List.isNotEmpty(node.children) {
			return Err(errorDiagnostic("L2012", "None is a value and does not accept arguments", node.span))
		}
		return match optionalElementType(expectedType) {
			Some(_) => Ok(checkedVariant(node, constructorName, expectedType, [], expressions))
			None => Err(errorDiagnostic("L2043", "None requires an Optional expected type, received " + typeName(expectedType), node.span))
		}
	}
	if constructorName == "Some" {
		if node.kind != "call" || List.length(node.children) != 1 {
			return Err(errorDiagnostic("L2012", "Some expects 1 argument, received " + Debug.format(List.length(node.children)), node.span))
		}
		let payloadType = optionalElementType(expectedType)
		if match payloadType { Some(_) => false, None => true } {
			return Err(errorDiagnostic("L2043", "Some requires an Optional expected type, received " + typeName(expectedType), node.span))
		}
		let expectedPayload = match payloadType { Some(value) => value, None => MvpType.ErrorType }
		let sourceId = childAt(node, 0)?
		let checked = checkExpectedExpression(sourceId, expectedPayload, context, expressions)?
		return Ok(checkedVariant(node, constructorName, expectedType, [checked.expressionId], checked.expressions))
	}
	if constructorName == "Ok" || constructorName == "Err" {
		if node.kind != "call" || List.length(node.children) != 1 {
			return Err(errorDiagnostic("L2012", constructorName + " expects 1 argument, received " + Debug.format(List.length(node.children)), node.span))
		}
		let payloadType = resultPayloadType(expectedType, constructorName)
		if match payloadType { Some(_) => false, None => true } {
			return Err(errorDiagnostic("L2043", constructorName + " requires a Result expected type, received " + typeName(expectedType), node.span))
		}
		let expectedPayload = match payloadType { Some(value) => value, None => MvpType.ErrorType }
		let sourceId = childAt(node, 0)?
		let checked = checkExpectedExpression(sourceId, expectedPayload, context, expressions)?
		return Ok(checkedVariant(node, constructorName, expectedType, [checked.expressionId], checked.expressions))
	}
	return Err(errorDiagnostic("L9001", "Unknown standard variant constructor " + node.text, node.span))
}

fn checkExpectedConditional(node: MvpExpression, expectedType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let conditionSourceId = childAt(node, 0)?
	let consequentSourceId = childAt(node, 1)?
	let alternateSourceId = childAt(node, 2)?
	let condition = checkExpression(conditionSourceId, context, expressions)?
	if !typesCompatible(condition.valueType, MvpType.BoolType) {
		let source = sourceExpressionAt(context, conditionSourceId)?
		return Err(typeMismatch(condition.valueType, MvpType.BoolType, source.span))
	}
	let consequent = checkExpectedExpression(consequentSourceId, expectedType, context, condition.expressions)?
	let alternate = checkExpectedExpression(alternateSourceId, expectedType, context, consequent.expressions)?
	return Ok(addHir(alternate.expressions, MvpHirExpression {
		kind: "if",
		text: node.text,
		valueType: expectedType,
		children: [condition.expressionId, consequent.expressionId, alternate.expressionId],
		span: node.span,
	}, expectedType))
}

fn checkExpectedMatchArm(armSourceId: Int, targetType: MvpType, expectedType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let arm = sourceExpressionAt(context, armSourceId)?
	if arm.kind != "matchArm" {
		return Err(errorDiagnostic("L9001", "Match expression contains a non-arm child", arm.span))
	}
	let patternSourceId = childAt(arm, 0)?
	let bodySourceId = childAt(arm, 1)?
	let checkedPattern = checkPattern(patternSourceId, targetType, context, expressions)?
	let checkedBody = checkExpectedExpression(bodySourceId, expectedType, CheckContext {
		signatures: context.signatures,
		bindings: checkedPattern.bindings,
		returnType: context.returnType,
		sourceExpressions: context.sourceExpressions,
		sourceStatements: context.sourceStatements,
	}, checkedPattern.expressions)?
	return Ok(addHir(checkedBody.expressions, MvpHirExpression {
		kind: "matchArm",
		text: arm.text,
		valueType: expectedType,
		children: [checkedPattern.expressionId, checkedBody.expressionId],
		span: arm.span,
	}, expectedType))
}

fn checkExpectedMatch(node: MvpExpression, expectedType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let targetSourceId = childAt(node, 0)?
	let checkedTarget = checkExpression(targetSourceId, context, expressions)?
	let mut childIds: List<Int> = [checkedTarget.expressionId]
	let mut arena = checkedTarget.expressions
	let mut index = 1
	while index < List.length(node.children) {
		let armSourceId = childAt(node, index)?
		let checkedArm = checkExpectedMatchArm(armSourceId, checkedTarget.valueType, expectedType, context, arena)?
		childIds = List.append(childIds, checkedArm.expressionId)
		arena = checkedArm.expressions
		index = index + 1
	}
	return Ok(addHir(arena, MvpHirExpression {
		kind: "match",
		text: node.text,
		valueType: expectedType,
		children: childIds,
		span: node.span,
	}, expectedType))
}

fn checkExpectedExpression(expressionId: Int, expectedType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let node = sourceExpressionAt(context, expressionId)?
	let constructorName = standardConstructorName(node.text)
	if constructorName != "" && (node.kind == "identifier" || node.kind == "call") {
		return checkExpectedVariant(node, expectedType, context, expressions)
	}
	if node.kind == "if" {
		return checkExpectedConditional(node, expectedType, context, expressions)
	}
	if node.kind == "match" {
		return match checkMatch(node, context, expressions) {
			Ok(checked) => if typesCompatible(checked.valueType, expectedType) then Ok(checked) else Err(typeMismatch(checked.valueType, expectedType, node.span))
			Err(diagnostic) => if diagnostic.code == "L2020" then checkExpectedMatch(node, expectedType, context, expressions) else Err(diagnostic)
		}
	}
	let checked = checkExpression(expressionId, context, expressions)?
	if !typesCompatible(checked.valueType, expectedType) {
		return Err(typeMismatch(checked.valueType, expectedType, node.span))
	}
	return Ok(checked)
}

fn checkUnary(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let sourceId = childAt(node, 0)?
	let checked = checkExpression(sourceId, context, expressions)?
	if node.text == "!" {
		if !typesCompatible(checked.valueType, MvpType.BoolType) {
			let source = sourceExpressionAt(context, sourceId)?
			return Err(typeMismatch(checked.valueType, MvpType.BoolType, source.span))
		}
		return Ok(addHir(checked.expressions, MvpHirExpression {
			kind: "unary", text: node.text, valueType: MvpType.BoolType,
			children: [checked.expressionId], span: node.span,
		}, MvpType.BoolType))
	}
	if checked.valueType != MvpType.ErrorType && !isNumeric(checked.valueType) {
		return Err(errorDiagnostic("L2017", "Unary minus requires a numeric value", node.span))
	}
	return Ok(addHir(checked.expressions, MvpHirExpression {
		kind: "unary", text: node.text, valueType: checked.valueType,
		children: [checked.expressionId], span: node.span,
	}, checked.valueType))
}

fn checkedBinary(node: MvpExpression, left: CheckedExpression, right: CheckedExpression, resultType: MvpType) -> CheckedExpression {
	return addHir(right.expressions, MvpHirExpression {
		kind: "binary",
		text: node.text,
		valueType: resultType,
		children: [left.expressionId, right.expressionId],
		span: node.span,
	}, resultType)
}

fn checkBinary(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let leftSourceId = childAt(node, 0)?
	let rightSourceId = childAt(node, 1)?
	let left = checkExpression(leftSourceId, context, expressions)?
	let right = checkExpression(rightSourceId, context, left.expressions)?
	if node.text == "&&" || node.text == "||" {
		if !typesCompatible(left.valueType, MvpType.BoolType) {
			let source = sourceExpressionAt(context, leftSourceId)?
			return Err(typeMismatch(left.valueType, MvpType.BoolType, source.span))
		}
		if !typesCompatible(right.valueType, MvpType.BoolType) {
			let source = sourceExpressionAt(context, rightSourceId)?
			return Err(typeMismatch(right.valueType, MvpType.BoolType, source.span))
		}
		return Ok(checkedBinary(node, left, right, MvpType.BoolType))
	}
	if node.text == "==" || node.text == "!=" {
		if !typesCompatible(left.valueType, right.valueType) {
			let source = sourceExpressionAt(context, rightSourceId)?
			return Err(typeMismatch(right.valueType, left.valueType, source.span))
		}
		return Ok(checkedBinary(node, left, right, MvpType.BoolType))
	}
	let operandType = preferredType(left.valueType, right.valueType)
	if node.text == "<" || node.text == "<=" || node.text == ">" || node.text == ">=" {
		if !typesCompatible(left.valueType, right.valueType) || (operandType != MvpType.ErrorType && !isOrdered(operandType)) {
			return Err(errorDiagnostic("L2015", "Comparison requires operands of the same ordered type", node.span))
		}
		return Ok(checkedBinary(node, left, right, MvpType.BoolType))
	}
	if !typesCompatible(left.valueType, right.valueType) {
		let source = sourceExpressionAt(context, rightSourceId)?
		return Err(typeMismatch(right.valueType, left.valueType, source.span))
	}
	if node.text == "+" && operandType == MvpType.StringType {
		return Ok(checkedBinary(node, left, right, MvpType.StringType))
	}
	if operandType != MvpType.ErrorType && !isNumeric(operandType) {
		return Err(errorDiagnostic("L2016", "Operator " + node.text + " cannot be applied to " + typeName(operandType), node.span))
	}
	return Ok(checkedBinary(node, left, right, operandType))
}

fn checkConditional(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let conditionSourceId = childAt(node, 0)?
	let consequentSourceId = childAt(node, 1)?
	let alternateSourceId = childAt(node, 2)?
	let condition = checkExpression(conditionSourceId, context, expressions)?
	if !typesCompatible(condition.valueType, MvpType.BoolType) {
		let source = sourceExpressionAt(context, conditionSourceId)?
		return Err(typeMismatch(condition.valueType, MvpType.BoolType, source.span))
	}
	let consequent = checkExpression(consequentSourceId, context, condition.expressions)?
	let alternate = checkExpression(alternateSourceId, context, consequent.expressions)?
	if !typesCompatible(alternate.valueType, consequent.valueType) {
		let source = sourceExpressionAt(context, alternateSourceId)?
		return Err(typeMismatch(alternate.valueType, consequent.valueType, source.span))
	}
	let resultType = preferredType(consequent.valueType, alternate.valueType)
	return Ok(addHir(alternate.expressions, MvpHirExpression {
		kind: "if",
		text: node.text,
		valueType: resultType,
		children: [condition.expressionId, consequent.expressionId, alternate.expressionId],
		span: node.span,
	}, resultType))
}

fn checkedPatternNode(node: MvpExpression, valueType: MvpType, childIds: List<Int>, bindings: List<Binding>, expressions: List<MvpHirExpression>) -> CheckedPattern {
	let checked = addHir(expressions, MvpHirExpression {
		kind: node.kind,
		text: node.text,
		valueType: valueType,
		children: childIds,
		span: node.span,
	}, valueType)
	return CheckedPattern { expressionId: checked.expressionId, bindings: bindings, expressions: checked.expressions }
}

fn checkPattern(patternId: Int, targetType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedPattern, MvpDiagnostic> {
	let node = sourceExpressionAt(context, patternId)?
	if node.kind == "patternWildcard" {
		return Ok(checkedPatternNode(node, targetType, [], context.bindings, expressions))
	}
	if node.kind == "patternLiteral" {
		let patternType = literalType(node)?
		if !typesCompatible(patternType, targetType) {
			return Err(typeMismatch(patternType, targetType, node.span))
		}
		return Ok(checkedPatternNode(node, patternType, [], context.bindings, expressions))
	}
	if node.kind == "patternBinding" {
		if match findBinding(context.bindings, node.text) { Some(_) => true, None => false } {
			return Err(errorDiagnostic("L1007", "Pattern binding " + node.text + " shadows an existing name", node.span))
		}
		let bindings = List.append(context.bindings, Binding { name: node.text, valueType: targetType, mutable: false })
		return Ok(checkedPatternNode(node, targetType, [], bindings, expressions))
	}
	if node.kind == "patternVariant" {
		let mut childIds: List<Int> = []
		let mut bindings = context.bindings
		let mut arena = expressions
		let mut index = 0
		for sourceChildId in node.children {
			let payloadType = variantPayloadType(targetType, node.text, index)
			let checked = checkPattern(sourceChildId, payloadType, CheckContext {
				signatures: context.signatures,
				bindings: bindings,
				returnType: context.returnType,
				sourceExpressions: context.sourceExpressions,
				sourceStatements: context.sourceStatements,
			}, arena)?
			childIds = List.append(childIds, checked.expressionId)
			bindings = checked.bindings
			arena = checked.expressions
			index = index + 1
		}
		return Ok(checkedPatternNode(node, targetType, childIds, bindings, arena))
	}
	return Err(errorDiagnostic("L9001", "Unknown MVP match pattern kind " + node.kind, node.span))
}

fn checkMatchArm(armSourceId: Int, targetType: MvpType, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let arm = sourceExpressionAt(context, armSourceId)?
	if arm.kind != "matchArm" {
		return Err(errorDiagnostic("L9001", "Match expression contains a non-arm child", arm.span))
	}
	let patternSourceId = childAt(arm, 0)?
	let bodySourceId = childAt(arm, 1)?
	let checkedPattern = checkPattern(patternSourceId, targetType, context, expressions)?
	let checkedBody = checkExpression(bodySourceId, CheckContext {
		signatures: context.signatures,
		bindings: checkedPattern.bindings,
		returnType: context.returnType,
		sourceExpressions: context.sourceExpressions,
		sourceStatements: context.sourceStatements,
	}, checkedPattern.expressions)?
	return Ok(addHir(checkedBody.expressions, MvpHirExpression {
		kind: "matchArm",
		text: arm.text,
		valueType: checkedBody.valueType,
		children: [checkedPattern.expressionId, checkedBody.expressionId],
		span: arm.span,
	}, checkedBody.valueType))
}

fn checkMatch(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let targetSourceId = childAt(node, 0)?
	let checkedTarget = checkExpression(targetSourceId, context, expressions)?
	let mut childIds: List<Int> = [checkedTarget.expressionId]
	let mut arena = checkedTarget.expressions
	let mut resultType: MvpType? = None
	let mut index = 1
	while index < List.length(node.children) {
		let armSourceId = childAt(node, index)?
		let checkedArm = checkMatchArm(armSourceId, checkedTarget.valueType, context, arena)?
		resultType = match resultType {
			None => Some(checkedArm.valueType)
			Some(existing) => if typesCompatible(existing, checkedArm.valueType) then Some(preferredType(existing, checkedArm.valueType)) else None
		}
		if match resultType { Some(_) => false, None => true } {
			let source = sourceExpressionAt(context, armSourceId)?
			return Err(errorDiagnostic("L2043", "Match arms must produce the same type", source.span))
		}
		childIds = List.append(childIds, checkedArm.expressionId)
		arena = checkedArm.expressions
		index = index + 1
	}
	let valueType = match resultType {
		Some(value) => if value == MvpType.ErrorType then context.returnType else value
		None => context.returnType
	}
	return Ok(addHir(arena, MvpHirExpression {
		kind: "match",
		text: node.text,
		valueType: valueType,
		children: childIds,
		span: node.span,
	}, valueType))
}

fn checkList(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	if List.isEmpty(node.children) {
		return Err(errorDiagnostic("L2020", "Cannot infer the element type of an empty List", node.span))
	}
	let firstSourceId = childAt(node, 0)?
	let first = checkExpression(firstSourceId, context, expressions)?
	let mut elementType = first.valueType
	let mut expressionIds: List<Int> = [first.expressionId]
	let mut arena = first.expressions
	let mut index = 1
	while index < List.length(node.children) {
		let sourceId = childAt(node, index)?
		let checked = checkExpression(sourceId, context, arena)?
		if !typesCompatible(checked.valueType, elementType) {
			let source = sourceExpressionAt(context, sourceId)?
			return Err(typeMismatch(checked.valueType, elementType, source.span))
		}
		elementType = preferredType(elementType, checked.valueType)
		expressionIds = List.append(expressionIds, checked.expressionId)
		arena = checked.expressions
		index = index + 1
	}
	let valueType = match listType(elementType) {
		Some(value) => value
		None => MvpType.ErrorType
	}
	if valueType == MvpType.ErrorType {
		return Err(errorDiagnostic("L2022", "MVP List elements must be Bool, Int, Float, String, or Unit", node.span))
	}
	return Ok(addHir(arena, MvpHirExpression {
		kind: "list",
		text: node.text,
		valueType: valueType,
		children: expressionIds,
		span: node.span,
	}, valueType))
}

fn checkIndex(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let targetSourceId = childAt(node, 0)?
	let indexSourceId = childAt(node, 1)?
	let target = checkExpression(targetSourceId, context, expressions)?
	let index = checkExpression(indexSourceId, context, target.expressions)?
	if !typesCompatible(index.valueType, MvpType.IntType) {
		let source = sourceExpressionAt(context, indexSourceId)?
		return Err(typeMismatch(index.valueType, MvpType.IntType, source.span))
	}
	if target.valueType == MvpType.ErrorType {
		return Ok(addHir(index.expressions, MvpHirExpression {
			kind: "index", text: node.text, valueType: MvpType.ErrorType,
			children: [target.expressionId, index.expressionId], span: node.span,
		}, MvpType.ErrorType))
	}
	return match listElementType(target.valueType) {
		Some(elementType) => Ok(addHir(index.expressions, MvpHirExpression {
			kind: "index",
			text: node.text,
			valueType: elementType,
			children: [target.expressionId, index.expressionId],
			span: node.span,
		}, elementType))
		None => Err(errorDiagnostic("L2021", "Index access requires List, received " + typeName(target.valueType), node.span))
	}
}

fn checkRecordField(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let sourceId = childAt(node, 0)?
	let checked = checkExpression(sourceId, context, expressions)?
	return Ok(addHir(checked.expressions, MvpHirExpression {
		kind: "recordField",
		text: node.text,
		valueType: checked.valueType,
		children: [checked.expressionId],
		span: node.span,
	}, checked.valueType))
}

fn checkRecord(node: MvpExpression, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let mut expressionIds: List<Int> = []
	let mut arena = expressions
	let mut index = 0
	while index < List.length(node.children) {
		let sourceId = childAt(node, index)?
		let source = sourceExpressionAt(context, sourceId)?
		if source.kind != "recordField" {
			return Err(errorDiagnostic("L9001", "Record construction contains a non-field child", source.span))
		}
		let checked = checkRecordField(source, context, arena)?
		expressionIds = List.append(expressionIds, checked.expressionId)
		arena = checked.expressions
		index = index + 1
	}
	let valueType = MvpType.NamedType(node.text)
	return Ok(addHir(arena, MvpHirExpression {
		kind: "record",
		text: node.text,
		valueType: valueType,
		children: expressionIds,
		span: node.span,
	}, valueType))
}

fn checkExpression(expressionId: Int, context: CheckContext, expressions: List<MvpHirExpression>) -> Result<CheckedExpression, MvpDiagnostic> {
	let node = sourceExpressionAt(context, expressionId)?
	if node.kind == "bool" || node.kind == "number" || node.kind == "string" || node.kind == "unit" {
		return checkLiteral(node, expressions)
	}
	if node.kind == "identifier" {
		return checkIdentifier(node, context, expressions)
	}
	if node.kind == "call" {
		return checkCall(node, context, expressions)
	}
	if node.kind == "unary" {
		return checkUnary(node, context, expressions)
	}
	if node.kind == "binary" {
		return checkBinary(node, context, expressions)
	}
	if node.kind == "if" {
		return checkConditional(node, context, expressions)
	}
	if node.kind == "match" {
		return checkMatch(node, context, expressions)
	}
	if node.kind == "list" {
		return checkList(node, context, expressions)
	}
	if node.kind == "index" {
		return checkIndex(node, context, expressions)
	}
	if node.kind == "recordField" {
		return checkRecordField(node, context, expressions)
	}
	if node.kind == "record" {
		return checkRecord(node, context, expressions)
	}
	return Err(errorDiagnostic("L9001", "Unknown MVP expression kind " + node.kind, node.span))
}

fn checkLet(name: String, mutable: Bool, annotation: MvpType?, sourceExpressionId: Int, statementSpan: MvpSpan, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	if match findBinding(context.bindings, name) { Some(_) => true, None => false } {
		return Err(errorDiagnostic("L1007", "Local name " + name + " shadows an existing name", statementSpan))
	}
	let checked = match annotation {
		Some(expectedType) => checkExpectedExpression(sourceExpressionId, expectedType, context, expressions)
		None => checkExpression(sourceExpressionId, context, expressions)
	}?
	let expected = match annotation { Some(value) => value, None => checked.valueType }
	return Ok(addHirStatement(
		statements,
		checked.expressions,
		List.append(context.bindings, Binding { name: name, valueType: expected, mutable: mutable }),
		MvpHirStatement.HirLet(name, mutable, expected, checked.expressionId, statementSpan),
	))
}
fn checkAssignment(name: String, sourceExpressionId: Int, statementSpan: MvpSpan, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	let found = findBinding(context.bindings, name)
	if match found { Some(_) => false, None => true } {
		return Err(errorDiagnostic("L1009", "Unknown name " + name, statementSpan))
	}
	let binding = match found {
		Some(value) => value
		None => Binding { name: name, valueType: MvpType.ErrorType, mutable: false }
	}
	if !binding.mutable {
		return Err(errorDiagnostic("L2010", "Cannot assign to immutable name " + name, statementSpan))
	}
	let checked = checkExpectedExpression(sourceExpressionId, binding.valueType, context, expressions)?
	return Ok(addHirStatement(
		statements,
		checked.expressions,
		context.bindings,
		MvpHirStatement.HirAssign(name, binding.valueType, checked.expressionId, statementSpan),
	))
}
fn checkBlock(sourceStatementIds: List<Int>, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedBlock, MvpDiagnostic> {
	let mut blockBindings = context.bindings
	let mut checkedStatementIds: List<Int> = []
	let mut statementArena = statements
	let mut expressionArena = expressions
	for sourceStatementId in sourceStatementIds {
		let checked = checkStatement(sourceStatementId, CheckContext {
			signatures: context.signatures,
			bindings: blockBindings,
			returnType: context.returnType,
			sourceExpressions: context.sourceExpressions,
			sourceStatements: context.sourceStatements,
		}, statementArena, expressionArena)?
		checkedStatementIds = List.append(checkedStatementIds, checked.statementId)
		blockBindings = checked.bindings
		statementArena = checked.statements
		expressionArena = checked.expressions
	}
	return Ok(CheckedBlock { statementIds: checkedStatementIds, statements: statementArena, expressions: expressionArena })
}

fn checkFor(name: String, sourceIterableId: Int, bodyStatementIds: List<Int>, statementSpan: MvpSpan, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	if match findBinding(context.bindings, name) { Some(_) => true, None => false } {
		return Err(errorDiagnostic("L1008", "Loop variable " + name + " shadows an existing name", statementSpan))
	}
	let checkedIterable = checkExpression(sourceIterableId, context, expressions)?
	let itemType = if checkedIterable.valueType == MvpType.StringType then Some(MvpType.StringType) else listElementType(checkedIterable.valueType)
	if match itemType { Some(_) => false, None => true } {
		let source = sourceExpressionAt(context, sourceIterableId)?
		return Err(errorDiagnostic("L2004", "for requires an iterable List, Set, Map, or String value", source.span))
	}
	let loopType = match itemType {
		Some(value) => value
		None => MvpType.ErrorType
	}
	let loopContext = CheckContext {
		signatures: context.signatures,
		bindings: List.append(context.bindings, Binding { name: name, valueType: loopType, mutable: false }),
		returnType: context.returnType,
		sourceExpressions: context.sourceExpressions,
		sourceStatements: context.sourceStatements,
	}
	let checkedBody = checkBlock(bodyStatementIds, loopContext, statements, checkedIterable.expressions)?
	return Ok(addHirStatement(
		checkedBody.statements,
		checkedBody.expressions,
		context.bindings,
		MvpHirStatement.HirFor(name, loopType, checkedIterable.expressionId, checkedBody.statementIds, statementSpan),
	))
}

fn checkWhile(sourceConditionId: Int, bodyStatementIds: List<Int>, statementSpan: MvpSpan, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	let checkedCondition = checkExpression(sourceConditionId, context, expressions)?
	if !typesCompatible(checkedCondition.valueType, MvpType.BoolType) {
		let source = sourceExpressionAt(context, sourceConditionId)?
		return Err(typeMismatch(checkedCondition.valueType, MvpType.BoolType, source.span))
	}
	let checkedBody = checkBlock(bodyStatementIds, context, statements, checkedCondition.expressions)?
	return Ok(addHirStatement(
		checkedBody.statements,
		checkedBody.expressions,
		context.bindings,
		MvpHirStatement.HirWhile(checkedCondition.expressionId, checkedBody.statementIds, statementSpan),
	))
}

fn checkIf(sourceConditionId: Int, consequentStatementIds: List<Int>, alternateStatementIds: List<Int>, statementSpan: MvpSpan, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	let checkedCondition = checkExpression(sourceConditionId, context, expressions)?
	if !typesCompatible(checkedCondition.valueType, MvpType.BoolType) {
		let source = sourceExpressionAt(context, sourceConditionId)?
		return Err(typeMismatch(checkedCondition.valueType, MvpType.BoolType, source.span))
	}
	let checkedConsequent = checkBlock(consequentStatementIds, context, statements, checkedCondition.expressions)?
	let checkedAlternate = checkBlock(alternateStatementIds, context, checkedConsequent.statements, checkedConsequent.expressions)?
	return Ok(addHirStatement(
		checkedAlternate.statements,
		checkedAlternate.expressions,
		context.bindings,
		MvpHirStatement.HirIf(checkedCondition.expressionId, checkedConsequent.statementIds, checkedAlternate.statementIds, statementSpan),
	))
}

fn checkReturn(sourceExpressionId: Int, statementSpan: MvpSpan, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	let checked = checkExpectedExpression(sourceExpressionId, context.returnType, context, expressions)?
	return Ok(addHirStatement(
		statements,
		checked.expressions,
		context.bindings,
		MvpHirStatement.HirReturn(checked.expressionId, statementSpan),
	))
}
fn checkStatement(statementId: Int, context: CheckContext, statements: List<MvpHirStatement>, expressions: List<MvpHirExpression>) -> Result<CheckedStatement, MvpDiagnostic> {
	let statement = sourceStatementAt(context, statementId)?
	return match statement {
		LetValue(name, mutable, annotation, expressionId, valueSpan) => checkLet(name, mutable, annotation, expressionId, valueSpan, context, statements, expressions)
		AssignValue(name, expressionId, valueSpan) => checkAssignment(name, expressionId, valueSpan, context, statements, expressions)
		ForValue(name, iterableId, bodyStatementIds, valueSpan) => checkFor(name, iterableId, bodyStatementIds, valueSpan, context, statements, expressions)
		WhileValue(conditionId, bodyStatementIds, valueSpan) => checkWhile(conditionId, bodyStatementIds, valueSpan, context, statements, expressions)
		IfValue(conditionId, consequentStatementIds, alternateStatementIds, valueSpan) => checkIf(conditionId, consequentStatementIds, alternateStatementIds, valueSpan, context, statements, expressions)
		ReturnValue(expressionId, valueSpan) => checkReturn(expressionId, valueSpan, context, statements, expressions)
	}
}

fn parameterBindings(parameters: List<MvpParameter>) -> Result<List<Binding>, MvpDiagnostic> {
	let mut bindings: List<Binding> = []
	for parameter in parameters {
		if match findBinding(bindings, parameter.name) { Some(_) => true, None => false } {
			return Err(errorDiagnostic("L1003", "Duplicate parameter " + parameter.name, parameter.span))
		}
		bindings = List.append(bindings, Binding { name: parameter.name, valueType: parameter.valueType, mutable: false })
	}
	return Ok(bindings)
}

fn checkFunction(function: MvpFunction, signatures: List<Signature>) -> Result<MvpHirFunction, MvpDiagnostic> {
	let mut bindings = parameterBindings(function.parameters)?
	let mut statementIds: List<Int> = []
	let mut statements: List<MvpHirStatement> = []
	let mut expressions: List<MvpHirExpression> = []
	for sourceStatementId in function.statementIds {
		let checked = checkStatement(sourceStatementId, CheckContext {
			signatures: signatures,
			bindings: bindings,
			returnType: function.returnType,
			sourceExpressions: function.expressions,
			sourceStatements: function.statements,
		}, statements, expressions)?
		statementIds = List.append(statementIds, checked.statementId)
		bindings = checked.bindings
		statements = checked.statements
		expressions = checked.expressions
	}
	return Ok(MvpHirFunction {
		isPublic: function.isPublic,
		name: function.name,
		parameters: function.parameters,
		returnType: function.returnType,
		expressions: expressions,
		statementIds: statementIds,
		statements: statements,
		span: function.span,
	})
}

fn registerSignatures(functions: List<MvpFunction>) -> Result<List<Signature>, MvpDiagnostic> {
	let mut signatures: List<Signature> = []
	for function in functions {
		if match findSignature(signatures, function.name) { Some(_) => true, None => false } {
			return Err(errorDiagnostic("L1001", "Duplicate definition " + function.name, function.span))
		}
		signatures = List.append(signatures, Signature {
			name: function.name,
			parameters: parameterTypes(function.parameters),
			returnType: function.returnType,
			isPublic: function.isPublic,
			span: function.span,
		})
	}
	return Ok(signatures)
}

fn checkModule(moduleValue: MvpModule) -> Result<MvpHirModule, MvpDiagnostic> {
	let signatures = registerSignatures(moduleValue.functions)?
	let mut functions: List<MvpHirFunction> = []
	for function in moduleValue.functions {
		functions = List.append(functions, checkFunction(function, signatures)?)
	}
	return Ok(MvpHirModule { functions: functions })
}

fn checkMvp(moduleValue: MvpModule) -> MvpCheckResult {
	let exports = sourceExports(moduleValue)
	return match checkModule(moduleValue) {
		Ok(value) => MvpCheckResult { hirModule: Some(value), diagnostics: [], exports: exports }
		Err(diagnostic) => MvpCheckResult { hirModule: None, diagnostics: [diagnostic], exports: exports }
	}
}

pub fn checkMvpJson(encoded: String) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let parsed = Json.decode<MvpParseTransport>(raw)?
	if List.isNotEmpty(parsed.diagnostics) || match parsed.parsedModule { Some(_) => false, None => true } {
		return Json.encode<MvpCheckResult>(MvpCheckResult {
			hirModule: None,
			diagnostics: parsed.diagnostics,
			exports: [],
		})
	}
	let moduleValue = match parsed.parsedModule {
		Some(value) => value
		None => MvpModule { functions: [] }
	}
	return Json.encode<MvpCheckResult>(checkMvp(moduleValue))
}
