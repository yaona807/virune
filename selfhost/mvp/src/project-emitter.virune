//! Deterministic project module emission for the self-host compiler.

pub record ProjectEmitterDependency derives Eq, Debug, Json {
	modulePath: String
	sourceKind: String
	specifier: String
	resolvedPath: String?
	typeOnly: Bool
	public: Bool
}

pub record ProjectEmitterExport derives Eq, Debug, Json {
	modulePath: String
	name: String
	declarationKind: String
}

pub record ProjectEmitterModule derives Eq, Debug, Json {
	sourcePath: String
	outputPath: String
	preamble: List<String>
	statements: List<String>
	sourceMap: String
}

pub record ProjectEmitterRequest derives Eq, Debug, Json {
	entryPath: String
	modules: List<ProjectEmitterModule>
	dependencies: List<ProjectEmitterDependency>
	exportedSymbols: List<ProjectEmitterExport>
}

pub record ProjectEmitterDiagnostic derives Eq, Debug, Json {
	code: String
	severity: String
	message: String
	sourcePath: String?
	outputPath: String?
}

pub record ProjectEmittedModule derives Eq, Debug, Json {
	sourcePath: String
	outputPath: String
	code: String
	sourceMap: String
}

pub record ProjectEmitterResult derives Eq, Debug, Json {
	accepted: Bool
	entryPath: String
	emittedModules: List<ProjectEmittedModule>
	dependencies: List<ProjectEmitterDependency>
	exportedSymbols: List<ProjectEmitterExport>
	diagnostics: List<ProjectEmitterDiagnostic>
}

fn emitterDiagnostic(
	code: String,
	message: String,
	sourcePath: String?,
	outputPath: String?,
) -> ProjectEmitterDiagnostic {
	return ProjectEmitterDiagnostic {
		code: code,
		severity: "error",
		message: message,
		sourcePath: sourcePath,
		outputPath: outputPath,
	}
}

fn containsText(values: List<String>, expected: String) -> Bool {
	for value in values {
		if value == expected {
			return true
		}
	}
	return false
}

fn optionText(value: String?) -> String {
	return match value {
		Some(text) => text
		None => ""
	}
}

fn boolText(value: Bool) -> String {
	return if value then "1" else "0"
}

fn moduleLessThan(left: ProjectEmitterModule, right: ProjectEmitterModule) -> Bool {
	if left.sourcePath != right.sourcePath {
		return left.sourcePath < right.sourcePath
	}
	return left.outputPath < right.outputPath
}

fn insertModule(values: List<ProjectEmitterModule>, value: ProjectEmitterModule) -> List<ProjectEmitterModule> {
	let mut result: List<ProjectEmitterModule> = []
	let mut inserted = false
	for current in values {
		if !inserted && moduleLessThan(value, current) {
			result = List.append(result, value)
			inserted = true
		}
		result = List.append(result, current)
	}
	if !inserted {
		result = List.append(result, value)
	}
	return result
}

fn sortModules(values: List<ProjectEmitterModule>) -> List<ProjectEmitterModule> {
	let mut result: List<ProjectEmitterModule> = []
	for value in values {
		result = insertModule(result, value)
	}
	return result
}

fn dependencyKey(value: ProjectEmitterDependency) -> String {
	return value.modulePath + "|" +
		value.sourceKind + "|" +
		value.specifier + "|" +
		optionText(value.resolvedPath) + "|" +
		boolText(value.typeOnly) + "|" +
		boolText(value.public)
}

fn dependencyLessThan(left: ProjectEmitterDependency, right: ProjectEmitterDependency) -> Bool {
	return dependencyKey(left) < dependencyKey(right)
}

fn insertDependency(
	values: List<ProjectEmitterDependency>,
	value: ProjectEmitterDependency,
) -> List<ProjectEmitterDependency> {
	let mut result: List<ProjectEmitterDependency> = []
	let mut inserted = false
	for current in values {
		if !inserted && dependencyLessThan(value, current) {
			result = List.append(result, value)
			inserted = true
		}
		result = List.append(result, current)
	}
	if !inserted {
		result = List.append(result, value)
	}
	return result
}

fn sortDependencies(values: List<ProjectEmitterDependency>) -> List<ProjectEmitterDependency> {
	let mut result: List<ProjectEmitterDependency> = []
	for value in values {
		result = insertDependency(result, value)
	}
	return result
}

fn exportLessThan(left: ProjectEmitterExport, right: ProjectEmitterExport) -> Bool {
	if left.modulePath != right.modulePath {
		return left.modulePath < right.modulePath
	}
	if left.name != right.name {
		return left.name < right.name
	}
	return left.declarationKind < right.declarationKind
}

fn insertExport(values: List<ProjectEmitterExport>, value: ProjectEmitterExport) -> List<ProjectEmitterExport> {
	let mut result: List<ProjectEmitterExport> = []
	let mut inserted = false
	for current in values {
		if !inserted && exportLessThan(value, current) {
			result = List.append(result, value)
			inserted = true
		}
		result = List.append(result, current)
	}
	if !inserted {
		result = List.append(result, value)
	}
	return result
}

fn sortExports(values: List<ProjectEmitterExport>) -> List<ProjectEmitterExport> {
	let mut result: List<ProjectEmitterExport> = []
	for value in values {
		result = insertExport(result, value)
	}
	return result
}

fn validLine(value: String) -> Bool {
	return !String.contains(value, "\n") && !String.contains(value, "\r")
}

fn appendLines(value: String, lines: List<String>) -> String {
	let mut result = value
	for line in lines {
		result = result + line + "\n"
	}
	return result
}

fn emitModule(projectModule: ProjectEmitterModule) -> ProjectEmittedModule {
	let mut code = "// Generated by Virune self-host project emitter.\n"
	code = appendLines(code, projectModule.preamble)
	code = appendLines(code, projectModule.statements)
	return ProjectEmittedModule {
		sourcePath: projectModule.sourcePath,
		outputPath: projectModule.outputPath,
		code: code,
		sourceMap: projectModule.sourceMap,
	}
}

fn validateModule(
	projectModule: ProjectEmitterModule,
	seenSources: List<String>,
	seenOutputs: List<String>,
) -> List<ProjectEmitterDiagnostic> {
	let mut diagnostics: List<ProjectEmitterDiagnostic> = []
	if String.length(projectModule.sourcePath) == 0 {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4001",
			"Emitter source path must not be empty",
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	if String.length(projectModule.outputPath) == 0 {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4002",
			"Emitter output path must not be empty",
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	if containsText(seenSources, projectModule.sourcePath) {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4003",
			"Duplicate emitter source path " + projectModule.sourcePath,
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	if containsText(seenOutputs, projectModule.outputPath) {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4004",
			"Duplicate emitter output path " + projectModule.outputPath,
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	for line in projectModule.preamble {
		if !validLine(line) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4005",
				"Emitter preamble entries must contain exactly one normalized line",
				Some(projectModule.sourcePath),
				Some(projectModule.outputPath),
			))
		}
	}
	for line in projectModule.statements {
		if !validLine(line) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4006",
				"Emitter statement entries must contain exactly one normalized line",
				Some(projectModule.sourcePath),
				Some(projectModule.outputPath),
			))
		}
	}
	if String.contains(projectModule.sourceMap, "\r") {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4007",
			"Emitter source map must use LF line endings",
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	return diagnostics
}

pub fn emitProject(request: ProjectEmitterRequest) -> ProjectEmitterResult {
	let modules = sortModules(request.modules)
	let dependencies = sortDependencies(request.dependencies)
	let exportedSymbols = sortExports(request.exportedSymbols)
	let mut diagnostics: List<ProjectEmitterDiagnostic> = []
	let mut seenSources: List<String> = []
	let mut seenOutputs: List<String> = []
	let mut emittedModules: List<ProjectEmittedModule> = []
	let mut entryFound = false
	for projectModule in modules {
		for diagnostic in validateModule(projectModule, seenSources, seenOutputs) {
			diagnostics = List.append(diagnostics, diagnostic)
		}
		if projectModule.sourcePath == request.entryPath {
			entryFound = true
		}
		seenSources = List.append(seenSources, projectModule.sourcePath)
		seenOutputs = List.append(seenOutputs, projectModule.outputPath)
		emittedModules = List.append(emittedModules, emitModule(projectModule))
	}
	if !entryFound {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4008",
			"Emitter entry path is not present in the module set",
			Some(request.entryPath),
			None,
		))
	}
	let accepted = List.length(diagnostics) == 0
	return ProjectEmitterResult {
		accepted: accepted,
		entryPath: request.entryPath,
		emittedModules: if accepted then emittedModules else [],
		dependencies: dependencies,
		exportedSymbols: exportedSymbols,
		diagnostics: diagnostics,
	}
}

fn decodeProjectEmitterRequest(encoded: String) -> Result<ProjectEmitterRequest, List<JsonError>> {
	let raw = Json.parse(encoded)?
	return Json.decode<ProjectEmitterRequest>(raw)
}

pub fn emitProjectJson(encoded: String) -> Result<String, List<JsonError>> {
	return Json.encode<ProjectEmitterResult>(emitProject(decodeProjectEmitterRequest(encoded)?))
}
