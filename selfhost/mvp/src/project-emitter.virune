//! Deterministic project module emission for the self-host compiler.

pub record ProjectEmitterDependency derives Eq, Debug, Json {
	modulePath: String
	sourceKind: String
	specifier: String
	resolvedPath: String?
	typeOnly: Bool
	public: Bool
}

pub record ProjectEmitterExport derives Eq, Debug, Json {
	modulePath: String
	name: String
	declarationKind: String
}

pub record ProjectEmitterModule derives Eq, Debug, Json {
	sourcePath: String
	outputPath: String
	preamble: List<String>
	statements: List<String>
	sourceMap: String
}

pub record ProjectEmitterRequest derives Eq, Debug, Json {
	entryPath: String
	modules: List<ProjectEmitterModule>
	dependencies: List<ProjectEmitterDependency>
	exportedSymbols: List<ProjectEmitterExport>
}

pub record ProjectEmitterDiagnostic derives Eq, Debug, Json {
	code: String
	severity: String
	message: String
	sourcePath: String?
	outputPath: String?
}

pub record ProjectEmittedModule derives Eq, Debug, Json {
	sourcePath: String
	outputPath: String
	code: String
	sourceMap: String
}

pub record ProjectEmitterResult derives Eq, Debug, Json {
	accepted: Bool
	entryPath: String
	emittedModules: List<ProjectEmittedModule>
	dependencies: List<ProjectEmitterDependency>
	exportedSymbols: List<ProjectEmitterExport>
	diagnostics: List<ProjectEmitterDiagnostic>
}

fn emitterDiagnostic(
	code: String,
	message: String,
	sourcePath: String?,
	outputPath: String?,
) -> ProjectEmitterDiagnostic {
	return ProjectEmitterDiagnostic {
		code: code,
		severity: "error",
		message: message,
		sourcePath: sourcePath,
		outputPath: outputPath,
	}
}

fn containsText(values: List<String>, expected: String) -> Bool {
	for value in values {
		if value == expected {
			return true
		}
	}
	return false
}

fn optionText(value: String?) -> String {
	return match value {
		Some(text) => text
		None => ""
	}
}

fn boolText(value: Bool) -> String {
	return if value then "1" else "0"
}

fn moduleLessThan(left: ProjectEmitterModule, right: ProjectEmitterModule) -> Bool {
	if left.sourcePath != right.sourcePath {
		return left.sourcePath < right.sourcePath
	}
	return left.outputPath < right.outputPath
}

fn insertModule(values: List<ProjectEmitterModule>, value: ProjectEmitterModule) -> List<ProjectEmitterModule> {
	let mut result: List<ProjectEmitterModule> = []
	let mut inserted = false
	for current in values {
		if !inserted && moduleLessThan(value, current) {
			result = List.append(result, value)
			inserted = true
		}
		result = List.append(result, current)
	}
	if !inserted {
		result = List.append(result, value)
	}
	return result
}

fn sortModules(values: List<ProjectEmitterModule>) -> List<ProjectEmitterModule> {
	let mut result: List<ProjectEmitterModule> = []
	for value in values {
		result = insertModule(result, value)
	}
	return result
}

fn dependencyKey(value: ProjectEmitterDependency) -> String {
	return value.modulePath + "|" +
		value.sourceKind + "|" +
		value.specifier + "|" +
		optionText(value.resolvedPath) + "|" +
		boolText(value.typeOnly) + "|" +
		boolText(value.public)
}

fn dependencyLessThan(left: ProjectEmitterDependency, right: ProjectEmitterDependency) -> Bool {
	return dependencyKey(left) < dependencyKey(right)
}

fn insertDependency(
	values: List<ProjectEmitterDependency>,
	value: ProjectEmitterDependency,
) -> List<ProjectEmitterDependency> {
	let mut result: List<ProjectEmitterDependency> = []
	let mut inserted = false
	for current in values {
		if !inserted && dependencyLessThan(value, current) {
			result = List.append(result, value)
			inserted = true
		}
		result = List.append(result, current)
	}
	if !inserted {
		result = List.append(result, value)
	}
	return result
}

fn sortDependencies(values: List<ProjectEmitterDependency>) -> List<ProjectEmitterDependency> {
	let mut result: List<ProjectEmitterDependency> = []
	for value in values {
		result = insertDependency(result, value)
	}
	return result
}

fn exportKey(value: ProjectEmitterExport) -> String {
	return value.modulePath + "|" + value.name + "|" + value.declarationKind
}

fn exportLessThan(left: ProjectEmitterExport, right: ProjectEmitterExport) -> Bool {
	return exportKey(left) < exportKey(right)
}

fn insertExport(values: List<ProjectEmitterExport>, value: ProjectEmitterExport) -> List<ProjectEmitterExport> {
	let mut result: List<ProjectEmitterExport> = []
	let mut inserted = false
	for current in values {
		if !inserted && exportLessThan(value, current) {
			result = List.append(result, value)
			inserted = true
		}
		result = List.append(result, current)
	}
	if !inserted {
		result = List.append(result, value)
	}
	return result
}

fn sortExports(values: List<ProjectEmitterExport>) -> List<ProjectEmitterExport> {
	let mut result: List<ProjectEmitterExport> = []
	for value in values {
		result = insertExport(result, value)
	}
	return result
}

fn moduleExists(values: List<ProjectEmitterModule>, sourcePath: String) -> Bool {
	for projectModule in values {
		if projectModule.sourcePath == sourcePath {
			return true
		}
	}
	return false
}

fn validateMetadata(
	modules: List<ProjectEmitterModule>,
	dependencies: List<ProjectEmitterDependency>,
	exportedSymbols: List<ProjectEmitterExport>,
) -> List<ProjectEmitterDiagnostic> {
	let mut diagnostics: List<ProjectEmitterDiagnostic> = []
	let mut seenDependencies: List<String> = []
	for dependency in dependencies {
		let key = dependencyKey(dependency)
		if containsText(seenDependencies, key) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4012",
				"Duplicate emitter dependency metadata " + key,
				Some(dependency.modulePath),
				None,
			))
		} else {
			seenDependencies = List.append(seenDependencies, key)
		}
		if !moduleExists(modules, dependency.modulePath) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4009",
				"Emitter dependency module path is not present in the module set " + dependency.modulePath,
				Some(dependency.modulePath),
				None,
			))
		}
		if dependency.sourceKind == "virune" {
			let targetPath = optionText(dependency.resolvedPath)
			if String.length(targetPath) == 0 {
				diagnostics = List.append(diagnostics, emitterDiagnostic(
					"SHP4010",
					"Emitter Virune dependency target must be resolved for " + dependency.specifier,
					Some(dependency.modulePath),
					None,
				))
			} else if !moduleExists(modules, targetPath) {
				diagnostics = List.append(diagnostics, emitterDiagnostic(
					"SHP4010",
					"Emitter Virune dependency target is not present in the module set " + targetPath,
					Some(dependency.modulePath),
					None,
				))
			}
		}
	}
	let mut seenExports: List<String> = []
	for exported in exportedSymbols {
		let key = exportKey(exported)
		if containsText(seenExports, key) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4013",
				"Duplicate emitter exported symbol metadata " + key,
				Some(exported.modulePath),
				None,
			))
		} else {
			seenExports = List.append(seenExports, key)
		}
		if !moduleExists(modules, exported.modulePath) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4011",
				"Emitter export module path is not present in the module set " + exported.modulePath,
				Some(exported.modulePath),
				None,
			))
		}
	}
	return diagnostics
}

fn validLine(value: String) -> Bool {
	return !String.contains(value, "\n") && !String.contains(value, "\r")
}

fn appendLines(value: String, lines: List<String>) -> String {
	let mut result = value
	for line in lines {
		result = result + line + "\n"
	}
	return result
}

fn selfhostRuntimeImportLine() -> String {
	return "import { intAdd, intDivide, intMultiply, intNegate, intRemainder, intSubtract, isPropagation, propagate, rootTaskContext, viruneEquals } from '@virune/runtime/v2/index.js';"
}

fn productionRuntimeImportLine() -> String {
	return "import { Err, None, Ok, Some, checkForeignBigInt, checkForeignBool, checkForeignFloat, checkForeignString, debugValue, decodeJsonValue, defensiveCopy, byteCreate, bytesConcat, bytesEmpty, bytesFromBase64, bytesFromHex, bytesFromUtf8, bytesGet, bytesLength, bytesReadInt32, bytesSet, bytesSlice, bytesToBase64, bytesToHex, bytesToUtf8, bytesWriteInt32, mutableBytesCreate, mutableBytesFill, mutableBytesFromBytes, mutableBytesGet, mutableBytesLength, mutableBytesSet, mutableBytesToBytes, durationHours, durationMilliseconds, durationMinutes, durationSeconds, durationToMilliseconds, encodeFfiValue, encodeJsonValue, floatToInt, int16Create, int16ToInt, int32Create, int32ToInt, int64Create, int64ToBigInt, int8Create, int8ToInt, intAdd, intDivide, intMultiply, intNegate, intRemainder, intSubtract, isPropagation, listAll, listAny, listAppend, listConcat, listDrop, listEnumerate, listFilter, listFind, listFirst, listFlatMap, listFold, listGet, listIsEmpty, listIsNotEmpty, listLast, listLength, listMap, listPrepend, listReverse, listTake, listUnique, listUniqueBy, listZip, makeRecord, makeVariant, mapEmpty, mapEntries, mapGet, mapHas, mapKeys, mapMapValues, mapMerge, mapRemove, mapSet, mapSize, mapValues, optionAndThen, optionCollect, optionFilter, optionMap, optionToResult, optionUnwrapOr, panic, parallel, parallelTry, parseJson, propagate, queueDequeue, queueEmpty, queueEnqueue, resultAndThen, resultCollect, resultCollectErrors, resultMap, resultMapError, resultOrElse, resultToOption, resultUnwrapOr, rootTaskContext, runDefers, runDefersAsync, safeCall, safeCallAsync, setAdd, setDifference, setEmpty, setFrom, setHas, setIntersection, setRemove, setSize, setToList, setUnion, stackEmpty, stackPop, stackPush, streamCollect, streamFilter, streamFromList, streamMap, streamTake, stringAt, stringCodePoints, stringContains, stringGraphemeLength, stringGraphemes, stringEndsWith, stringIsEmpty, stringIsNotEmpty, stringJoin, stringNormalizeNfc, stringNormalizeNfd, stringNormalizeNfkc, stringNormalizeNfkd, stringLength, stringReplace, stringSlice, stringSplit, stringStartsWith, stringToLowerCase, stringToUpperCase, stringTrim, stringTrimEnd, stringTrimStart, taskFirstOkBuiltin, taskMapParallelBuiltin, taskRaceBuiltin, taskRetryBuiltin, taskSleepBuiltin, taskSuperviseBuiltin, taskTimeoutBuiltin, uint16Create, uint16ToInt, uint32Create, uint32ToInt, uint64Create, uint64ToBigInt, uint8Create, uint8ToInt, updateRecord, valid, invalid, validationAndThen, validationCollect, validationMap, validateFfiValue, viruneEquals } from '@virune/runtime/v2/index.js';"
}

fn canonicalImportLine(line: String) -> String {
	let relativeFrom = String.contains(line, " from './") || String.contains(line, " from '../")
	let relativeSideEffect = String.startsWith(line, "import './") || String.startsWith(line, "import '../")
	if (relativeFrom || relativeSideEffect) && String.endsWith(line, "';") {
		return String.replace(line, "'", "\"")
	}
	return line
}

fn emitPreamble(lines: List<String>) -> String {
	let runtimeLine = selfhostRuntimeImportLine()
	let mut result = ""
	let mut hasRuntime = false
	let mut otherCount = 0
	for line in lines {
		if line == runtimeLine {
			hasRuntime = true
		} else {
			otherCount = otherCount + 1
		}
	}
	if hasRuntime {
		result = result + productionRuntimeImportLine() + "\n\n"
	}
	for line in lines {
		if line != runtimeLine {
			result = result + canonicalImportLine(line) + "\n"
		}
	}
	if otherCount > 0 {
		result = result + "\n"
	}
	return result
}

fn emitModule(projectModule: ProjectEmitterModule) -> ProjectEmittedModule {
	let mut code = emitPreamble(projectModule.preamble)
	code = appendLines(code, projectModule.statements)
	return ProjectEmittedModule {
		sourcePath: projectModule.sourcePath,
		outputPath: projectModule.outputPath,
		code: code,
		sourceMap: projectModule.sourceMap,
	}
}

fn validateModule(
	projectModule: ProjectEmitterModule,
	seenSources: List<String>,
	seenOutputs: List<String>,
) -> List<ProjectEmitterDiagnostic> {
	let mut diagnostics: List<ProjectEmitterDiagnostic> = []
	if String.length(projectModule.sourcePath) == 0 {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4001",
			"Emitter source path must not be empty",
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	if String.length(projectModule.outputPath) == 0 {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4002",
			"Emitter output path must not be empty",
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	if containsText(seenSources, projectModule.sourcePath) {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4003",
			"Duplicate emitter source path " + projectModule.sourcePath,
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	if containsText(seenOutputs, projectModule.outputPath) {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4004",
			"Duplicate emitter output path " + projectModule.outputPath,
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	for line in projectModule.preamble {
		if !validLine(line) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4005",
				"Emitter preamble entries must contain exactly one normalized line",
				Some(projectModule.sourcePath),
				Some(projectModule.outputPath),
			))
		}
	}
	for line in projectModule.statements {
		if !validLine(line) {
			diagnostics = List.append(diagnostics, emitterDiagnostic(
				"SHP4006",
				"Emitter statement entries must contain exactly one normalized line",
				Some(projectModule.sourcePath),
				Some(projectModule.outputPath),
			))
		}
	}
	if String.contains(projectModule.sourceMap, "\r") {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4007",
			"Emitter source map must use LF line endings",
			Some(projectModule.sourcePath),
			Some(projectModule.outputPath),
		))
	}
	return diagnostics
}

pub fn emitProject(request: ProjectEmitterRequest) -> ProjectEmitterResult {
	let modules = sortModules(request.modules)
	let dependencies = sortDependencies(request.dependencies)
	let exportedSymbols = sortExports(request.exportedSymbols)
	let mut diagnostics: List<ProjectEmitterDiagnostic> = []
	let mut seenSources: List<String> = []
	let mut seenOutputs: List<String> = []
	let mut emittedModules: List<ProjectEmittedModule> = []
	let mut entryFound = false
	for projectModule in modules {
		for diagnostic in validateModule(projectModule, seenSources, seenOutputs) {
			diagnostics = List.append(diagnostics, diagnostic)
		}
		if projectModule.sourcePath == request.entryPath {
			entryFound = true
		}
		seenSources = List.append(seenSources, projectModule.sourcePath)
		seenOutputs = List.append(seenOutputs, projectModule.outputPath)
		emittedModules = List.append(emittedModules, emitModule(projectModule))
	}
	if !entryFound {
		diagnostics = List.append(diagnostics, emitterDiagnostic(
			"SHP4008",
			"Emitter entry path is not present in the module set",
			Some(request.entryPath),
			None,
		))
	}
	for diagnostic in validateMetadata(modules, dependencies, exportedSymbols) {
		diagnostics = List.append(diagnostics, diagnostic)
	}
	let accepted = List.length(diagnostics) == 0
	return ProjectEmitterResult {
		accepted: accepted,
		entryPath: request.entryPath,
		emittedModules: if accepted then emittedModules else [],
		dependencies: dependencies,
		exportedSymbols: exportedSymbols,
		diagnostics: diagnostics,
	}
}

fn decodeProjectEmitterRequest(encoded: String) -> Result<ProjectEmitterRequest, List<JsonError>> {
	let raw = Json.parse(encoded)?
	return Json.decode<ProjectEmitterRequest>(raw)
}

pub fn emitProjectJson(encoded: String) -> Result<String, List<JsonError>> {
	return Json.encode<ProjectEmitterResult>(emitProject(decodeProjectEmitterRequest(encoded)?))
}