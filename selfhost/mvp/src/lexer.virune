//! Minimal deterministic lexer for the self-host compiler MVP.

import {
	MvpDiagnostic,
	MvpPosition,
	MvpSpan,
	MvpToken,
	MvpTokenKind,
	errorDiagnostic,
	span,
} from "./model.virune"

record MvpLexResult derives Json {
	tokens: List<MvpToken>
	diagnostics: List<MvpDiagnostic>
}

fn isDigit(value: String) -> Bool {
	return value >= "0" && value <= "9"
}

fn isLetter(value: String) -> Bool {
	return (value >= "a" && value <= "z") || (value >= "A" && value <= "Z") || value == "_"
}

fn isIdentifierPart(value: String) -> Bool {
	return isLetter(value) || isDigit(value)
}

fn isHorizontalWhitespace(value: String) -> Bool {
	return value == " " || value == "\t" || value == "\r"
}

fn isWhitespace(value: String) -> Bool {
	return isHorizontalWhitespace(value) || value == "\n"
}

fn position(offset: Int, line: Int, column: Int) -> MvpPosition {
	return MvpPosition { offset: offset, line: line, column: column }
}

fn token(kind: MvpTokenKind, text: String, start: MvpPosition, end: MvpPosition) -> MvpToken {
	return MvpToken { kind: kind, text: text, span: span(start, end) }
}

fn current(chars: List<String>, index: Int) -> String? {
	return List.get(chars, index)
}

fn charAtOrEmpty(chars: List<String>, index: Int) -> String {
	return match current(chars, index) {
		Some(foundCharacter) => foundCharacter
		None => ""
	}
}

fn matchesWord(chars: List<String>, index: Int, expected: String) -> Bool {
	let expectedChars = String.codePoints(expected)
	let expectedLength = List.length(expectedChars)
	if index < 0 || index + expectedLength > List.length(chars) {
		return false
	}
	if index > 0 && isIdentifierPart(charAtOrEmpty(chars, index - 1)) {
		return false
	}
	let mut offset = 0
	while offset < expectedLength {
		if charAtOrEmpty(chars, index + offset) != charAtOrEmpty(expectedChars, offset) {
			return false
		}
		offset = offset + 1
	}
	let after = index + expectedLength
	if after < List.length(chars) && isIdentifierPart(charAtOrEmpty(chars, after)) {
		return false
	}
	return true
}

fn skipWhitespace(chars: List<String>, index: Int) -> Int {
	let mut cursor = index
	while cursor < List.length(chars) && isWhitespace(charAtOrEmpty(chars, cursor)) {
		cursor = cursor + 1
	}
	return cursor
}

fn skipString(chars: List<String>, index: Int) -> Int {
	let mut cursor = index + 1
	let mut escaped = false
	while cursor < List.length(chars) {
		let value = charAtOrEmpty(chars, cursor)
		if value == "\n" {
			return cursor
		}
		if value == "\"" && !escaped {
			return cursor + 1
		}
		if value == "\\" && !escaped {
			escaped = true
		} else {
			escaped = false
		}
		cursor = cursor + 1
	}
	return cursor
}

fn skipLineComment(chars: List<String>, index: Int) -> Int {
	let mut cursor = index + 2
	while cursor < List.length(chars) && charAtOrEmpty(chars, cursor) != "\n" {
		cursor = cursor + 1
	}
	return cursor
}

fn attributeLineEnd(chars: List<String>, index: Int) -> Int {
	let mut cursor = index
	while cursor < List.length(chars) && charAtOrEmpty(chars, cursor) != "\n" {
		cursor = cursor + 1
	}
	return cursor
}

fn isRecordDeclarationStart(chars: List<String>, index: Int) -> Bool {
	if matchesWord(chars, index, "record") {
		return true
	}
	if !matchesWord(chars, index, "pub") {
		return false
	}
	return matchesWord(chars, skipWhitespace(chars, index + 3), "record")
}

fn recordDeclarationEnd(chars: List<String>, index: Int) -> Int? {
	let mut cursor = index
	let mut depth = 0
	let mut opened = false
	while cursor < List.length(chars) {
		let value = charAtOrEmpty(chars, cursor)
		let next = charAtOrEmpty(chars, cursor + 1)
		if value == "\"" {
			cursor = skipString(chars, cursor)
			continue
		}
		if value == "/" && next == "/" {
			cursor = skipLineComment(chars, cursor)
			continue
		}
		if value == "{" {
			opened = true
			depth = depth + 1
		} else if value == "}" && opened {
			depth = depth - 1
			if depth == 0 {
				return Some(cursor + 1)
			}
		}
		cursor = cursor + 1
	}
	return None
}

/// The full frontend parser owns record and attribute AST metadata.
/// The Pure Core runtime lowerer erases balanced type-only records and
/// top-level attribute annotation lines before its function-only parser runs.
/// Newlines and offsets remain stable for downstream diagnostics.
fn lowerTypeOnlyDeclarations(source: String) -> String {
	let chars = String.codePoints(source)
	let mut result = ""
	let mut index = 0
	let mut braceDepth = 0
	while index < List.length(chars) {
		let value = charAtOrEmpty(chars, index)
		let next = charAtOrEmpty(chars, index + 1)
		if value == "\"" {
			let end = skipString(chars, index)
			while index < end {
				result = result + charAtOrEmpty(chars, index)
				index = index + 1
			}
			continue
		}
		if value == "/" && next == "/" {
			let end = skipLineComment(chars, index)
			while index < end {
				result = result + charAtOrEmpty(chars, index)
				index = index + 1
			}
			continue
		}
		if braceDepth == 0 && value == "@" {
			let annotationEnd = attributeLineEnd(chars, index)
			while index < annotationEnd {
				result = result + " "
				index = index + 1
			}
			continue
		}
		if braceDepth == 0 && isRecordDeclarationStart(chars, index) {
			let declarationEnd = recordDeclarationEnd(chars, index)
			if match declarationEnd { Some(_) => true, None => false } {
				let end = match declarationEnd { Some(declarationLimit) => declarationLimit, None => index }
				while index < end {
					let skipped = charAtOrEmpty(chars, index)
					result = result + if skipped == "\n" then "\n" else " "
					index = index + 1
				}
				continue
			}
		}
		result = result + value
		if value == "{" {
			braceDepth = braceDepth + 1
		} else if value == "}" && braceDepth > 0 {
			braceDepth = braceDepth - 1
		}
		index = index + 1
	}
	return result
}

fn isDoubleSymbol(value: String) -> Bool {
	return value == "->" || value == "<=" || value == ">=" || value == "==" || value == "!=" || value == "&&" || value == "||"
}

fn recognizedDoubleSymbol(first: String, second: String) -> String? {
	let combined = first + second
	return if isDoubleSymbol(combined) then Some(combined) else None
}

fn twoCharacterSymbol(first: String, second: String?) -> String? {
	return match second {
		Some(value) => recognizedDoubleSymbol(first, value)
		None => None
	}
}

fn isSingleSymbol(value: String) -> Bool {
	return value == "(" || value == ")" || value == "{" || value == "}" || value == "[" || value == "]" || value == ":" || value == "," || value == "." || value == "?" || value == "@" || value == "+" || value == "-" || value == "*" || value == "/" || value == "%" || value == "<" || value == ">" || value == "=" || value == "!"
}

fn lexMvp(source: String) -> MvpLexResult {
	let chars = String.codePoints(lowerTypeOnlyDeclarations(source))
	let mut index = 0
	let mut line = 1
	let mut column = 1
	let mut tokens: List<MvpToken> = []
	let mut diagnostics: List<MvpDiagnostic> = []
	while index < List.length(chars) {
		let value = match current(chars, index) {
			Some(character) => character
			None => ""
		}
		if isHorizontalWhitespace(value) {
			index = index + 1
			column = column + 1
			continue
		}
		if value == "\n" {
			let start = position(index, line, column)
			index = index + 1
			line = line + 1
			column = 1
			tokens = List.append(tokens, token(MvpTokenKind.NewLine, "\n", start, position(index, line, column)))
			continue
		}
		let next = current(chars, index + 1)
		if value == "/" && match next { Some(character) => character == "/", None => false } {
			index = index + 2
			column = column + 2
			while index < List.length(chars) && match current(chars, index) { Some(character) => character != "\n", None => false } {
				index = index + 1
				column = column + 1
			}
			continue
		}
		let start = position(index, line, column)
		if isLetter(value) {
			let mut text = ""
			while index < List.length(chars) && match current(chars, index) { Some(character) => isIdentifierPart(character), None => false } {
				let character = match current(chars, index) { Some(item) => item, None => "" }
				text = text + character
				index = index + 1
				column = column + 1
			}
			tokens = List.append(tokens, token(MvpTokenKind.Identifier, text, start, position(index, line, column)))
			continue
		}
		if isDigit(value) {
			let mut text = ""
			let mut decimalSeen = false
			while index < List.length(chars) {
				let character = match current(chars, index) { Some(item) => item, None => "" }
				if isDigit(character) {
					text = text + character
					index = index + 1
					column = column + 1
					continue
				}
				if character == "." && !decimalSeen && match current(chars, index + 1) { Some(item) => isDigit(item), None => false } {
					decimalSeen = true
					text = text + character
					index = index + 1
					column = column + 1
					continue
				}
				break
			}
			tokens = List.append(tokens, token(MvpTokenKind.Number, text, start, position(index, line, column)))
			continue
		}
		if value == "\"" {
			let mut text = "\""
			let mut escaped = false
			let mut closed = false
			index = index + 1
			column = column + 1
			while index < List.length(chars) {
				let character = match current(chars, index) { Some(item) => item, None => "" }
				if character == "\n" {
					break
				}
				text = text + character
				index = index + 1
				column = column + 1
				if character == "\"" && !escaped {
					closed = true
					break
				}
				if character == "\\" && !escaped {
					escaped = true
				} else {
					escaped = false
				}
			}
			let end = position(index, line, column)
			if closed {
				tokens = List.append(tokens, token(MvpTokenKind.StringLiteral, text, start, end))
			} else {
				diagnostics = List.append(diagnostics, errorDiagnostic("L0001", "Unterminated string literal", span(start, end)))
			}
			continue
		}
		let combined = twoCharacterSymbol(value, next)
		if match combined { Some(_) => true, None => false } {
			let text = match combined { Some(item) => item, None => "" }
			index = index + 2
			column = column + 2
			tokens = List.append(tokens, token(MvpTokenKind.Symbol, text, start, position(index, line, column)))
			continue
		}
		if isSingleSymbol(value) {
			index = index + 1
			column = column + 1
			tokens = List.append(tokens, token(MvpTokenKind.Symbol, value, start, position(index, line, column)))
			continue
		}
		index = index + 1
		column = column + 1
		diagnostics = List.append(diagnostics, errorDiagnostic("L0001", "Unexpected character " + value, span(start, position(index, line, column))))
	}
	let end = position(index, line, column)
	tokens = List.append(tokens, token(MvpTokenKind.EndOfFile, "", end, end))
	return MvpLexResult { tokens: tokens, diagnostics: diagnostics }
}

pub fn lexMvpJson(source: String) -> Result<String, List<JsonError>> {
	return Json.encode<MvpLexResult>(lexMvp(source))
}
