//! Deterministic recursive-descent parser core for the Virune 1.0 frontend.

import {
	FrontendComment,
	FrontendCommentKind,
	FrontendDiagnostic,
	FrontendLexResult,
	FrontendPosition,
	FrontendSpan,
	FrontendToken,
	FrontendTokenKind,
} from "./frontend-model.virune"
import { lexFrontendJson } from "./frontend-lexer.virune"
import {
	parseDetailedDeclarationJson,
	parseTypeReferenceJson,
} from "./frontend-declaration-parser.virune"
import { parseLambdaHeaderJson } from "./frontend-lambda-parser.virune"
import { parsePatternJson } from "./frontend-pattern-parser.virune"
import {
	FrontendAstNode,
	FrontendParseResult,
	ParserDiagnostic,
	ParserPosition,
	ParserSpan,
	frontendAstNode,
	parserDiagnostic,
	parserPosition,
	parserSpan,
} from "./frontend-parser-model.virune"

record CoreState {
	index: Int
	nodes: List<FrontendAstNode>
	diagnostics: List<ParserDiagnostic>
	commentIndex: Int
	pendingDocumentation: List<String>
	moduleDocumentation: List<String>
	significantSeen: Bool
}

record ParsedNode {
	state: CoreState
	id: Int
}

record ParsedDocumentation {
	state: CoreState
	documentation: List<String>
}

record ParsedChildren {
	state: CoreState
	children: List<Int>
}

record DetailedDeclarationTransport derives Json {
	nextIndex: Int
	nodes: List<FrontendAstNode>
	diagnostics: List<ParserDiagnostic>
	root: Int
}

record PatternTransport derives Json {
	nextIndex: Int
	nodes: List<FrontendAstNode>
	diagnostics: List<ParserDiagnostic>
	root: Int
}

record LambdaHeaderTransport derives Json {
	nextIndex: Int
	nodes: List<FrontendAstNode>
	diagnostics: List<ParserDiagnostic>
	children: List<Int>
	isAsync: Bool
}

record LoadedLambdaHeader {
	state: CoreState
	children: List<Int>
	isAsync: Bool
}

fn stateWith(
	state: CoreState,
	index: Int,
	nodes: List<FrontendAstNode>,
	diagnostics: List<ParserDiagnostic>,
	commentIndex: Int,
	pendingDocumentation: List<String>,
	moduleDocumentation: List<String>,
	significantSeen: Bool,
) -> CoreState {
	return CoreState {
		index: index,
		nodes: nodes,
		diagnostics: diagnostics,
		commentIndex: commentIndex,
		pendingDocumentation: pendingDocumentation,
		moduleDocumentation: moduleDocumentation,
		significantSeen: significantSeen,
	}
}

fn withIndex(state: CoreState, index: Int) -> CoreState {
	return stateWith(
		state,
		index,
		state.nodes,
		state.diagnostics,
		state.commentIndex,
		state.pendingDocumentation,
		state.moduleDocumentation,
		state.significantSeen,
	)
}

fn withNodes(state: CoreState, nodes: List<FrontendAstNode>) -> CoreState {
	return stateWith(
		state,
		state.index,
		nodes,
		state.diagnostics,
		state.commentIndex,
		state.pendingDocumentation,
		state.moduleDocumentation,
		state.significantSeen,
	)
}

fn withDiagnostics(state: CoreState, diagnostics: List<ParserDiagnostic>) -> CoreState {
	return stateWith(
		state,
		state.index,
		state.nodes,
		diagnostics,
		state.commentIndex,
		state.pendingDocumentation,
		state.moduleDocumentation,
		state.significantSeen,
	)
}

fn withComments(
	state: CoreState,
	commentIndex: Int,
	pendingDocumentation: List<String>,
	moduleDocumentation: List<String>,
) -> CoreState {
	return stateWith(
		state,
		state.index,
		state.nodes,
		state.diagnostics,
		commentIndex,
		pendingDocumentation,
		moduleDocumentation,
		state.significantSeen,
	)
}

fn withSignificant(state: CoreState, significantSeen: Bool) -> CoreState {
	return stateWith(
		state,
		state.index,
		state.nodes,
		state.diagnostics,
		state.commentIndex,
		state.pendingDocumentation,
		state.moduleDocumentation,
		significantSeen,
	)
}

fn fallbackPosition() -> FrontendPosition {
	return FrontendPosition { offset: 0, line: 1, column: 1 }
}

fn fallbackSpan() -> FrontendSpan {
	let value = fallbackPosition()
	return FrontendSpan { start: value, end: value }
}

fn fallbackToken() -> FrontendToken {
	return FrontendToken {
		kind: FrontendTokenKind.EndOfFile,
		text: "",
		span: fallbackSpan(),
	}
}

fn tokenAt(tokens: List<FrontendToken>, index: Int) -> FrontendToken {
	return match List.get(tokens, index) {
		Some(value) => value
		None => fallbackToken()
	}
}

fn commentAt(comments: List<FrontendComment>, index: Int) -> FrontendComment {
	return match List.get(comments, index) {
		Some(value) => value
		None => FrontendComment {
			kind: FrontendCommentKind.Ordinary,
			text: "",
			span: fallbackSpan(),
		}
	}
}

fn convertPosition(value: FrontendPosition) -> ParserPosition {
	return parserPosition(value.offset, value.line, value.column)
}

fn convertSpan(value: FrontendSpan) -> ParserSpan {
	return parserSpan(convertPosition(value.start), convertPosition(value.end))
}

fn spanBetween(tokens: List<FrontendToken>, startIndex: Int, endIndex: Int) -> ParserSpan {
	let first = tokenAt(tokens, startIndex)
	let last = if endIndex > startIndex then tokenAt(tokens, endIndex - 1) else first
	return parserSpan(convertPosition(first.span.start), convertPosition(last.span.end))
}

fn addNode(
	state: CoreState,
	tokens: List<FrontendToken>,
	kind: String,
	text: String,
	startIndex: Int,
	endIndex: Int,
	children: List<Int>,
	documentation: List<String>,
) -> ParsedNode {
	let id = List.length(state.nodes)
	let value = frontendAstNode(
		id,
		kind,
		text,
		spanBetween(tokens, startIndex, endIndex),
		children,
		documentation,
	)
	return ParsedNode {
		state: withNodes(state, List.append(state.nodes, value)),
		id: id,
	}
}

fn addDiagnosticAt(
	state: CoreState,
	tokens: List<FrontendToken>,
	code: String,
	message: String,
	index: Int,
) -> CoreState {
	let value = tokenAt(tokens, index)
	let diagnostic = parserDiagnostic(code, message, convertSpan(value.span))
	return withDiagnostics(state, List.append(state.diagnostics, diagnostic))
}

fn convertDiagnostic(value: FrontendDiagnostic) -> ParserDiagnostic {
	return ParserDiagnostic {
		code: value.code,
		severity: value.severity,
		message: value.message,
		span: convertSpan(value.span),
	}
}

fn convertDiagnostics(values: List<FrontendDiagnostic>) -> List<ParserDiagnostic> {
	let mut result: List<ParserDiagnostic> = []
	for value in values {
		result = List.append(result, convertDiagnostic(value))
	}
	return result
}

fn advance(state: CoreState) -> CoreState {
	return withIndex(state, state.index + 1)
}

fn currentText(state: CoreState, tokens: List<FrontendToken>) -> String {
	return tokenAt(tokens, state.index).text
}

fn currentKind(state: CoreState, tokens: List<FrontendToken>) -> FrontendTokenKind {
	return tokenAt(tokens, state.index).kind
}

fn atEnd(state: CoreState, tokens: List<FrontendToken>) -> Bool {
	return currentKind(state, tokens) == FrontendTokenKind.EndOfFile
}

fn isText(state: CoreState, tokens: List<FrontendToken>, text: String) -> Bool {
	return currentText(state, tokens) == text
}

fn skipNewLines(stateValue: CoreState, tokens: List<FrontendToken>) -> CoreState {
	let mut state = stateValue
	while currentKind(state, tokens) == FrontendTokenKind.NewLine {
		state = advance(state)
	}
	return state
}

fn synchronizeLine(stateValue: CoreState, tokens: List<FrontendToken>) -> CoreState {
	let mut state = stateValue
	while !atEnd(state, tokens)
		&& currentKind(state, tokens) != FrontendTokenKind.NewLine
		&& !isText(state, tokens, "}") {
		state = advance(state)
	}
	return skipNewLines(state, tokens)
}

fn consumeLineEnd(stateValue: CoreState, tokens: List<FrontendToken>, context: String) -> CoreState {
	let mut state = stateValue
	if currentKind(state, tokens) == FrontendTokenKind.NewLine {
		return skipNewLines(state, tokens)
	}
	if atEnd(state, tokens) || isText(state, tokens, "}") || isText(state, tokens, "else") {
		return state
	}
	state = addDiagnosticAt(
		state,
		tokens,
		"L0002",
		"Expected a line end after " + context,
		state.index,
	)
	return synchronizeLine(state, tokens)
}

fn ingestCommentsBefore(
	stateValue: CoreState,
	comments: List<FrontendComment>,
	line: Int,
	tokens: List<FrontendToken>,
) -> CoreState {
	let mut state = stateValue
	let mut commentIndex = state.commentIndex
	let mut pending = state.pendingDocumentation
	let mut moduleDocumentation = state.moduleDocumentation
	let mut done = false
	while commentIndex < List.length(comments) && !done {
		let value = commentAt(comments, commentIndex)
		if value.span.end.line > line {
			done = true
		} else {
			if value.kind == FrontendCommentKind.ModuleDocumentation {
				if state.significantSeen {
					state = addDiagnosticAt(
						state,
						tokens,
						"L0011",
						"Module documentation must appear at the beginning of the file",
						state.index,
					)
				} else {
					moduleDocumentation = List.append(moduleDocumentation, value.text)
				}
			} else if value.kind == FrontendCommentKind.DeclarationDocumentation {
				pending = List.append(pending, value.text)
			} else if List.length(pending) > 0 {
				state = addDiagnosticAt(
					state,
					tokens,
					"L0010",
					"Declaration documentation is not attached to a declaration",
					state.index,
				)
				pending = []
			}
			commentIndex = commentIndex + 1
		}
	}
	return withComments(state, commentIndex, pending, moduleDocumentation)
}

fn takeDocumentation(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	supported: Bool,
) -> ParsedDocumentation {
	let mut state = stateValue
	let documentation = state.pendingDocumentation
	if !supported && List.length(documentation) > 0 {
		state = addDiagnosticAt(
			state,
			tokens,
			"L0012",
			"Documentation comments cannot target this construct",
			state.index,
		)
	}
	state = withComments(state, state.commentIndex, [], state.moduleDocumentation)
	return ParsedDocumentation {
		state: state,
		documentation: if supported then documentation else [],
	}
}

fn isModifier(text: String) -> Bool {
	return text == "pub" || text == "async" || text == "unsafe"
}

fn declarationKeywordIndex(state: CoreState, tokens: List<FrontendToken>) -> Int {
	let mut index = state.index
	while isModifier(tokenAt(tokens, index).text) {
		index = index + 1
	}
	return index
}

fn declarationKind(state: CoreState, tokens: List<FrontendToken>) -> String {
	let keyword = tokenAt(tokens, declarationKeywordIndex(state, tokens)).text
	if keyword == "fn" {
		return "FunctionDeclaration"
	}
	if keyword == "record" {
		return "RecordDeclaration"
	}
	if keyword == "enum" {
		return "EnumDeclaration"
	}
	if keyword == "newtype" {
		return "NewtypeDeclaration"
	}
	if keyword == "type" {
		return "TypeAliasDeclaration"
	}
	if keyword == "extern" {
		return "ExternDeclaration"
	}
	if keyword == "test" {
		return "TestDeclaration"
	}
	if keyword == "let" || keyword == "const" {
		return "TopLevelValueDeclaration"
	}
	return ""
}

fn supportsDocumentation(kind: String) -> Bool {
	return kind == "FunctionDeclaration"
		|| kind == "RecordDeclaration"
		|| kind == "EnumDeclaration"
		|| kind == "NewtypeDeclaration"
		|| kind == "TypeAliasDeclaration"
		|| kind == "ExternDeclaration"
		|| kind == "TopLevelValueDeclaration"
}

fn binaryPrecedence(text: String) -> Int {
	if text == "|>" {
		return 1
	}
	if text == "||" {
		return 2
	}
	if text == "&&" {
		return 3
	}
	if text == "==" || text == "!=" {
		return 4
	}
	if text == "<" || text == "<=" || text == ">" || text == ">=" {
		return 5
	}
	if text == "+" || text == "-" {
		return 6
	}
	if text == "*" || text == "/" || text == "%" {
		return 7
	}
	return 0
}

fn expressionStop(state: CoreState, tokens: List<FrontendToken>, stopAtBrace: Bool) -> Bool {
	if atEnd(state, tokens) || currentKind(state, tokens) == FrontendTokenKind.NewLine {
		return true
	}
	if stopAtBrace && isText(state, tokens, "{") {
		return true
	}
	return isText(state, tokens, "}")
		|| isText(state, tokens, ")")
		|| isText(state, tokens, "]")
		|| isText(state, tokens, "then")
		|| isText(state, tokens, "else")
		|| isText(state, tokens, ",")
		|| isText(state, tokens, "=>")
}

fn consumeBalanced(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	open: String,
	close: String,
	kind: String,
) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let mut depth = 0
	let mut done = false
	while !atEnd(state, tokens) && !done {
		let text = currentText(state, tokens)
		if text == open {
			depth = depth + 1
		} else if text == close {
			depth = depth - 1
			if depth == 0 {
				state = advance(state)
				done = true
				continue
			}
		}
		state = advance(state)
	}
	if !done {
		state = addDiagnosticAt(state, tokens, "L0002", "Unterminated " + kind, start)
	}
	return addNode(state, tokens, kind, open + close, start, state.index, [], [])
}

fn loadPattern(
	state: CoreState,
	tokens: List<FrontendToken>,
) -> Result<PatternTransport, List<JsonError>> {
	let tokensEncoded = Json.encode<List<FrontendToken>>(tokens)?
	let encoded = parsePatternJson(tokensEncoded, state.index, List.length(state.nodes))?
	let raw = Json.parse(encoded)?
	return Json.decode<PatternTransport>(raw)
}

fn mergePatternValue(stateValue: CoreState, value: PatternTransport) -> ParsedNode {
	let state = CoreState {
		index: value.nextIndex,
		nodes: List.concat(stateValue.nodes, value.nodes),
		diagnostics: List.concat(stateValue.diagnostics, value.diagnostics),
		commentIndex: stateValue.commentIndex,
		pendingDocumentation: stateValue.pendingDocumentation,
		moduleDocumentation: stateValue.moduleDocumentation,
		significantSeen: stateValue.significantSeen,
	}
	return ParsedNode { state: state, id: value.root }
}

fn mergePatternFailure(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let failed = addDiagnosticAt(
		stateValue,
		tokens,
		"P9001",
		"Pattern parser transport failed",
		stateValue.index,
	)
	return ParsedNode { state: failed, id: -1 }
}

fn parsePatternNode(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	return match loadPattern(stateValue, tokens) {
		Ok(value) => mergePatternValue(stateValue, value)
		Err(_) => mergePatternFailure(stateValue, tokens)
	}
}

fn synchronizeMatchArm(stateValue: CoreState, tokens: List<FrontendToken>) -> CoreState {
	let mut state = stateValue
	while !atEnd(state, tokens)
		&& currentKind(state, tokens) != FrontendTokenKind.NewLine
		&& !isText(state, tokens, "}") {
		state = advance(state)
	}
	return skipNewLines(state, tokens)
}

fn parseMatchExpression(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = advance(stateValue)
	let target = parseExpression(state, tokens, 1, true)
	state = target.state
	let mut children: List<Int> = []
	if target.id >= 0 {
		children = List.append(children, target.id)
	}
	if isText(state, tokens, "{") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected { after a match target", state.index)
		state = synchronizeMatchArm(state, tokens)
	}
	while !atEnd(state, tokens) && !isText(state, tokens, "}") {
		let armStart = state.index
		let before = state.index
		let pattern = parsePatternNode(state, tokens)
		state = pattern.state
		let mut armChildren: List<Int> = []
		if pattern.id >= 0 {
			armChildren = List.append(armChildren, pattern.id)
		}
		if isText(state, tokens, "if") {
			let guard = parseExpression(advance(state), tokens, 1, false)
			state = guard.state
			if guard.id >= 0 {
				armChildren = List.append(armChildren, guard.id)
			}
		}
		let mut hasArrow = false
		if isText(state, tokens, "=>") {
			state = advance(state)
			hasArrow = true
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected => after a match pattern", state.index)
			state = synchronizeMatchArm(state, tokens)
		}
		if hasArrow && !atEnd(state, tokens) && !isText(state, tokens, "}") {
			let body = parseExpression(state, tokens, 1, false)
			state = body.state
			if body.id >= 0 {
				armChildren = List.append(armChildren, body.id)
			}
		}
		if isText(state, tokens, ",") {
			state = advance(state)
		}
		let arm = addNode(
			state,
			tokens,
			"MatchArm",
			"=>",
			armStart,
			state.index,
			armChildren,
			[],
		)
		state = skipNewLines(arm.state, tokens)
		children = List.append(children, arm.id)
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in a match expression", state.index)
			if !atEnd(state, tokens) {
				state = skipNewLines(advance(state), tokens)
			}
		}
	}
	if isText(state, tokens, "}") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected } to end a match expression", state.index)
	}
	return addNode(state, tokens, "MatchExpression", "match", start, state.index, children, [])
}

fn loadLambdaHeader(
	state: CoreState,
	tokens: List<FrontendToken>,
) -> Result<LambdaHeaderTransport, List<JsonError>> {
	let tokensEncoded = Json.encode<List<FrontendToken>>(tokens)?
	let encoded = parseLambdaHeaderJson(tokensEncoded, state.index, List.length(state.nodes))?
	let raw = Json.parse(encoded)?
	return Json.decode<LambdaHeaderTransport>(raw)
}

fn mergeLambdaHeaderValue(stateValue: CoreState, value: LambdaHeaderTransport) -> LoadedLambdaHeader {
	let state = CoreState {
		index: value.nextIndex,
		nodes: List.concat(stateValue.nodes, value.nodes),
		diagnostics: List.concat(stateValue.diagnostics, value.diagnostics),
		commentIndex: stateValue.commentIndex,
		pendingDocumentation: stateValue.pendingDocumentation,
		moduleDocumentation: stateValue.moduleDocumentation,
		significantSeen: stateValue.significantSeen,
	}
	return LoadedLambdaHeader { state: state, children: value.children, isAsync: value.isAsync }
}

fn mergeLambdaHeaderFailure(stateValue: CoreState, tokens: List<FrontendToken>) -> LoadedLambdaHeader {
	let failed = addDiagnosticAt(
		stateValue,
		tokens,
		"P9002",
		"Lambda header parser transport failed",
		stateValue.index,
	)
	return LoadedLambdaHeader { state: failed, children: [], isAsync: false }
}

fn parseLambdaHeaderNode(stateValue: CoreState, tokens: List<FrontendToken>) -> LoadedLambdaHeader {
	return match loadLambdaHeader(stateValue, tokens) {
		Ok(value) => mergeLambdaHeaderValue(stateValue, value)
		Err(_) => mergeLambdaHeaderFailure(stateValue, tokens)
	}
}

fn parseLambdaExpression(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let loaded = parseLambdaHeaderNode(stateValue, tokens)
	let mut state = loaded.state
	let mut children = loaded.children
	if isText(state, tokens, "=>") {
		let body = parseExpression(advance(state), tokens, 1, false)
		state = body.state
		if body.id >= 0 {
			children = List.append(children, body.id)
		}
	} else if isText(state, tokens, "{") {
		let body = parseBlock(state, tokens)
		state = body.state
		children = List.append(children, body.id)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a lambda body", state.index)
		state = synchronizeLine(state, tokens)
	}
	let text = if loaded.isAsync then "async fn" else "fn"
	return addNode(state, tokens, "LambdaExpression", text, start, state.index, children, [])
}

fn synchronizeAggregateItem(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	close: String,
) -> CoreState {
	let mut state = stateValue
	while !atEnd(state, tokens)
		&& currentKind(state, tokens) != FrontendTokenKind.NewLine
		&& !isText(state, tokens, ",")
		&& !isText(state, tokens, close) {
		state = advance(state)
	}
	return state
}

fn parseListExpression(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = skipNewLines(advance(stateValue), tokens)
	let mut children: List<Int> = []
	while !atEnd(state, tokens) && !isText(state, tokens, "]") {
		let before = state.index
		let item = parseExpression(state, tokens, 1, false)
		state = item.state
		if item.id >= 0 {
			children = List.append(children, item.id)
		}
		if isText(state, tokens, ",") {
			state = skipNewLines(advance(state), tokens)
		} else if !isText(state, tokens, "]") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or ] in a list expression", state.index)
			state = synchronizeAggregateItem(state, tokens, "]")
			if isText(state, tokens, ",") {
				state = skipNewLines(advance(state), tokens)
			}
		}
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in a list expression", state.index)
			if !atEnd(state, tokens) {
				state = advance(state)
			}
		}
	}
	if isText(state, tokens, "]") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ] to end a list expression", state.index)
	}
	return addNode(state, tokens, "ListExpression", "[]", start, state.index, children, [])
}

fn parseParenthesizedOrTupleExpression(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
) -> ParsedNode {
	let start = stateValue.index
	let mut state = skipNewLines(advance(stateValue), tokens)
	if isText(state, tokens, ")") {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an expression after (", state.index)
		state = advance(state)
		return addNode(state, tokens, "ParenthesizedExpression", "()", start, state.index, [], [])
	}
	let first = parseExpression(state, tokens, 1, false)
	state = first.state
	let mut children: List<Int> = []
	if first.id >= 0 {
		children = List.append(children, first.id)
	}
	if isText(state, tokens, ",") {
		let mut done = false
		while isText(state, tokens, ",") && !done {
			state = skipNewLines(advance(state), tokens)
			if isText(state, tokens, ")") {
				state = addDiagnosticAt(state, tokens, "L0002", "Expected a tuple expression after ,", state.index)
				done = true
			} else {
				let item = parseExpression(state, tokens, 1, false)
				state = item.state
				if item.id >= 0 {
					children = List.append(children, item.id)
				}
			}
		}
		if isText(state, tokens, ")") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected ) to end a tuple expression", state.index)
			state = synchronizeAggregateItem(state, tokens, ")")
			if isText(state, tokens, ")") {
				state = advance(state)
			}
		}
		return addNode(state, tokens, "TupleExpression", "()", start, state.index, children, [])
	}
	if isText(state, tokens, ")") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ) after a parenthesized expression", state.index)
		state = synchronizeAggregateItem(state, tokens, ")")
		if isText(state, tokens, ")") {
			state = advance(state)
		}
	}
	return addNode(state, tokens, "ParenthesizedExpression", "()", start, state.index, children, [])
}

fn parseRecordEntry(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let name = currentText(state, tokens)
	if currentKind(state, tokens) == FrontendTokenKind.Identifier {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a record entry name", state.index)
		if !atEnd(state, tokens) {
			state = advance(state)
		}
	}
	let mut children: List<Int> = []
	if isText(state, tokens, ":") {
		let value = parseExpression(advance(state), tokens, 1, false)
		state = value.state
		if value.id >= 0 {
			children = List.append(children, value.id)
		}
	}
	return addNode(state, tokens, "RecordEntry", name, start, state.index, children, [])
}

fn parseRecordFieldBlock(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	if isText(state, tokens, "{") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected { to begin record entries", state.index)
	}
	let mut children: List<Int> = []
	while !atEnd(state, tokens) && !isText(state, tokens, "}") {
		let before = state.index
		let entry = parseRecordEntry(state, tokens)
		state = entry.state
		if entry.id >= 0 {
			children = List.append(children, entry.id)
		}
		if isText(state, tokens, ",") {
			state = skipNewLines(advance(state), tokens)
		} else if !isText(state, tokens, "}") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or } after a record entry", state.index)
			state = synchronizeAggregateItem(state, tokens, "}")
			if isText(state, tokens, ",") {
				state = skipNewLines(advance(state), tokens)
			} else {
				state = skipNewLines(state, tokens)
			}
		}
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in record entries", state.index)
			if !atEnd(state, tokens) {
				state = skipNewLines(advance(state), tokens)
			}
		}
	}
	if isText(state, tokens, "}") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected } to end record entries", state.index)
	}
	return addNode(state, tokens, "RecordFieldBlock", "{}", start, state.index, children, [])
}

fn parseRecordExpression(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	name: String,
) -> ParsedNode {
	let start = stateValue.index
	let fields = parseRecordFieldBlock(advance(stateValue), tokens)
	return addNode(
		fields.state,
		tokens,
		"RecordExpression",
		name,
		start,
		fields.state.index,
		[fields.id],
		[],
	)
}

fn parseCallArguments(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = skipNewLines(advance(stateValue), tokens)
	let mut children: List<Int> = []
	while !atEnd(state, tokens) && !isText(state, tokens, ")") {
		let before = state.index
		let argument = parseExpression(state, tokens, 1, false)
		state = argument.state
		if argument.id >= 0 {
			children = List.append(children, argument.id)
		}
		if isText(state, tokens, ",") {
			state = skipNewLines(advance(state), tokens)
		} else if !isText(state, tokens, ")") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or ) in call arguments", state.index)
			state = synchronizeAggregateItem(state, tokens, ")")
			if isText(state, tokens, ",") {
				state = skipNewLines(advance(state), tokens)
			}
		}
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in call arguments", state.index)
			if !atEnd(state, tokens) {
				state = advance(state)
			}
		}
	}
	if isText(state, tokens, ")") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ) to end call arguments", state.index)
	}
	return addNode(state, tokens, "CallArguments", "()", start, state.index, children, [])
}

fn looksLikeTypeArgumentCall(state: CoreState, tokens: List<FrontendToken>) -> Bool {
	if !isText(state, tokens, "<") {
		return false
	}
	let mut index = state.index
	let mut depth = 0
	let mut done = false
	while tokenAt(tokens, index).kind != FrontendTokenKind.EndOfFile && !done {
		let text = tokenAt(tokens, index).text
		if text == "<" {
			depth = depth + 1
		} else if text == ">" {
			depth = depth - 1
			if depth == 0 {
				index = index + 1
				done = true
				continue
			}
		}
		index = index + 1
	}
	return done && tokenAt(tokens, index).text == "("
}

fn parsePostfix(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	start: Int,
	valueIdValue: Int,
) -> ParsedNode {
	let mut state = stateValue
	let mut valueId = valueIdValue
	let mut done = false
	while !done && !expressionStop(state, tokens, false) {
		if looksLikeTypeArgumentCall(state, tokens) {
			let typeArguments = consumeBalanced(state, tokens, "<", ">", "TypeArguments")
			state = typeArguments.state
			let callArguments = parseCallArguments(state, tokens)
			state = callArguments.state
			let call = addNode(
				state,
				tokens,
				"CallExpression",
				"call",
				start,
				state.index,
				[valueId, typeArguments.id, callArguments.id],
				[],
			)
			state = call.state
			valueId = call.id
		} else if isText(state, tokens, "(") {
			let callArguments = parseCallArguments(state, tokens)
			state = callArguments.state
			let call = addNode(
				state,
				tokens,
				"CallExpression",
				"call",
				start,
				state.index,
				[valueId, callArguments.id],
				[],
			)
			state = call.state
			valueId = call.id
		} else if isText(state, tokens, ".") {
			state = advance(state)
			let field = currentText(state, tokens)
			if !atEnd(state, tokens) {
				state = advance(state)
			}
			let member = addNode(
				state,
				tokens,
				"FieldExpression",
				field,
				start,
				state.index,
				[valueId],
				[],
			)
			state = member.state
			valueId = member.id
		} else if isText(state, tokens, "?") {
			state = advance(state)
			let tried = addNode(
				state,
				tokens,
				"TryExpression",
				"?",
				start,
				state.index,
				[valueId],
				[],
			)
			state = tried.state
			valueId = tried.id
		} else if isText(state, tokens, "with") {
			let fields = parseRecordFieldBlock(advance(state), tokens)
			state = fields.state
			let updated = addNode(
				state,
				tokens,
				"RecordUpdateExpression",
				"with",
				start,
				state.index,
				[valueId, fields.id],
				[],
			)
			state = updated.state
			valueId = updated.id
		} else {
			done = true
		}
	}
	return ParsedNode { state: state, id: valueId }
}

fn parseLambdaPostfix(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	start: Int,
	valueIdValue: Int,
) -> ParsedNode {
	return parsePostfix(stateValue, tokens, start, valueIdValue)
}

fn parseParenthesizedLambda(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
) -> ParsedNode {
	let start = stateValue.index
	let mut state = advance(stateValue)
	let text = currentText(state, tokens)
	if text != "fn" && !(text == "async" && tokenAt(tokens, state.index + 1).text == "fn") {
		let grouped = parseParenthesizedOrTupleExpression(stateValue, tokens)
		return parsePostfix(grouped.state, tokens, start, grouped.id)
	}
	let inner = parseLambdaExpression(state, tokens)
	state = inner.state
	if isText(state, tokens, ")") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ) after a parenthesized lambda", state.index)
	}
	let grouped = addNode(
		state,
		tokens,
		"ParenthesizedExpression",
		"()",
		start,
		state.index,
		[inner.id],
		[],
	)
	return parseLambdaPostfix(grouped.state, tokens, start, grouped.id)
}

fn parseControlPostfix(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	start: Int,
	valueIdValue: Int,
) -> ParsedNode {
	return parsePostfix(stateValue, tokens, start, valueIdValue)
}

fn parseConditionalExpression(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let condition = parseExpression(advance(stateValue), tokens, 1, false)
	let mut state = condition.state
	let mut children: List<Int> = []
	if condition.id >= 0 {
		children = List.append(children, condition.id)
	}
	if isText(state, tokens, "then") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected then in a conditional expression", state.index)
	}
	let consequent = parseExpression(state, tokens, 1, false)
	state = consequent.state
	if consequent.id >= 0 {
		children = List.append(children, consequent.id)
	}
	if isText(state, tokens, "else") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected else in a conditional expression", state.index)
	}
	let alternate = parseExpression(state, tokens, 1, false)
	state = alternate.state
	if alternate.id >= 0 {
		children = List.append(children, alternate.id)
	}
	return addNode(state, tokens, "ConditionalExpression", "if", start, state.index, children, [])
}

fn synchronizeParallelEntry(stateValue: CoreState, tokens: List<FrontendToken>) -> CoreState {
	let mut state = stateValue
	while !atEnd(state, tokens)
		&& currentKind(state, tokens) != FrontendTokenKind.NewLine
		&& !isText(state, tokens, ",")
		&& !isText(state, tokens, "}") {
		state = advance(state)
	}
	return state
}

fn parseParallelEntry(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let name = currentText(state, tokens)
	if currentKind(state, tokens) == FrontendTokenKind.Identifier {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a parallel entry name", state.index)
	}
	if isText(state, tokens, ":") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected : after a parallel entry name", state.index)
		state = synchronizeParallelEntry(state, tokens)
		return addNode(state, tokens, "ParallelEntry", name, start, state.index, [], [])
	}
	let value = parseExpression(state, tokens, 1, false)
	state = value.state
	let mut children: List<Int> = []
	if value.id >= 0 {
		children = List.append(children, value.id)
	}
	return addNode(state, tokens, "ParallelEntry", name, start, state.index, children, [])
}

fn parseParallelExpression(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = advance(stateValue)
	let mut text = "parallel"
	if isText(state, tokens, "try") {
		text = "parallel try"
		state = advance(state)
	}
	if isText(state, tokens, "{") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected { after parallel", state.index)
		state = synchronizeParallelEntry(state, tokens)
	}
	let mut children: List<Int> = []
	while !atEnd(state, tokens) && !isText(state, tokens, "}") {
		let before = state.index
		let entry = parseParallelEntry(state, tokens)
		state = entry.state
		if entry.id >= 0 {
			children = List.append(children, entry.id)
		}
		if isText(state, tokens, ",") {
			state = advance(state)
		}
		state = skipNewLines(state, tokens)
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in a parallel expression", state.index)
			if !atEnd(state, tokens) {
				state = skipNewLines(advance(state), tokens)
			}
		}
	}
	if List.length(children) == 0 {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected at least one parallel entry", state.index)
	}
	if isText(state, tokens, "}") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected } to end a parallel expression", state.index)
	}
	let expression = addNode(state, tokens, "ParallelExpression", text, start, state.index, children, [])
	return parseControlPostfix(expression.state, tokens, start, expression.id)
}

fn parsePrimary(stateValue: CoreState, tokens: List<FrontendToken>, stopAtBrace: Bool) -> ParsedNode {
	let mut state = stateValue
	let start = state.index
	if expressionStop(state, tokens, stopAtBrace) {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an expression", state.index)
		return ParsedNode { state: state, id: -1 }
	}
	let text = currentText(state, tokens)
	if text == "if" {
		return parseConditionalExpression(state, tokens)
	}
	if text == "parallel" {
		return parseParallelExpression(state, tokens)
	}
	if text == "fn" || (text == "async" && tokenAt(tokens, state.index + 1).text == "fn") {
		return parseLambdaExpression(state, tokens)
	}
	if text == "match" {
		return parseMatchExpression(state, tokens)
	}
	if text == "!" || text == "-" || text == "await" {
		state = advance(state)
		let operand = parsePrimary(state, tokens, stopAtBrace)
		return addNode(
			operand.state,
			tokens,
			"UnaryExpression",
			text,
			start,
			operand.state.index,
			[operand.id],
			[],
		)
	}
	if text == "(" {
		return parseParenthesizedLambda(state, tokens)
	}
	if text == "[" {
		let list = parseListExpression(state, tokens)
		return parsePostfix(list.state, tokens, start, list.id)
	}
	if currentKind(state, tokens) == FrontendTokenKind.Identifier
		&& tokenAt(tokens, state.index + 1).text == "{"
		&& !stopAtBrace {
		let recordValue = parseRecordExpression(state, tokens, text)
		return parsePostfix(recordValue.state, tokens, start, recordValue.id)
	}
	let kind = if currentKind(state, tokens) == FrontendTokenKind.Identifier then "IdentifierExpression" else "LiteralExpression"
	state = advance(state)
	let added = addNode(state, tokens, kind, text, start, state.index, [], [])
	return parsePostfix(added.state, tokens, start, added.id)
}

fn parseExpression(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	minimumPrecedence: Int,
	stopAtBrace: Bool,
) -> ParsedNode {
	let left = parsePrimary(stateValue, tokens, stopAtBrace)
	let mut state = left.state
	let mut leftId = left.id
	let mut done = leftId < 0
	while !done && !expressionStop(state, tokens, stopAtBrace) {
		let operator = currentText(state, tokens)
		let precedence = binaryPrecedence(operator)
		if precedence == 0 || precedence < minimumPrecedence {
			done = true
		} else {
			let start = state.index
			state = advance(state)
			let right = parseExpression(state, tokens, precedence + 1, stopAtBrace)
			state = right.state
			let binary = addNode(
				state,
				tokens,
				"BinaryExpression",
				operator,
				start,
				state.index,
				[leftId, right.id],
				[],
			)
			state = binary.state
			leftId = binary.id
		}
	}
	return ParsedNode { state: state, id: leftId }
}

fn parseBlock(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	if isText(state, tokens, "{") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected { to begin a block", state.index)
	}
	state = skipNewLines(state, tokens)
	let mut children: List<Int> = []
	while !atEnd(state, tokens) && !isText(state, tokens, "}") {
		let before = state.index
		let statement = parseStatement(state, tokens)
		state = statement.state
		if statement.id >= 0 {
			children = List.append(children, statement.id)
		}
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in a block", state.index)
			state = synchronizeLine(advance(state), tokens)
		}
		state = skipNewLines(state, tokens)
	}
	if isText(state, tokens, "}") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected } to end a block", state.index)
	}
	return addNode(state, tokens, "Block", "", start, state.index, children, [])
}

fn loadTypeReference(
	state: CoreState,
	tokens: List<FrontendToken>,
) -> Result<DetailedDeclarationTransport, List<JsonError>> {
	let tokensEncoded = Json.encode<List<FrontendToken>>(tokens)?
	let encoded = parseTypeReferenceJson(
		tokensEncoded,
		state.index,
		List.length(state.nodes),
	)?
	let raw = Json.parse(encoded)?
	return Json.decode<DetailedDeclarationTransport>(raw)
}

fn mergeTypeReference(
	stateValue: CoreState,
	value: DetailedDeclarationTransport,
) -> ParsedNode {
	let state = CoreState {
		index: value.nextIndex,
		nodes: List.concat(stateValue.nodes, value.nodes),
		diagnostics: List.concat(stateValue.diagnostics, value.diagnostics),
		commentIndex: stateValue.commentIndex,
		pendingDocumentation: stateValue.pendingDocumentation,
		moduleDocumentation: stateValue.moduleDocumentation,
		significantSeen: stateValue.significantSeen,
	}
	return ParsedNode { state: state, id: value.root }
}

fn typeReferenceFailure(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
) -> ParsedNode {
	let failed = addDiagnosticAt(
		stateValue,
		tokens,
		"P9003",
		"Type reference parser transport failed",
		stateValue.index,
	)
	return ParsedNode { state: failed, id: -1 }
}

fn parseTypeReferenceNode(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
) -> ParsedNode {
	return match loadTypeReference(stateValue, tokens) {
		Ok(value) => mergeTypeReference(stateValue, value)
		Err(_) => typeReferenceFailure(stateValue, tokens)
	}
}

fn parseStatement(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let mut state = stateValue
	let start = state.index
	let text = currentText(state, tokens)
	if text == "break" || text == "continue" {
		state = consumeLineEnd(advance(state), tokens, text)
		let kind = if text == "break" then "BreakStatement" else "ContinueStatement"
		return addNode(state, tokens, kind, text, start, state.index, [], [])
	}
	if text == "let" {
		state = advance(state)
		let mutable = isText(state, tokens, "mut")
		if mutable {
			state = advance(state)
		}
		let bindingStart = state.index
		let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
		let name = if validName then currentText(state, tokens) else ""
		if validName {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected a local binding name", state.index)
		}
		let mut bindingChildren: List<Int> = []
		if isText(state, tokens, ":") {
			let annotation = parseTypeReferenceNode(advance(state), tokens)
			state = annotation.state
			if annotation.id >= 0 {
				bindingChildren = List.append(bindingChildren, annotation.id)
			}
		}
		let bindingText = if mutable then "mut " + name else name
		let binding = addNode(
			state,
			tokens,
			"LetBinding",
			bindingText,
			bindingStart,
			state.index,
			bindingChildren,
			[],
		)
		state = binding.state
		if isText(state, tokens, "=") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected = in a let statement", state.index)
		}
		let expression = parseExpression(state, tokens, 1, false)
		state = consumeLineEnd(expression.state, tokens, "a let statement")
		let mut children: List<Int> = [binding.id]
		if expression.id >= 0 {
			children = List.append(children, expression.id)
		}
		return addNode(state, tokens, "LetStatement", "let", start, state.index, children, [])
	}
	if text == "return" || text == "discard" || text == "defer" {
		state = advance(state)
		let mut children: List<Int> = []
		let hasValue = currentKind(state, tokens) != FrontendTokenKind.NewLine
			&& !atEnd(state, tokens)
			&& !isText(state, tokens, "}")
		if hasValue {
			let expression = parseExpression(state, tokens, 1, false)
			state = expression.state
			if expression.id >= 0 {
				children = List.append(children, expression.id)
			}
		} else if text != "return" {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected an expression after " + text, state.index)
		}
		state = consumeLineEnd(state, tokens, text)
		let kind = if text == "return" then "ReturnStatement" else if text == "discard" then "DiscardStatement" else "DeferStatement"
		return addNode(state, tokens, kind, text, start, state.index, children, [])
	}
	if text == "if" {
		let condition = parseExpression(advance(state), tokens, 1, true)
		state = condition.state
		let body = parseBlock(state, tokens)
		state = body.state
		let mut children: List<Int> = []
		if condition.id >= 0 {
			children = List.append(children, condition.id)
		}
		children = List.append(children, body.id)
		if isText(state, tokens, "else") {
			state = advance(state)
			if isText(state, tokens, "if") {
				let alternative = parseStatement(state, tokens)
				state = alternative.state
				if alternative.id >= 0 {
					children = List.append(children, alternative.id)
				}
			} else {
				let alternative = parseBlock(state, tokens)
				state = alternative.state
				children = List.append(children, alternative.id)
			}
		}
		return addNode(state, tokens, "IfStatement", "if", start, state.index, children, [])
	}
	if text == "while" {
		let condition = parseExpression(advance(state), tokens, 1, true)
		state = condition.state
		let body = parseBlock(state, tokens)
		state = body.state
		let mut children: List<Int> = []
		if condition.id >= 0 {
			children = List.append(children, condition.id)
		}
		children = List.append(children, body.id)
		return addNode(state, tokens, "WhileStatement", "while", start, state.index, children, [])
	}
	if text == "for" {
		state = advance(state)
		let bindingStart = state.index
		let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
		let name = if validName then currentText(state, tokens) else ""
		if validName {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected a loop binding", state.index)
		}
		let binding = addNode(state, tokens, "ForBinding", name, bindingStart, state.index, [], [])
		state = binding.state
		if isText(state, tokens, "in") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected in in a for statement", state.index)
		}
		let iterable = parseExpression(state, tokens, 1, true)
		state = iterable.state
		let body = parseBlock(state, tokens)
		state = body.state
		let mut children: List<Int> = [binding.id]
		if iterable.id >= 0 {
			children = List.append(children, iterable.id)
		}
		children = List.append(children, body.id)
		return addNode(state, tokens, "ForStatement", "for", start, state.index, children, [])
	}
	if currentKind(state, tokens) == FrontendTokenKind.Identifier
		&& tokenAt(tokens, state.index + 1).text == "=" {
		let targetName = currentText(state, tokens)
		let target = addNode(advance(state), tokens, "AssignmentTarget", targetName, start, start + 1, [], [])
		state = target.state
		state = advance(state)
		let value = parseExpression(state, tokens, 1, false)
		state = consumeLineEnd(value.state, tokens, "an assignment statement")
		let mut children: List<Int> = [target.id]
		if value.id >= 0 {
			children = List.append(children, value.id)
		}
		return addNode(state, tokens, "AssignmentStatement", "=", start, state.index, children, [])
	}
	let expression = parseExpression(state, tokens, 1, false)
	state = consumeLineEnd(expression.state, tokens, "an expression statement")
	let mut children: List<Int> = []
	if expression.id >= 0 {
		children = List.append(children, expression.id)
	}
	return addNode(state, tokens, "ExpressionStatement", "", start, state.index, children, [])
}

fn modifierPresent(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	keywordIndex: Int,
	modifier: String,
) -> Bool {
	let mut index = stateValue.index
	let mut found = false
	while index < keywordIndex {
		if tokenAt(tokens, index).text == modifier {
			found = true
		}
		index = index + 1
	}
	return found
}

fn parseTypeParametersNode(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let mut children: List<Int> = []
	if isText(state, tokens, "<") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected < to begin type parameters", state.index)
	}
	while !atEnd(state, tokens) && !isText(state, tokens, ">") {
		let before = state.index
		let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
		let name = if validName then currentText(state, tokens) else ""
		if validName {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected a type parameter name", state.index)
			if !atEnd(state, tokens) && !isText(state, tokens, ",") && !isText(state, tokens, ">") {
				state = advance(state)
			}
		}
		let parameter = addNode(state, tokens, "TypeParameter", name, before, state.index, [], [])
		state = parameter.state
		children = List.append(children, parameter.id)
		if isText(state, tokens, ",") {
			state = advance(state)
		} else if !isText(state, tokens, ">") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or > after a type parameter", state.index)
		}
		if state.index <= before {
			state = advance(state)
		}
	}
	if isText(state, tokens, ">") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected > to end type parameters", state.index)
	}
	return addNode(state, tokens, "TypeParameters", "", start, state.index, children, [])
}

fn parseParametersNode(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let mut children: List<Int> = []
	if isText(state, tokens, "(") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ( to begin parameters", state.index)
	}
	while !atEnd(state, tokens) && !isText(state, tokens, ")") {
		let before = state.index
		let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
		let name = if validName then currentText(state, tokens) else ""
		if validName {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected a parameter name", state.index)
		}
		let optional = isText(state, tokens, "?")
		if optional {
			state = advance(state)
		}
		if isText(state, tokens, ":") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected : after a parameter name", state.index)
		}
		let typeValue = parseTypeReferenceNode(state, tokens)
		state = typeValue.state
		let mut parameterChildren: List<Int> = []
		if typeValue.id >= 0 {
			parameterChildren = List.append(parameterChildren, typeValue.id)
		}
		let parameterText = if optional then "optional " + name else name
		let parameter = addNode(state, tokens, "Parameter", parameterText, before, state.index, parameterChildren, [])
		state = parameter.state
		children = List.append(children, parameter.id)
		if isText(state, tokens, ",") {
			state = skipNewLines(advance(state), tokens)
		} else if !isText(state, tokens, ")") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or ) after a parameter", state.index)
			while !atEnd(state, tokens)
				&& !isText(state, tokens, ",")
				&& !isText(state, tokens, ")")
				&& currentKind(state, tokens) != FrontendTokenKind.NewLine {
				state = advance(state)
			}
			if isText(state, tokens, ",") {
				state = skipNewLines(advance(state), tokens)
			}
		}
		if state.index <= before {
			state = advance(state)
		}
	}
	if isText(state, tokens, ")") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ) to end parameters", state.index)
	}
	return addNode(state, tokens, "Parameters", "", start, state.index, children, [])
}

fn parseReturnTypeNode(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let typeValue = parseTypeReferenceNode(stateValue, tokens)
	let mut children: List<Int> = []
	if typeValue.id >= 0 {
		children = List.append(children, typeValue.id)
	}
	return addNode(typeValue.state, tokens, "ReturnType", "", start, typeValue.state.index, children, [])
}

fn parseUsesClauseNode(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = advance(stateValue)
	let mut children: List<Int> = []
	let mut done = false
	while !atEnd(state, tokens) && !done {
		let before = state.index
		let validEffect = currentKind(state, tokens) == FrontendTokenKind.Identifier || isText(state, tokens, "*")
		let name = if validEffect then currentText(state, tokens) else ""
		if validEffect {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected an effect name", state.index)
			done = true
		}
		if validEffect {
			let effect = addNode(state, tokens, "Effect", name, before, state.index, [], [])
			state = effect.state
			children = List.append(children, effect.id)
		}
		if isText(state, tokens, ",") {
			state = advance(state)
		} else {
			done = true
		}
	}
	return addNode(state, tokens, "UsesClause", "uses", start, state.index, children, [])
}

fn parseFunction(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	documentation: List<String>,
) -> ParsedNode {
	let start = stateValue.index
	let keywordIndex = declarationKeywordIndex(stateValue, tokens)
	let publicValue = modifierPresent(stateValue, tokens, keywordIndex, "pub")
	let asyncValue = modifierPresent(stateValue, tokens, keywordIndex, "async")
	let mut state = withIndex(stateValue, keywordIndex + 1)
	let name = currentText(state, tokens)
	if currentKind(state, tokens) == FrontendTokenKind.Identifier {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a function name", state.index)
	}
	let mut children: List<Int> = []
	if publicValue || asyncValue {
		let modifierText = if publicValue && asyncValue then "public async" else if publicValue then "public" else "async"
		let modifiers = addNode(state, tokens, "FunctionModifiers", modifierText, start, keywordIndex, [], [])
		state = modifiers.state
		children = List.append(children, modifiers.id)
	}
	if isText(state, tokens, "<") {
		let typeParameters = parseTypeParametersNode(state, tokens)
		state = typeParameters.state
		children = List.append(children, typeParameters.id)
	}
	let parameters = parseParametersNode(state, tokens)
	state = parameters.state
	children = List.append(children, parameters.id)
	if isText(state, tokens, "->") {
		let returnType = parseReturnTypeNode(advance(state), tokens)
		state = returnType.state
		children = List.append(children, returnType.id)
	}
	if isText(state, tokens, "uses") {
		let usesClause = parseUsesClauseNode(state, tokens)
		state = usesClause.state
		children = List.append(children, usesClause.id)
	}
	if isText(state, tokens, "{") {
		let body = parseBlock(state, tokens)
		state = body.state
		children = List.append(children, body.id)
	} else if isText(state, tokens, "=>") {
		let expression = parseExpression(advance(state), tokens, 1, false)
		state = consumeLineEnd(expression.state, tokens, "an expression-bodied function")
		if expression.id >= 0 {
			children = List.append(children, expression.id)
		}
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a function body", state.index)
		state = synchronizeLine(state, tokens)
	}
	return addNode(state, tokens, "FunctionDeclaration", name, start, state.index, children, documentation)
}

fn parseTestDeclaration(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
) -> ParsedNode {
	let start = stateValue.index
	let keywordIndex = declarationKeywordIndex(stateValue, tokens)
	let asyncValue = modifierPresent(stateValue, tokens, keywordIndex, "async")
	let mut state = withIndex(stateValue, keywordIndex + 1)
	let validName = currentKind(state, tokens) == FrontendTokenKind.StringLiteral
	let name = if validName then currentText(state, tokens) else ""
	if validName {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a test name string", state.index)
	}
	let mut children: List<Int> = []
	if asyncValue {
		let modifiers = addNode(state, tokens, "TestModifiers", "async", start, keywordIndex, [], [])
		state = modifiers.state
		children = List.append(children, modifiers.id)
	}
	if isText(state, tokens, "{") {
		let body = parseBlock(state, tokens)
		state = body.state
		children = List.append(children, body.id)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a test body", state.index)
		state = synchronizeLine(state, tokens)
	}
	return addNode(state, tokens, "TestDeclaration", name, start, state.index, children, [])
}

fn parseTopLevelValueDeclaration(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	documentation: List<String>,
) -> ParsedNode {
	let start = stateValue.index
	let keywordIndex = declarationKeywordIndex(stateValue, tokens)
	let publicValue = modifierPresent(stateValue, tokens, keywordIndex, "pub")
	let keyword = tokenAt(tokens, keywordIndex).text
	let mut state = withIndex(stateValue, keywordIndex + 1)
	let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
	let name = if validName then currentText(state, tokens) else ""
	if validName {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a top-level binding name", state.index)
	}
	let mut bindingChildren: List<Int> = []
	if isText(state, tokens, ":") {
		let annotation = parseTypeReferenceNode(advance(state), tokens)
		state = annotation.state
		if annotation.id >= 0 {
			bindingChildren = List.append(bindingChildren, annotation.id)
		}
	}
	let bindingText = (if publicValue then "public " else "") + keyword + " " + name
	let binding = addNode(state, tokens, "TopLevelBinding", bindingText, keywordIndex, state.index, bindingChildren, [])
	state = binding.state
	if isText(state, tokens, "=") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected = in a top-level value declaration", state.index)
	}
	let initializer = parseExpression(state, tokens, 1, false)
	state = consumeLineEnd(initializer.state, tokens, "a top-level value declaration")
	let mut children: List<Int> = [binding.id]
	if initializer.id >= 0 {
		children = List.append(children, initializer.id)
	}
	return addNode(state, tokens, "TopLevelValueDeclaration", name, start, state.index, children, documentation)
}

fn parseExternParameters(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let mut children: List<Int> = []
	if isText(state, tokens, "(") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ( to begin extern parameters", state.index)
	}
	while !atEnd(state, tokens) && !isText(state, tokens, ")") {
		let before = state.index
		let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
		let name = if validName then currentText(state, tokens) else ""
		if validName {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected an extern parameter name", state.index)
		}
		let optional = isText(state, tokens, "?")
		if optional {
			state = advance(state)
		}
		if isText(state, tokens, ":") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected : after an extern parameter name", state.index)
		}
		let typeValue = parseTypeReferenceNode(state, tokens)
		state = typeValue.state
		let mut parameterChildren: List<Int> = []
		if typeValue.id >= 0 {
			parameterChildren = List.append(parameterChildren, typeValue.id)
		}
		let parameterText = if optional then "optional " + name else name
		let parameter = addNode(
			state,
			tokens,
			"ExternParameter",
			parameterText,
			before,
			state.index,
			parameterChildren,
			[],
		)
		state = parameter.state
		children = List.append(children, parameter.id)
		if isText(state, tokens, ",") {
			state = skipNewLines(advance(state), tokens)
		} else if !isText(state, tokens, ")") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or ) after an extern parameter", state.index)
			while !atEnd(state, tokens)
				&& currentKind(state, tokens) != FrontendTokenKind.NewLine
				&& !isText(state, tokens, ",")
				&& !isText(state, tokens, ")") {
				state = advance(state)
			}
			if isText(state, tokens, ",") {
				state = skipNewLines(advance(state), tokens)
			}
		}
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in extern parameters", state.index)
			if !atEnd(state, tokens) {
				state = advance(state)
			}
		}
	}
	if isText(state, tokens, ")") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected ) to end extern parameters", state.index)
	}
	return addNode(state, tokens, "ExternParameters", "", start, state.index, children, [])
}

fn parseExternFunction(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let asyncValue = isText(state, tokens, "async")
	if asyncValue {
		state = advance(state)
	}
	if isText(state, tokens, "fn") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected fn in an extern declaration", state.index)
	}
	let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
	let name = if validName then currentText(state, tokens) else ""
	if validName {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an extern function name", state.index)
	}
	let mut children: List<Int> = []
	if asyncValue {
		let modifiers = addNode(state, tokens, "ExternFunctionModifiers", "async", start, state.index, [], [])
		state = modifiers.state
		children = List.append(children, modifiers.id)
	}
	let parameters = parseExternParameters(state, tokens)
	state = parameters.state
	children = List.append(children, parameters.id)
	if isText(state, tokens, "->") {
		let returnType = parseReturnTypeNode(advance(state), tokens)
		state = returnType.state
		children = List.append(children, returnType.id)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected -> in an extern function", state.index)
	}
	if isText(state, tokens, "uses") {
		let usesClause = parseUsesClauseNode(state, tokens)
		state = usesClause.state
		children = List.append(children, usesClause.id)
	}
	if isText(state, tokens, "=") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected = before an extern binding", state.index)
	}
	let bindingStart = state.index
	let validBinding = currentKind(state, tokens) == FrontendTokenKind.StringLiteral
	let bindingText = if validBinding then currentText(state, tokens) else ""
	if validBinding {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a JavaScript binding string", state.index)
	}
	let binding = addNode(state, tokens, "ExternBinding", bindingText, bindingStart, state.index, [], [])
	state = binding.state
	children = List.append(children, binding.id)
	let nextMemberBoundary = !validBinding
		&& (isText(state, tokens, "fn") || isText(state, tokens, "async"))
		&& tokenAt(tokens, state.index).span.start.line > tokenAt(tokens, start).span.start.line
	if !nextMemberBoundary {
		state = consumeLineEnd(state, tokens, "an extern function")
	}
	return addNode(state, tokens, "ExternFunction", name, start, state.index, children, [])
}

fn parseExternDeclaration(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	documentation: List<String>,
) -> ParsedNode {
	let start = stateValue.index
	let keywordIndex = declarationKeywordIndex(stateValue, tokens)
	let unsafeValue = modifierPresent(stateValue, tokens, keywordIndex, "unsafe")
	let mut state = withIndex(stateValue, keywordIndex + 1)
	let mut children: List<Int> = []
	if unsafeValue {
		let modifiers = addNode(state, tokens, "ExternModifiers", "unsafe", start, keywordIndex, [], [])
		state = modifiers.state
		children = List.append(children, modifiers.id)
	}
	if isText(state, tokens, "js") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected js after extern", state.index)
	}
	let sourceStart = state.index
	let validSource = currentKind(state, tokens) == FrontendTokenKind.StringLiteral
	let sourceText = if validSource then currentText(state, tokens) else ""
	if validSource {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an extern module source string", state.index)
	}
	let sourceNode = addNode(state, tokens, "ExternSource", sourceText, sourceStart, state.index, [], [])
	state = sourceNode.state
	children = List.append(children, sourceNode.id)
	if isText(state, tokens, "{") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected { to begin an extern declaration", state.index)
		state = synchronizeLine(state, tokens)
	}
	while !atEnd(state, tokens) && !isText(state, tokens, "}") {
		state = skipNewLines(state, tokens)
		if !atEnd(state, tokens) && !isText(state, tokens, "}") {
			let before = state.index
			if isText(state, tokens, "fn") || isText(state, tokens, "async") {
				let member = parseExternFunction(state, tokens)
				state = member.state
				children = List.append(children, member.id)
			} else {
				state = addDiagnosticAt(state, tokens, "L0002", "Expected an extern function", state.index)
				state = synchronizeLine(state, tokens)
			}
			if state.index <= before {
				state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in an extern declaration", state.index)
				if !atEnd(state, tokens) {
					state = advance(state)
				}
			}
		}
	}
	if isText(state, tokens, "}") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected } to end an extern declaration", state.index)
	}
	return addNode(state, tokens, "ExternDeclaration", sourceText, start, state.index, children, documentation)
}

fn parseComposite(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	kind: String,
	documentation: List<String>,
) -> ParsedNode {
	let start = stateValue.index
	let keywordIndex = declarationKeywordIndex(stateValue, tokens)
	let mut state = withIndex(stateValue, keywordIndex + 1)
	let name = currentText(state, tokens)
	if currentKind(state, tokens) == FrontendTokenKind.Identifier {
		state = advance(state)
	}
	while !atEnd(state, tokens)
		&& currentKind(state, tokens) != FrontendTokenKind.NewLine
		&& !isText(state, tokens, "{") {
		state = advance(state)
	}
	let mut children: List<Int> = []
	if isText(state, tokens, "{") {
		let body = consumeBalanced(state, tokens, "{", "}", kind + "Body")
		state = body.state
		children = List.append(children, body.id)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected a declaration body", state.index)
		state = synchronizeLine(state, tokens)
	}
	return addNode(state, tokens, kind, name, start, state.index, children, documentation)
}

fn parseLineDeclaration(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	kind: String,
	documentation: List<String>,
) -> ParsedNode {
	let start = stateValue.index
	let keywordIndex = declarationKeywordIndex(stateValue, tokens)
	let mut state = withIndex(stateValue, keywordIndex + 1)
	let name = currentText(state, tokens)
	state = synchronizeLine(state, tokens)
	return addNode(state, tokens, kind, name, start, state.index, [], documentation)
}

fn loadDetailedDeclaration(
	state: CoreState,
	tokens: List<FrontendToken>,
	kind: String,
	documentation: List<String>,
) -> Result<DetailedDeclarationTransport, List<JsonError>> {
	let tokensEncoded = Json.encode<List<FrontendToken>>(tokens)?
	let documentationEncoded = Json.encode<List<String>>(documentation)?
	let encoded = parseDetailedDeclarationJson(
		tokensEncoded,
		state.index,
		List.length(state.nodes),
		kind,
		documentationEncoded,
	)?
	let raw = Json.parse(encoded)?
	return Json.decode<DetailedDeclarationTransport>(raw)
}

fn mergeDetailedDeclaration(
	stateValue: CoreState,
	value: DetailedDeclarationTransport,
) -> ParsedNode {
	let state = CoreState {
		index: value.nextIndex,
		nodes: List.concat(stateValue.nodes, value.nodes),
		diagnostics: List.concat(stateValue.diagnostics, value.diagnostics),
		commentIndex: stateValue.commentIndex,
		pendingDocumentation: stateValue.pendingDocumentation,
		moduleDocumentation: stateValue.moduleDocumentation,
		significantSeen: stateValue.significantSeen,
	}
	return ParsedNode { state: state, id: value.root }
}

fn detailedDeclarationFailure(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
) -> ParsedNode {
	let failed = addDiagnosticAt(
		stateValue,
		tokens,
		"P9000",
		"Detailed declaration parser transport failed",
		stateValue.index,
	)
	return ParsedNode { state: synchronizeLine(failed, tokens), id: -1 }
}

fn parseDetailedDeclaration(
	stateValue: CoreState,
	tokens: List<FrontendToken>,
	kind: String,
	documentation: List<String>,
) -> ParsedNode {
	return match loadDetailedDeclaration(stateValue, tokens, kind, documentation) {
		Ok(value) => mergeDetailedDeclaration(stateValue, value)
		Err(_) => detailedDeclarationFailure(stateValue, tokens)
	}
}

fn prependNodeChildren(
	stateValue: CoreState,
	id: Int,
	prefix: List<Int>,
) -> CoreState {
	if id < 0 || List.length(prefix) == 0 {
		return stateValue
	}
	let mut nodes: List<FrontendAstNode> = []
	for value in stateValue.nodes {
		if value.id == id {
			let updated = frontendAstNode(
				value.id,
				value.kind,
				value.text,
				value.span,
				List.concat(prefix, value.children),
				value.documentation,
			)
			nodes = List.append(nodes, updated)
		} else {
			nodes = List.append(nodes, value)
		}
	}
	return withNodes(stateValue, nodes)
}

fn parseAttribute(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = advance(stateValue)
	let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
	let name = if validName then currentText(state, tokens) else ""
	if validName {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an attribute name", state.index)
	}
	let mut children: List<Int> = []
	if isText(state, tokens, "(") {
		let argumentsValue = parseCallArguments(state, tokens)
		state = argumentsValue.state
		children = List.append(children, argumentsValue.id)
	}
	state = skipNewLines(state, tokens)
	return addNode(state, tokens, "Attribute", name, start, state.index, children, [])
}

fn parseImportItem(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
	let name = if validName then currentText(state, tokens) else ""
	if validName {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an import item name", state.index)
		if !atEnd(state, tokens) && !isText(state, tokens, "}") && !isText(state, tokens, ",") {
			state = advance(state)
		}
	}
	let mut text = name
	if isText(state, tokens, "as") {
		state = advance(state)
		if currentKind(state, tokens) == FrontendTokenKind.Identifier {
			text = name + " as " + currentText(state, tokens)
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected an import alias after as", state.index)
		}
	}
	return addNode(state, tokens, "ImportItem", text, start, state.index, [], [])
}

fn parseNamedImportItems(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedChildren {
	let mut state = stateValue
	let mut children: List<Int> = []
	if isText(state, tokens, "{") {
		state = skipNewLines(advance(state), tokens)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected { to begin import items", state.index)
		return ParsedChildren { state: synchronizeLine(state, tokens), children: children }
	}
	while !atEnd(state, tokens) && !isText(state, tokens, "}") {
		let before = state.index
		let item = parseImportItem(state, tokens)
		state = item.state
		if item.id >= 0 {
			children = List.append(children, item.id)
		}
		if isText(state, tokens, ",") {
			state = skipNewLines(advance(state), tokens)
		} else if !isText(state, tokens, "}") {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected , or } after an import item", state.index)
			while !atEnd(state, tokens)
				&& currentKind(state, tokens) != FrontendTokenKind.NewLine
				&& !isText(state, tokens, ",")
				&& !isText(state, tokens, "}") {
				state = advance(state)
			}
			if isText(state, tokens, ",") {
				state = skipNewLines(advance(state), tokens)
			}
		}
		if state.index <= before {
			state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress in import items", state.index)
			if !atEnd(state, tokens) {
				state = advance(state)
			}
		}
	}
	if isText(state, tokens, "}") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected } to end import items", state.index)
	}
	return ParsedChildren { state: state, children: children }
}

fn parseImportSource(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let validSource = currentKind(state, tokens) == FrontendTokenKind.StringLiteral
	let text = if validSource then currentText(state, tokens) else ""
	if validSource {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected an import source string", state.index)
	}
	return addNode(state, tokens, "ImportSource", text, start, state.index, [], [])
}

fn parseDetailedImport(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let start = stateValue.index
	let mut state = stateValue
	let publicImport = isText(state, tokens, "pub")
	if publicImport {
		state = advance(state)
	}
	if isText(state, tokens, "import") {
		state = advance(state)
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected import", state.index)
	}
	let javascript = isText(state, tokens, "js")
	if javascript {
		state = advance(state)
	}
	let typeOnly = isText(state, tokens, "type")
	if typeOnly {
		state = advance(state)
	}
	let mut children: List<Int> = []
	let mut form = if javascript then "javascript side-effect" else "virune"
	let mut sourceAlreadyParsed = false
	if isText(state, tokens, "{") {
		let items = parseNamedImportItems(state, tokens)
		state = items.state
		children = items.children
		form = if javascript then "javascript named" else "virune"
		if isText(state, tokens, "from") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected from after import items", state.index)
		}
	} else if javascript && isText(state, tokens, "*") {
		let itemStart = state.index
		state = advance(state)
		if isText(state, tokens, "as") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected as in a namespace import", state.index)
		}
		let validName = currentKind(state, tokens) == FrontendTokenKind.Identifier
		let name = if validName then currentText(state, tokens) else ""
		if validName {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected a namespace import name", state.index)
		}
		let item = addNode(state, tokens, "ImportItem", "* as " + name, itemStart, state.index, [], [])
		state = item.state
		children = List.append(children, item.id)
		form = "javascript namespace"
		if isText(state, tokens, "from") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected from after a namespace import", state.index)
		}
	} else if javascript && currentKind(state, tokens) == FrontendTokenKind.Identifier {
		let itemStart = state.index
		let name = currentText(state, tokens)
		state = advance(state)
		let item = addNode(state, tokens, "ImportItem", "default as " + name, itemStart, state.index, [], [])
		state = item.state
		children = List.append(children, item.id)
		form = "javascript default"
		if isText(state, tokens, "from") {
			state = advance(state)
		} else {
			state = addDiagnosticAt(state, tokens, "L0002", "Expected from after a default import", state.index)
		}
	} else if javascript && currentKind(state, tokens) == FrontendTokenKind.StringLiteral {
		let sourceNode = parseImportSource(state, tokens)
		state = sourceNode.state
		children = List.append(children, sourceNode.id)
		form = "javascript side-effect"
		sourceAlreadyParsed = true
	} else {
		state = addDiagnosticAt(state, tokens, "L0002", "Expected import items or a JavaScript import binding", state.index)
	}
	if !sourceAlreadyParsed {
		let sourceNode = parseImportSource(state, tokens)
		state = sourceNode.state
		children = List.append(children, sourceNode.id)
	}
	state = consumeLineEnd(state, tokens, "an import declaration")
	let visibility = if publicImport then " public" else ""
	let typeText = if typeOnly then " type" else ""
	return addNode(state, tokens, "ImportDeclaration", form + visibility + typeText, start, state.index, children, [])
}

fn parseDeclaration(stateValue: CoreState, tokens: List<FrontendToken>) -> ParsedNode {
	let kind = declarationKind(stateValue, tokens)
	let docs = takeDocumentation(stateValue, tokens, supportsDocumentation(kind))
	let state = withSignificant(docs.state, true)
	if kind == "FunctionDeclaration" {
		return parseFunction(state, tokens, docs.documentation)
	}
	if kind == "RecordDeclaration"
		|| kind == "EnumDeclaration"
		|| kind == "NewtypeDeclaration"
		|| kind == "TypeAliasDeclaration" {
		return parseDetailedDeclaration(state, tokens, kind, docs.documentation)
	}
	if kind == "ExternDeclaration" {
		return parseExternDeclaration(state, tokens, docs.documentation)
	}
	if kind == "TopLevelValueDeclaration" {
		return parseTopLevelValueDeclaration(state, tokens, docs.documentation)
	}
	if kind == "TestDeclaration" {
		return parseTestDeclaration(state, tokens)
	}
	let failed = addDiagnosticAt(state, tokens, "L0002", "Expected a declaration", state.index)
	return ParsedNode { state: synchronizeLine(failed, tokens), id: -1 }
}

fn parseModule(lexed: FrontendLexResult) -> FrontendParseResult {
	let tokens = lexed.tokens
	let comments = lexed.comments
	let mut state = CoreState {
		index: 0,
		nodes: [],
		diagnostics: convertDiagnostics(lexed.diagnostics),
		commentIndex: 0,
		pendingDocumentation: [],
		moduleDocumentation: [],
		significantSeen: false,
	}
	let mut children: List<Int> = []
	state = skipNewLines(state, tokens)
	if !atEnd(state, tokens) {
		state = ingestCommentsBefore(
			state,
			comments,
			tokenAt(tokens, state.index).span.start.line,
			tokens,
		)
	}
	if isText(state, tokens, "unsafe") && tokenAt(tokens, state.index + 1).text == "module" {
		let start = state.index
		let docs = takeDocumentation(state, tokens, false)
		state = withSignificant(docs.state, true)
		state = consumeLineEnd(withIndex(state, state.index + 2), tokens, "unsafe module")
		let directive = addNode(state, tokens, "UnsafeModule", "unsafe module", start, state.index, [], [])
		state = directive.state
		children = List.append(children, directive.id)
	}
	let mut done = false
	while !atEnd(state, tokens) && !done {
		state = skipNewLines(state, tokens)
		if atEnd(state, tokens) {
			done = true
		} else {
			state = ingestCommentsBefore(
				state,
				comments,
				tokenAt(tokens, state.index).span.start.line,
				tokens,
			)
			let before = state.index
			let mut attributeIds: List<Int> = []
			while isText(state, tokens, "@") {
				let attribute = parseAttribute(state, tokens)
				state = attribute.state
				if attribute.id >= 0 {
					attributeIds = List.append(attributeIds, attribute.id)
				}
			}
			if isText(state, tokens, "import")
				|| (isText(state, tokens, "pub") && tokenAt(tokens, state.index + 1).text == "import") {
				if List.length(attributeIds) > 0 {
					state = addDiagnosticAt(state, tokens, "L0002", "Attributes cannot target an import declaration", state.index)
				}
				let docs = takeDocumentation(state, tokens, false)
				state = withSignificant(docs.state, true)
				let imported = parseDetailedImport(state, tokens)
				state = imported.state
				if imported.id >= 0 {
					children = List.append(children, imported.id)
				}
			} else {
				let declaration = parseDeclaration(state, tokens)
				state = prependNodeChildren(declaration.state, declaration.id, attributeIds)
				if declaration.id >= 0 {
					children = List.append(children, declaration.id)
				}
			}
			if state.index <= before {
				state = addDiagnosticAt(state, tokens, "L0002", "Parser made no progress at module scope", state.index)
				state = synchronizeLine(advance(state), tokens)
			}
		}
	}
	state = ingestCommentsBefore(state, comments, 2147483647, tokens)
	if List.length(state.pendingDocumentation) > 0 {
		state = addDiagnosticAt(
			state,
			tokens,
			"L0010",
			"Declaration documentation is not attached to a declaration",
			state.index,
		)
		state = withComments(state, state.commentIndex, [], state.moduleDocumentation)
	}
	let root = addNode(
		state,
		tokens,
		"Module",
		"",
		0,
		state.index + 1,
		children,
		state.moduleDocumentation,
	)
	state = root.state
	let mut accepted = true
	for diagnostic in state.diagnostics {
		if diagnostic.severity == "error" {
			accepted = false
		}
	}
	return FrontendParseResult {
		accepted: accepted,
		root: root.id,
		nodes: state.nodes,
		diagnostics: state.diagnostics,
	}
}

fn decodeFrontend(source: String) -> Result<FrontendLexResult, List<JsonError>> {
	let encoded = lexFrontendJson(source)?
	let raw = Json.parse(encoded)?
	return Json.decode<FrontendLexResult>(raw)
}

@jsExport
pub fn parseFrontendCore(source: String) -> Result<String, List<JsonError>> {
	let lexed = decodeFrontend(source)?
	return Json.encode<FrontendParseResult>(parseModule(lexed))
}
