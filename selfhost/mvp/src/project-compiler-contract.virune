//! Versioned fail-closed project compiler boundary.
//!
//! This module composes the Virune-authored frontend parser, project linker,
//! project semantic context, minimal lowering pipeline, and deterministic
//! project emitter. The current lowering accepts the established Pure Core MVP
//! subset. The canonical 31-module source set now passes full-language lowering and deterministic emission.

import { checkMvpProjectJson } from "./checker.virune"
import { emitMvpJson } from "./emitter.virune"
import { parseFrontendCore } from "./frontend-parser-core.virune"
import {
	FrontendAstNode,
	FrontendParseResult,
	ParserDiagnostic,
	ParserPosition,
	ParserSpan,
	parserPosition,
	parserSpan,
} from "./frontend-parser-model.virune"
import { checkFrontendDataTypesJson } from "./frontend-semantic.virune"
import {
	FrontendSemanticResult,
	SemanticDeclaration,
	SemanticMember,
	SemanticType,
} from "./frontend-semantic-model.virune"
import { lexMvpJson } from "./lexer.virune"
import {
	MvpCompilation,
	MvpDiagnostic,
	MvpExport,
	MvpExpression,
	MvpFunction,
	MvpHirExpression,
	MvpHirFunction,
	MvpHirModule,
	MvpImport,
	MvpImportBinding,
	MvpModule,
	MvpParameter,
	MvpSpan,
	MvpStatement,
	MvpType,
	listType,
	optionalType,
} from "./model.virune"
import { parseMvpJson } from "./parser.virune"
import {
	ProjectEmitterDependency,
	ProjectEmitterExport,
	ProjectEmitterModule,
	ProjectEmitterRequest,
