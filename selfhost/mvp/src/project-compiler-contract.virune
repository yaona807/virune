	ProjectSemanticResult,
	ProjectSemanticSymbol,
	checkProjectSemantics,
} from "./project-semantic.virune"

record ProjectCompilerCapabilityV1 derives Eq, Debug, Json {
	contractVersion: String
	ready: Bool
	requestSchema: String
	resultSchema: String
	blockers: List<String>
}

record ProjectCompilerSourceV1 derives Eq, Debug, Json {
	path: String
	text: String
}

record ProjectCompilerEmitV1 derives Eq, Debug, Json {
	target: String
	sourceMap: Bool
	sourcesContent: Bool
}

record ProjectCompilerRequestV1 derives Eq, Debug, Json {
	contractVersion: String
	languageVersion: String
	platform: String
	entryPath: String
	sources: List<ProjectCompilerSourceV1>
	emit: ProjectCompilerEmitV1
}

record ProjectCompilerDiagnosticV1 derives Eq, Debug, Json {
	code: String
	severity: String
	message: String
	sourcePath: String?
	span: ParserSpan
	notes: List<String>
}

record ProjectCompilerEmittedModuleV1 derives Eq, Debug, Json {
	sourcePath: String
	outputPath: String
	code: String
	sourceMap: String
}

record ProjectCompilerDependencyV1 derives Eq, Debug, Json {
	modulePath: String
	sourceKind: String
	specifier: String
	resolvedPath: String?
	typeOnly: Bool
	public: Bool
}

record ProjectCompilerExportedSymbolV1 derives Eq, Debug, Json {
	modulePath: String
	name: String
	declarationKind: String
}

record ProjectCompilerStatsV1 derives Eq, Debug, Json {
	parsedModules: Int
	reusedParsedModules: Int
	checkedModules: Int
	reusedCheckedModules: Int
	emittedModules: Int
	reusedEmittedModules: Int
	invalidatedModules: Int
}

record ProjectCompilerResultV1 derives Eq, Debug, Json {
	contractVersion: String
	languageVersion: String
	platform: String
	entryPath: String
	accepted: Bool
	diagnostics: List<ProjectCompilerDiagnosticV1>
	emittedModules: List<ProjectCompilerEmittedModuleV1>
	dependencies: List<ProjectCompilerDependencyV1>
	exportedSymbols: List<ProjectCompilerExportedSymbolV1>
	stats: ProjectCompilerStatsV1
}

record ProjectLinkModulePayload derives Json {
	path: String
	source: String
	parse: FrontendParseResult
}

record ProjectLinkRequestPayload derives Json {
	entryPath: String
	modules: List<ProjectLinkModulePayload>
}

record ProjectParseSummary {
	diagnostics: List<ProjectCompilerDiagnosticV1>
	modules: List<ProjectLinkModulePayload>
	parsedModules: Int
}

record ProjectLoweringSummary {
	diagnostics: List<ProjectCompilerDiagnosticV1>
	modules: List<ProjectEmitterModule>
	checkedModules: Int
}

record ProjectRuntimeSummary {
	diagnostics: List<ProjectCompilerDiagnosticV1>
	lines: List<String>
}

record MvpParseTransport derives Json {
	parsedModule: MvpModule?
	diagnostics: List<MvpDiagnostic>
}

record MvpCheckTransport derives Json {
	hirModule: MvpHirModule?
	diagnostics: List<MvpDiagnostic>
	exports: List<MvpExport>
}

record ParsedMvpProjectSource {
	path: String
	parsedEncoded: String
	moduleValue: MvpModule
}

record ProjectExternalSignature derives Json {
	name: String
	parameters: List<MvpType>
	returnType: MvpType
	span: MvpSpan
}

fn emptyTextList() -> List<String> {
	let values: List<String> = []
	return values
}

fn emptyCompilerDiagnostics() -> List<ProjectCompilerDiagnosticV1> {
	let values: List<ProjectCompilerDiagnosticV1> = []
	return values
}

fn emptyCompilerModules() -> List<ProjectCompilerEmittedModuleV1> {
	let values: List<ProjectCompilerEmittedModuleV1> = []
	return values
}

fn emptyCompilerDependencies() -> List<ProjectCompilerDependencyV1> {
	let values: List<ProjectCompilerDependencyV1> = []
	return values
}

fn emptyCompilerExports() -> List<ProjectCompilerExportedSymbolV1> {
	let values: List<ProjectCompilerExportedSymbolV1> = []
	return values
}

fn emptySemanticReferences() -> List<ProjectSemanticReference> {
	let values: List<ProjectSemanticReference> = []
	return values
}

fn emptyExternalSignatures() -> List<ProjectExternalSignature> {
	let values: List<ProjectExternalSignature> = []
	return values
}

fn fallbackPosition() -> ParserPosition {
	return parserPosition(0, 1, 1)
}

fn fallbackSpan() -> ParserSpan {
	let position = fallbackPosition()
	return parserSpan(position, position)
}

fn diagnostic(code: String, message: String) -> ProjectCompilerDiagnosticV1 {
	return ProjectCompilerDiagnosticV1 {
		code: code,
		severity: "error",
		message: message,
		sourcePath: None,
		span: fallbackSpan(),
		notes: emptyTextList(),
	}
}

fn loweringDiagnostic(path: String, code: String, message: String) -> ProjectCompilerDiagnosticV1 {
	return ProjectCompilerDiagnosticV1 {
		code: code,
		severity: "error",
		message: message,
		sourcePath: Some(path),
		span: fallbackSpan(),
		notes: emptyTextList(),
	}
}

fn sourceDiagnostic(path: String, value: ParserDiagnostic) -> ProjectCompilerDiagnosticV1 {
	return ProjectCompilerDiagnosticV1 {
		code: value.code,
		severity: "error",
		message: value.message,
		sourcePath: Some(path),
		span: value.span,
		notes: emptyTextList(),
	}
}

fn mvpDiagnostic(path: String, value: MvpDiagnostic) -> ProjectCompilerDiagnosticV1 {
	return ProjectCompilerDiagnosticV1 {
		code: value.code,
		severity: "error",
		message: value.message,
		sourcePath: Some(path),
		span: ParserSpan {
			start: ParserPosition {
				offset: value.span.start.offset,
				line: value.span.start.line,
				column: value.span.start.column,
			},
			end: ParserPosition {
				offset: value.span.end.offset,
				line: value.span.end.line,
				column: value.span.end.column,
			},
		},
		notes: emptyTextList(),
	}
}

fn linkDiagnostic(value: ProjectLinkDiagnostic) -> ProjectCompilerDiagnosticV1 {
	return ProjectCompilerDiagnosticV1 {
		code: value.code,
		severity: "error",
		message: value.message,
		sourcePath: value.modulePath,
		span: fallbackSpan(),
		notes: emptyTextList(),
	}
}

fn semanticDiagnostic(value: ProjectSemanticDiagnostic) -> ProjectCompilerDiagnosticV1 {
	return ProjectCompilerDiagnosticV1 {
		code: value.code,
		severity: "error",
		message: value.message,
		sourcePath: Some(value.modulePath),
		span: fallbackSpan(),
		notes: emptyTextList(),
	}
}

fn stats(parsedModules: Int, checkedModules: Int, emittedModules: Int) -> ProjectCompilerStatsV1 {
	return ProjectCompilerStatsV1 {
		parsedModules: parsedModules,
		reusedParsedModules: 0,
		checkedModules: checkedModules,
		reusedCheckedModules: 0,
		emittedModules: emittedModules,
		reusedEmittedModules: 0,
		invalidatedModules: 0,
	}
}

fn containsPath(values: List<String>, value: String) -> Bool {
	for item in values {
		if item == value {
			return true
		}
	}
	return false
}

fn containsInt(values: List<Int>, value: Int) -> Bool {
	for item in values {
		if item == value {
			return true
		}
	}
	return false
}

fn validateRequest(request: ProjectCompilerRequestV1) -> List<ProjectCompilerDiagnosticV1> {
	let mut diagnostics: List<ProjectCompilerDiagnosticV1> = []
	if request.contractVersion != "1" {
		diagnostics = List.append(diagnostics, diagnostic("SHP1001", "Unsupported project compiler contract version"))
	}
	if request.languageVersion != "1.0" {
		diagnostics = List.append(diagnostics, diagnostic("SHP1002", "Unsupported language version"))
	}
	if request.platform != "node" {
		diagnostics = List.append(diagnostics, diagnostic("SHP1003", "Project compiler currently requires the node platform"))
	}
	if String.length(request.entryPath) == 0 {
		diagnostics = List.append(diagnostics, diagnostic("SHP1004", "Project entry path cannot be empty"))
	}
	if List.isEmpty(request.sources) {
		diagnostics = List.append(diagnostics, diagnostic("SHP1005", "Project compiler requires at least one source"))
	}
	let mut paths: List<String> = []
	let mut entryFound = false
	let mut previousPath = ""
	let mut hasPreviousPath = false
	let mut orderingDiagnosticAdded = false
	for source in request.sources {
		if String.length(source.path) == 0 {
			diagnostics = List.append(diagnostics, diagnostic("SHP1006", "Source path cannot be empty"))
		}
		if containsPath(paths, source.path) {
			diagnostics = List.append(diagnostics, diagnostic("SHP1007", "Duplicate source path " + source.path))
		} else {
			paths = List.append(paths, source.path)
		}
		if hasPreviousPath && source.path < previousPath && !orderingDiagnosticAdded {
			diagnostics = List.append(diagnostics, diagnostic("SHP1012", "Project sources must be sorted by canonical path"))
			orderingDiagnosticAdded = true
		}
		previousPath = source.path
		hasPreviousPath = true
		if source.path == request.entryPath {
			entryFound = true
		}
	}
	if String.length(request.entryPath) > 0 && !entryFound {
		diagnostics = List.append(diagnostics, diagnostic("SHP1008", "Project entry path is missing from sources"))
	}
	if request.emit.target != "es2022" {
		diagnostics = List.append(diagnostics, diagnostic("SHP1009", "Project compiler currently requires the es2022 target"))
	}
	if request.emit.sourceMap {
		diagnostics = List.append(diagnostics, diagnostic("SHP1010", "Project compiler boundary requires source maps to be disabled"))
	}
	if !request.emit.sourcesContent {
		diagnostics = List.append(diagnostics, diagnostic("SHP1011", "Project compiler boundary requires sourcesContent"))
	}
	return diagnostics
}

fn parseProjectSources(sources: List<ProjectCompilerSourceV1>) -> Result<ProjectParseSummary, List<JsonError>> {
	let mut diagnostics: List<ProjectCompilerDiagnosticV1> = []
	let mut modules: List<ProjectLinkModulePayload> = []
	let mut parsedModules = 0
	for source in sources {
		let encoded = parseFrontendCore(source.text)?
		let raw = Json.parse(encoded)?
		let parsed = Json.decode<FrontendParseResult>(raw)?
		parsedModules = parsedModules + 1
		for value in parsed.diagnostics {
			diagnostics = List.append(diagnostics, sourceDiagnostic(source.path, value))
		}
		modules = List.append(modules, ProjectLinkModulePayload {
			path: source.path,
			source: source.text,
			parse: parsed,
		})
	}
	return Ok(ProjectParseSummary {
		diagnostics: diagnostics,
		modules: modules,
		parsedModules: parsedModules,
	})
}

fn appendParsedMvpProjectSource(
	values: List<ParsedMvpProjectSource>,
	source: ProjectCompilerSourceV1,
	parsedEncoded: String,
	parsedModule: MvpModule?,
) -> List<ParsedMvpProjectSource> {
	return match parsedModule {
		Some(moduleValue) => List.append(values, ParsedMvpProjectSource {
			path: source.path,
			parsedEncoded: parsedEncoded,
			moduleValue: moduleValue,
		})
		None => values
	}
}

fn findParsedMvpSource(
	values: List<ParsedMvpProjectSource>,
	path: String,
) -> ParsedMvpProjectSource? {
	for value in values {
		if value.path == path {
			return Some(value)
		}
	}
	return None
}

fn findProjectModule(
	values: List<ProjectLinkModulePayload>,
	path: String,
) -> ProjectLinkModulePayload? {
	for value in values {
		if value.path == path {
			return Some(value)
		}
	}
	return None
}

fn frontendNode(
	values: List<FrontendAstNode>,
	id: Int,
) -> FrontendAstNode? {
	for value in values {
		if value.id == id {
			return Some(value)
		}
	}
	return None
}

fn canonicalImportSource(value: String) -> String {
	let length = String.length(value)
	if length >= 2
		&& String.slice(value, 0, Some(1)) == "\""
		&& String.slice(value, length - 1, None) == "\"" {
		return String.slice(value, 1, Some(length - 1))
	}
	return ""
}

fn frontendImportSpecifier(
	declaration: FrontendAstNode,
	nodes: List<FrontendAstNode>,
) -> String {
	for childId in declaration.children {
		let childValue = frontendNode(nodes, childId)
		if match childValue { Some(_) => true, None => false } {
			let child = match childValue {
				Some(value) => value
				None => panic("Missing frontend import child after presence check")
			}
			if child.kind == "ImportSource" {
				return canonicalImportSource(child.text)
			}
		}
	}
	return ""
}

fn frontendImportBindingText(binding: MvpImportBinding) -> String {
	if binding.importedName == binding.localName {
		return binding.importedName
	}
	return binding.importedName + " as " + binding.localName
}

fn frontendImportHasBinding(
	declaration: FrontendAstNode,
	nodes: List<FrontendAstNode>,
	binding: MvpImportBinding,
) -> Bool {
	let expected = frontendImportBindingText(binding)
	for childId in declaration.children {
		let childValue = frontendNode(nodes, childId)
		if match childValue { Some(_) => true, None => false } {
			let child = match childValue {
				Some(value) => value
				None => panic("Missing frontend import item after presence check")
			}
			if child.kind == "ImportItem" && child.text == expected {
				return true
			}
		}
	}
	return false
}

fn frontendLocalDeclarationKind(kind: String) -> Bool {
	return kind == "FunctionDeclaration"
		|| kind == "RecordDeclaration"
		|| kind == "EnumDeclaration"
		|| kind == "NewtypeDeclaration"
		|| kind == "TypeAliasDeclaration"
		|| kind == "TopLevelValueDeclaration"
}

fn frontendHasLocalDeclarationName(
	projectModule: ProjectLinkModulePayload,
	name: String,
) -> Bool {
	let rootValue = frontendNode(projectModule.parse.nodes, projectModule.parse.root)
	if match rootValue { Some(_) => false, None => true } {
		return true
	}
	let root = match rootValue {
		Some(value) => value
		None => panic("Missing frontend root after presence check")
	}
	for childId in root.children {
		let childValue = frontendNode(projectModule.parse.nodes, childId)
		if match childValue { Some(_) => false, None => true } {
			return true
		}
		let child = match childValue {
			Some(value) => value
			None => panic("Missing frontend declaration after presence check")
		}
		if frontendLocalDeclarationKind(child.kind) && child.text == name {
			return true
		}
	}
	return false
}

fn bindingAllowsValueSignature(
	projectModules: List<ProjectLinkModulePayload>,
	modulePath: String,
	specifier: String,
	binding: MvpImportBinding,
) -> Bool {
	let moduleValue = findProjectModule(projectModules, modulePath)
	if match moduleValue { Some(_) => false, None => true } {
		return false
	}
	let projectModule = match moduleValue {
		Some(value) => value
		None => panic("Missing project module after presence check")
	}
	if frontendHasLocalDeclarationName(projectModule, binding.localName) {
		return false
	}
	let mut matches = 0
	let mut valueMatches = 0
	for node in projectModule.parse.nodes {
		if node.kind == "ImportDeclaration"
			&& String.startsWith(node.text, "virune")
			&& frontendImportSpecifier(node, projectModule.parse.nodes) == specifier
			&& frontendImportHasBinding(node, projectModule.parse.nodes, binding) {
			matches = matches + 1
			if !String.contains(node.text, " type") {
				valueMatches = valueMatches + 1
			}
		}
	}
	return matches == 1 && valueMatches == 1
}

fn projectParameterTypes(parameters: List<MvpParameter>) -> List<MvpType> {
	let mut values: List<MvpType> = []
	for parameter in parameters {
		values = List.append(values, parameter.valueType)
	}
	return values
}

fn importLocalBindingCount(imports: List<MvpImport>, localName: String) -> Int {
	let mut count = 0
	for importValue in imports {
		for binding in importValue.bindings {
			if binding.localName == localName {
				count = count + 1
			}
		}
	}
	return count
}

fn findPublicFunction(
	functions: List<MvpFunction>,
	name: String,
) -> MvpFunction? {
	for function in functions {
		if function.isPublic && function.name == name {
			return Some(function)
		}
	}
	return None
}

fn dependencyTargetPath(
	dependencies: List<ProjectLinkDependency>,
	modulePath: String,
	specifier: String,
) -> String {
	for dependency in dependencies {
		if dependency.modulePath == modulePath && dependency.sourceKind == "virune" && dependency.specifier == specifier {
			return match dependency.resolvedPath {
				Some(value) => value
				None => ""
			}
		}
	}
	return ""
}

fn enumIsPublicExport(
	exports: List<ProjectLinkExport>,
	modulePath: String,
	name: String,
) -> Bool {
	for value in exports {
		if value.modulePath == modulePath && value.name == name && value.declarationKind == "EnumDeclaration" {
			return true
		}
	}
	return false
}

fn publicTypeExportKind(kind: String) -> String {
	if kind == "record" {
		return "RecordDeclaration"
	}
	if kind == "enum" {
		return "EnumDeclaration"
	}
	if kind == "newtype" {
		return "NewtypeDeclaration"
	}
	return ""
}

fn declarationIsPublicTypeExport(
	exports: List<ProjectLinkExport>,
	modulePath: String,
	declaration: SemanticDeclaration,
) -> Bool {
	if !declaration.isPublic || !List.isEmpty(declaration.typeParameters) {
		return false
	}
	let expectedKind = publicTypeExportKind(declaration.kind)
	if String.length(expectedKind) == 0 {
		return false
	}
	for value in exports {
		if value.modulePath == modulePath
			&& value.name == declaration.name
			&& value.declarationKind == expectedKind {
			return true
		}
	}
	return false
}

fn semanticDeclaration(
	values: List<SemanticDeclaration>,
	name: String,
) -> SemanticDeclaration? {
	for value in values {
		if value.name == name {
			return Some(value)
		}
	}
	return None
}

fn semanticDeclarationById(
	values: List<SemanticDeclaration>,
	id: Int,
) -> SemanticDeclaration? {
	for value in values {
		if value.id == id {
			return Some(value)
		}
	}
	return None
}

fn semanticMember(
	values: List<SemanticMember>,
	id: Int,
) -> SemanticMember? {
	for value in values {
		if value.id == id {
			return Some(value)
		}
	}
	return None
}

fn semanticType(
	values: List<SemanticType>,
	id: Int,
) -> SemanticType? {
	for value in values {
		if value.id == id {
			return Some(value)
		}
	}
	return None
}

fn semanticTypeToMvp(values: List<SemanticType>, id: Int) -> MvpType? {
	let candidate = semanticType(values, id)
	if match candidate { Some(_) => false, None => true } {
		return None
	}
	let value = match candidate {
		Some(item) => item
		None => panic("Missing semantic type after presence check")
	}
	if value.kind == "builtin" && List.isEmpty(value.arguments) {
		if value.name == "Bool" {
			return Some(MvpType.BoolType)
		}
		if value.name == "Int" {
			return Some(MvpType.IntType)
		}
		if value.name == "Float" {
			return Some(MvpType.FloatType)
		}
		if value.name == "String" {
			return Some(MvpType.StringType)
		}
		if value.name == "Unit" {
			return Some(MvpType.UnitType)
		}
	}
	if value.kind == "builtin" && value.name == "List" && List.length(value.arguments) == 1 {
		let elementId = match List.get(value.arguments, 0) {
			Some(item) => item
			None => panic("Missing List semantic type argument")
		}
		let element = semanticTypeToMvp(values, elementId)
		return match element {
			Some(item) => listType(item)
			None => None
		}
	}
	if value.kind == "builtin" && value.name == "Option" && List.length(value.arguments) == 1 {
		let elementId = match List.get(value.arguments, 0) {
			Some(item) => item
			None => panic("Missing Option semantic type argument")
		}
		let element = semanticTypeToMvp(values, elementId)
		return match element {
			Some(item) => optionalType(item)
			None => None
		}
	}
	return None
}

fn importedPayloadLocalName(
	projectModule: ParsedMvpProjectSource,
	projectModules: List<ProjectLinkModulePayload>,
	dependencies: List<ProjectLinkDependency>,
	targetPath: String,
	importedName: String,
) -> String {
	let mut matches = 0
	let mut localName = ""
	for importValue in projectModule.moduleValue.imports {
		if dependencyTargetPath(dependencies, projectModule.path, importValue.specifier) == targetPath {
			for candidate in importValue.bindings {
				if candidate.importedName == importedName
					&& importLocalBindingCount(projectModule.moduleValue.imports, candidate.localName) == 1
					&& bindingAllowsValueSignature(
						projectModules,
						projectModule.path,
						importValue.specifier,
						candidate,
					) {
					matches = matches + 1
					localName = candidate.localName
				}
			}
		}
	}
	return if matches == 1 then localName else ""
}

fn semanticPayloadTypeToMvp(
	semantic: FrontendSemanticResult,
	typeId: Int,
	projectModule: ParsedMvpProjectSource,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
	targetPath: String,
) -> MvpType? {
	let direct = semanticTypeToMvp(semantic.types, typeId)
	if match direct { Some(_) => true, None => false } {
		return direct
	}
	let sourceValue = semanticType(semantic.types, typeId)
	if match sourceValue { Some(_) => false, None => true } {
		return None
	}
	let sourceType = match sourceValue {
		Some(value) => value
		None => panic("Missing semantic payload type after presence check")
	}
	if sourceType.kind == "named" && List.isEmpty(sourceType.arguments) {
		let declarationId = match sourceType.declarationId {
			Some(value) => value
			None => -1
		}
		if declarationId >= 0 {
			let declarationValue = semanticDeclarationById(semantic.declarations, declarationId)
			if match declarationValue { Some(_) => true, None => false } {
				let declaration = match declarationValue {
					Some(value) => value
					None => panic("Missing semantic payload declaration after presence check")
				}
				if declaration.name == sourceType.name
					&& declarationIsPublicTypeExport(exports, targetPath, declaration) {
					let localName = importedPayloadLocalName(
						projectModule,
						projectModules,
						dependencies,
						targetPath,
						declaration.name,
					)
					if String.length(localName) > 0 {
						return Some(MvpType.NamedType(localName))
					}
				}
			}
		}
	}
	if sourceType.kind == "builtin" && sourceType.name == "List" && List.length(sourceType.arguments) == 1 {
		let elementId = match List.get(sourceType.arguments, 0) {
			Some(value) => value
			None => panic("Missing List payload type argument")
		}
		let element = semanticPayloadTypeToMvp(
			semantic,
			elementId,
			projectModule,
			projectModules,
			exports,
			dependencies,
			targetPath,
		)
		return match element {
			Some(value) => listType(value)
			None => None
		}
	}
	if sourceType.kind == "builtin" && sourceType.name == "Option" && List.length(sourceType.arguments) == 1 {
		let elementId = match List.get(sourceType.arguments, 0) {
			Some(value) => value
			None => panic("Missing Option payload type argument")
		}
		let element = semanticPayloadTypeToMvp(
			semantic,
			elementId,
			projectModule,
			projectModules,
			exports,
			dependencies,
			targetPath,
		)
		return match element {
			Some(value) => optionalType(value)
			None => None
		}
	}
	return None
}

fn externalVariantPrefix() -> String {
	return "$project$"
}

fn externalNamespaceMarkerVariant() -> String {
	return "$namespace$"
}

fn blockedExternalVariantPrefix() -> String {
	return "$project$blocked$"
}

fn externalNamespaceMarkerName(base: String) -> String {
	return base + "." + externalVariantPrefix() + externalNamespaceMarkerVariant()
}

fn enumNamespaceMarker(binding: MvpImportBinding) -> ProjectExternalSignature {
	return ProjectExternalSignature {
		name: externalNamespaceMarkerName(binding.localName),
		parameters: [],
		returnType: MvpType.NamedType(binding.localName),
		span: binding.span,
	}
}

fn enumConstructorSignatures(
	projectModule: ParsedMvpProjectSource,
	binding: MvpImportBinding,
	targetPath: String,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
) -> Result<List<ProjectExternalSignature>, List<JsonError>> {
	let mut signatures: List<ProjectExternalSignature> = []
	if !enumIsPublicExport(exports, targetPath, binding.importedName) {
		return Ok(signatures)
	}
	let targetValue = findProjectModule(projectModules, targetPath)
	if match targetValue { Some(_) => false, None => true } {
		return Ok(signatures)
	}
	let target = match targetValue {
		Some(value) => value
		None => panic("Missing enum target module after presence check")
	}
	let semanticEncoded = checkFrontendDataTypesJson(target.source)?
	let semanticRaw = Json.parse(semanticEncoded)?
	let semantic = Json.decode<FrontendSemanticResult>(semanticRaw)?
	if !semantic.accepted {
		return Ok(signatures)
	}
	let declarationValue = semanticDeclaration(semantic.declarations, binding.importedName)
	if match declarationValue { Some(_) => false, None => true } {
		return Ok(signatures)
	}
	let declaration = match declarationValue {
		Some(value) => value
		None => panic("Missing enum declaration after presence check")
	}
	if declaration.kind != "enum" || !declaration.isPublic || !List.isEmpty(declaration.typeParameters) {
		return Ok(signatures)
	}
	let mut memberNames: List<String> = []
	for memberId in declaration.memberIds {
		let memberValue = semanticMember(semantic.members, memberId)
		if match memberValue { Some(_) => false, None => true } {
			return Ok(emptyExternalSignatures())
		}
		let member = match memberValue {
			Some(value) => value
			None => panic("Missing enum member after presence check")
		}
		if member.declarationId != declaration.id
			|| member.kind != "variant"
			|| String.length(member.name) == 0
			|| containsPath(memberNames, member.name) {
			return Ok(emptyExternalSignatures())
		}
		memberNames = List.append(memberNames, member.name)
		let mut parameters: List<MvpType> = []
		let mut memberSupported = true
		for typeId in member.typeIds {
			let semanticTypeValue = semanticType(semantic.types, typeId)
			if match semanticTypeValue { Some(_) => false, None => true } {
				return Ok(emptyExternalSignatures())
			}
			let sourceType = match semanticTypeValue {
				Some(value) => value
				None => panic("Missing enum payload type after presence check")
			}
			if sourceType.kind == "error" || sourceType.kind == "missing" {
				return Ok(emptyExternalSignatures())
			}
			let lowered = semanticPayloadTypeToMvp(
				semantic,
				typeId,
				projectModule,
				projectModules,
				exports,
				dependencies,
				targetPath,
			)
			if match lowered { Some(_) => false, None => true } {
				memberSupported = false
			} else {
				parameters = List.append(parameters, match lowered {
					Some(value) => value
					None => MvpType.ErrorType
				})
			}
		}
		if memberSupported {
			signatures = List.append(signatures, ProjectExternalSignature {
				name: binding.localName + "." + externalVariantPrefix() + member.name,
				parameters: parameters,
				returnType: MvpType.NamedType(binding.localName),
				span: binding.span,
			})
		}
	}
	return Ok(signatures)
}

fn importedSignatures(
	projectModule: ParsedMvpProjectSource,
	modules: List<ParsedMvpProjectSource>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
) -> Result<List<ProjectExternalSignature>, List<JsonError>> {
	let mut signatures: List<ProjectExternalSignature> = []
	for importValue in projectModule.moduleValue.imports {
		let targetPath = dependencyTargetPath(
			dependencies,
			projectModule.path,
			importValue.specifier,
		)
		let targetValue = findParsedMvpSource(modules, targetPath)
		if match targetValue { Some(_) => true, None => false } {
			let target = match targetValue {
				Some(value) => value
				None => ParsedMvpProjectSource {
					path: "",
					parsedEncoded: "",
					moduleValue: MvpModule { imports: [], functions: [] },
				}
			}
			for binding in importValue.bindings {
				let functionValue = findPublicFunction(
					target.moduleValue.functions,
					binding.importedName,
				)
				if match functionValue { Some(_) => true, None => false } {
					let function = match functionValue {
						Some(value) => value
						None => MvpFunction {
							isPublic: false,
							name: "",
							parameters: [],
							returnType: MvpType.ErrorType,
							expressions: [],
							statementIds: [],
							statements: [],
							span: binding.span,
						}
					}
					signatures = List.append(signatures, ProjectExternalSignature {
						name: binding.localName,
						parameters: projectParameterTypes(function.parameters),
						returnType: function.returnType,
						span: binding.span,
					})
				}
				if importLocalBindingCount(projectModule.moduleValue.imports, binding.localName) == 1
					&& bindingAllowsValueSignature(
						projectModules,
						projectModule.path,
						importValue.specifier,
						binding,
					) {
					if enumIsPublicExport(exports, targetPath, binding.importedName) {
						signatures = List.append(signatures, enumNamespaceMarker(binding))
					}
					for signature in enumConstructorSignatures(
						projectModule,
						binding,
						targetPath,
						projectModules,
						exports,
						dependencies,
					)? {
						signatures = List.append(signatures, signature)
					}
				}
			}
		}
	}
	return Ok(signatures)
}

fn externalVariantBase(signature: ProjectExternalSignature) -> String {
	let mut dot = -1
	let mut index = 0
	while index < String.length(signature.name) {
		if String.slice(signature.name, index, Some(index + 1)) == "." {
			if dot >= 0 {
				return ""
			}
			dot = index
		}
		index = index + 1
	}
	if dot <= 0 || dot + 1 >= String.length(signature.name) {
		return ""
	}
	let base = String.slice(signature.name, 0, Some(dot))
	let returnName = match signature.returnType {
		NamedType(name) => name
		_ => ""
	}
	return if returnName == base then base else ""
}

fn externalVariantName(signature: ProjectExternalSignature) -> String {
	let base = externalVariantBase(signature)
	if String.length(base) == 0 {
		return ""
	}
	let encoded = String.slice(signature.name, String.length(base) + 1, None)
	let prefix = externalVariantPrefix()
	if !String.startsWith(encoded, prefix) || String.length(encoded) <= String.length(prefix) {
		return ""
	}
	return String.slice(encoded, String.length(prefix), None)
}

fn externalVariantSourceName(signature: ProjectExternalSignature) -> String {
	let base = externalVariantBase(signature)
	let variant = externalVariantName(signature)
	if String.length(base) == 0 || String.length(variant) == 0 || variant == externalNamespaceMarkerVariant() {
		return ""
	}
	return base + "." + variant
}

fn findExternalVariantSignature(
	signatures: List<ProjectExternalSignature>,
	name: String,
) -> ProjectExternalSignature? {
	for signature in signatures {
		let variant = externalVariantName(signature)
		if String.length(variant) > 0
			&& variant != externalNamespaceMarkerVariant()
			&& (signature.name == name || externalVariantSourceName(signature) == name) {
			return Some(signature)
		}
	}
	return None
}

fn externalNamespaceOwned(signatures: List<ProjectExternalSignature>, base: String) -> Bool {
	let marker = externalNamespaceMarkerName(base)
	for signature in signatures {
		if signature.name == marker {
			return true
		}
	}
	return false
}

fn qualifiedSourceBase(value: String) -> String {
	let mut dot = -1
	let mut index = 0
	while index < String.length(value) {
		if String.slice(value, index, Some(index + 1)) == "." {
			if dot >= 0 {
				return ""
			}
			dot = index
		}
		index = index + 1
	}
	if dot <= 0 || dot + 1 >= String.length(value) {
		return ""
	}
	return String.slice(value, 0, Some(dot))
}

fn blockedExternalVariantName(value: String) -> String {
	return blockedExternalVariantPrefix() + value
}

fn blockedExternalVariantSourceName(value: String) -> String {
	let prefix = blockedExternalVariantPrefix()
	if String.startsWith(value, prefix) && String.length(value) > String.length(prefix) {
		return String.slice(value, String.length(prefix), None)
	}
	return ""
}

fn safeExternalSignatures(values: List<ProjectExternalSignature>) -> List<ProjectExternalSignature> {
	let mut signatures: List<ProjectExternalSignature> = []
	for signature in values {
		if String.contains(signature.name, ".") {
			if String.length(externalVariantName(signature)) > 0 {
				signatures = List.append(signatures, signature)
			}
		} else {
			signatures = List.append(signatures, signature)
		}
	}
	return signatures
}

fn expressionTreeContains(
	expressions: List<MvpExpression>,
	rootId: Int,
	targetId: Int,
	seen: List<Int>,
) -> Bool {
	if rootId == targetId {
		return true
	}
	if containsInt(seen, rootId) {
		return true
	}
	let expression = match List.get(expressions, rootId) {
		Some(item) => item
		None => panic("Missing MVP expression arena entry while tracking imported enum shadowing")
	}
	let nextSeen = List.append(seen, rootId)
	for childId in expression.children {
		if expressionTreeContains(expressions, childId, targetId, nextSeen) {
			return true
		}
	}
	return false
}

fn patternTreeBindsBase(
	expressions: List<MvpExpression>,
	rootId: Int,
	base: String,
	seen: List<Int>,
) -> Bool {
	if containsInt(seen, rootId) {
		return true
	}
	let pattern = match List.get(expressions, rootId) {
		Some(item) => item
		None => panic("Missing MVP pattern arena entry while tracking imported enum shadowing")
	}
	if pattern.kind == "patternBinding" && pattern.text == base {
		return true
	}
	let nextSeen = List.append(seen, rootId)
	for childId in pattern.children {
		if patternTreeBindsBase(expressions, childId, base, nextSeen) {
			return true
		}
	}
	return false
}

fn matchPatternShadowsBaseAtExpression(
	value: MvpFunction,
	base: String,
	expressionId: Int,
) -> Bool {
	let mut armId = 0
	for expression in value.expressions {
		if expression.kind == "matchArm" {
			if List.length(expression.children) != 2 {
				if expressionTreeContains(value.expressions, armId, expressionId, []) {
					return true
				}
			} else {
				let patternId = match List.get(expression.children, 0) {
					Some(item) => item
					None => panic("Missing match pattern after arity check")
				}
				let bodyId = match List.get(expression.children, 1) {
					Some(item) => item
					None => panic("Missing match arm body after arity check")
				}
				if expressionTreeContains(value.expressions, bodyId, expressionId, [])
					&& patternTreeBindsBase(value.expressions, patternId, base, []) {
					return true
				}
			}
		}
		armId = armId + 1
	}
	return false
}

fn blockShadowsBaseAtExpression(
	value: MvpFunction,
	statementIds: List<Int>,
	base: String,
	inheritedShadow: Bool,
	expressionId: Int,
) -> Bool {
	let mut shadowed = inheritedShadow
	for statementId in statementIds {
		let statement = match List.get(value.statements, statementId) {
			Some(item) => item
			None => panic("Missing MVP statement arena entry while tracking imported enum shadowing")
		}
		if statementFindsShadowedExpression(value, statement, base, shadowed, expressionId) {
			return true
		}
		if statementIntroducesBase(statement, base) {
			shadowed = true
		}
	}
	return false
}

fn forFindsShadowedExpression(
	value: MvpFunction,
	name: String,
	iterableId: Int,
	bodyIds: List<Int>,
	base: String,
	shadowed: Bool,
	expressionId: Int,
) -> Bool {
	return shadowed && expressionTreeContains(value.expressions, iterableId, expressionId, [])
		|| blockShadowsBaseAtExpression(value, bodyIds, base, shadowed || name == base, expressionId)
}

fn whileFindsShadowedExpression(
	value: MvpFunction,
	conditionId: Int,
	bodyIds: List<Int>,
	base: String,
	shadowed: Bool,
	expressionId: Int,
) -> Bool {
	return shadowed && expressionTreeContains(value.expressions, conditionId, expressionId, [])
		|| blockShadowsBaseAtExpression(value, bodyIds, base, shadowed, expressionId)
}

fn ifFindsShadowedExpression(
	value: MvpFunction,
	conditionId: Int,
	thenIds: List<Int>,
	elseIds: List<Int>,
	base: String,
	shadowed: Bool,
	expressionId: Int,
) -> Bool {
	return shadowed && expressionTreeContains(value.expressions, conditionId, expressionId, [])
		|| blockShadowsBaseAtExpression(value, thenIds, base, shadowed, expressionId)
		|| blockShadowsBaseAtExpression(value, elseIds, base, shadowed, expressionId)
}

fn statementFindsShadowedExpression(
	value: MvpFunction,
	statement: MvpStatement,
	base: String,
	shadowed: Bool,
	expressionId: Int,
) -> Bool {
	return match statement {
		LetValue(_, _, _, initializerId, _) => shadowed && expressionTreeContains(value.expressions, initializerId, expressionId, [])
		AssignValue(_, assignedId, _) => shadowed && expressionTreeContains(value.expressions, assignedId, expressionId, [])
		ForValue(name, iterableId, bodyIds, _) => forFindsShadowedExpression(value, name, iterableId, bodyIds, base, shadowed, expressionId)
		WhileValue(conditionId, bodyIds, _) => whileFindsShadowedExpression(value, conditionId, bodyIds, base, shadowed, expressionId)
		IfValue(conditionId, thenIds, elseIds, _) => ifFindsShadowedExpression(value, conditionId, thenIds, elseIds, base, shadowed, expressionId)
		BreakValue(_) => false
		ContinueValue(_) => false
		ReturnValue(returnId, _) => shadowed && expressionTreeContains(value.expressions, returnId, expressionId, [])
	}
}

fn statementIntroducesBase(statement: MvpStatement, base: String) -> Bool {
	return match statement {
		LetValue(name, _, _, _, _) => name == base
		_ => false
	}
}

fn functionShadowsBaseAtExpression(
	value: MvpFunction,
	base: String,
	expressionId: Int,
) -> Bool {
	for parameter in value.parameters {
		if parameter.name == base {
			return true
		}
	}
	if matchPatternShadowsBaseAtExpression(value, base, expressionId) {
		return true
	}
	return blockShadowsBaseAtExpression(value, value.statementIds, base, false, expressionId)
}

fn blockedExternalVariantExpression(value: MvpExpression) -> MvpExpression {
	return MvpExpression {
		kind: value.kind,
		text: blockedExternalVariantName(value.text),
		literalType: value.literalType,
		children: value.children,
		span: value.span,
	}
}

fn prepareExternalVariantExpression(
	value: MvpExpression,
	functionValue: MvpFunction,
	expressionId: Int,
	signatures: List<ProjectExternalSignature>,
) -> MvpExpression {
	let signatureValue = findExternalVariantSignature(signatures, value.text)
	if match signatureValue { Some(_) => true, None => false } {
		let signature = match signatureValue {
			Some(item) => item
			None => panic("Missing external enum signature after presence check")
		}
		let base = externalVariantBase(signature)
		if String.length(base) == 0 || functionShadowsBaseAtExpression(functionValue, base, expressionId) {
			return blockedExternalVariantExpression(value)
		}
		let parameterCount = List.length(signature.parameters)
		if value.kind == "identifier" && parameterCount == 0 {
			return MvpExpression {
				kind: "call",
				text: signature.name,
				literalType: value.literalType,
				children: value.children,
				span: value.span,
			}
		}
		if value.kind == "call" && parameterCount > 0 {
			return MvpExpression {
				kind: value.kind,
				text: signature.name,
				literalType: value.literalType,
				children: value.children,
				span: value.span,
			}
		}
		return blockedExternalVariantExpression(value)
	}
	let base = qualifiedSourceBase(value.text)
	if String.length(base) > 0 && externalNamespaceOwned(signatures, base) {
		return blockedExternalVariantExpression(value)
	}
	return value
}

fn prepareExternalVariantFunction(
	value: MvpFunction,
	signatures: List<ProjectExternalSignature>,
) -> MvpFunction {
	let mut expressions: List<MvpExpression> = []
	let mut expressionId = 0
	for expression in value.expressions {
		expressions = List.append(expressions, prepareExternalVariantExpression(expression, value, expressionId, signatures))
		expressionId = expressionId + 1
	}
	return MvpFunction {
		isPublic: value.isPublic,
		name: value.name,
		parameters: value.parameters,
		returnType: value.returnType,
		expressions: expressions,
		statementIds: value.statementIds,
		statements: value.statements,
		span: value.span,
	}
}

fn prepareExternalVariantInput(
	encoded: String,
	signatures: List<ProjectExternalSignature>,
) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let parsed = Json.decode<MvpParseTransport>(raw)?
	if match parsed.parsedModule { Some(_) => false, None => true } {
		return Ok(encoded)
	}
	let moduleValue = match parsed.parsedModule {
		Some(value) => value
		None => panic("Missing parsed MVP module after presence check")
	}
	let mut functions: List<MvpFunction> = []
	for function in moduleValue.functions {
		functions = List.append(functions, prepareExternalVariantFunction(function, signatures))
	}
	return Json.encode<MvpParseTransport>(MvpParseTransport {
		parsedModule: Some(MvpModule {
			imports: moduleValue.imports,
			functions: functions,
		}),
		diagnostics: parsed.diagnostics,
	})
}

fn normalizeExternalVariantExpression(
	value: MvpHirExpression,
	signatures: List<ProjectExternalSignature>,
) -> MvpHirExpression {
	let signatureValue = findExternalVariantSignature(signatures, value.text)
	if value.kind == "call" && match signatureValue { Some(_) => true, None => false } {
		let signature = match signatureValue {
			Some(item) => item
			None => panic("Missing external enum HIR signature after presence check")
		}
		if List.isEmpty(signature.parameters) {
			return MvpHirExpression {
				kind: "local",
				text: externalVariantSourceName(signature),
				valueType: value.valueType,
				children: value.children,
				span: value.span,
			}
		}
		return MvpHirExpression {
			kind: "externalVariant",
			text: externalVariantSourceName(signature),
			valueType: value.valueType,
			children: value.children,
			span: value.span,
		}
	}
	return value
}

fn normalizeExternalVariantDiagnostic(value: MvpDiagnostic) -> MvpDiagnostic {
	let unknownPrefix = "Unknown name " + blockedExternalVariantPrefix()
	if value.code == "L1010" && String.startsWith(value.message, unknownPrefix) {
		let sourceName = String.slice(value.message, String.length(unknownPrefix), None)
		return MvpDiagnostic {
			code: value.code,
			severity: value.severity,
			message: "Unknown name " + sourceName,
			span: value.span,
		}
	}
	return value
}

fn normalizeExternalVariantFunction(
	value: MvpHirFunction,
	signatures: List<ProjectExternalSignature>,
) -> MvpHirFunction {
	let mut expressions: List<MvpHirExpression> = []
	for expression in value.expressions {
		expressions = List.append(expressions, normalizeExternalVariantExpression(expression, signatures))
	}
	return MvpHirFunction {
		isPublic: value.isPublic,
		name: value.name,
		parameters: value.parameters,
		returnType: value.returnType,
		expressions: expressions,
		statementIds: value.statementIds,
		statements: value.statements,
		span: value.span,
	}
}

fn normalizeExternalVariantHir(
	encoded: String,
	signatures: List<ProjectExternalSignature>,
) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let checked = Json.decode<MvpCheckTransport>(raw)?
	let mut diagnostics: List<MvpDiagnostic> = []
	for value in checked.diagnostics {
		diagnostics = List.append(diagnostics, normalizeExternalVariantDiagnostic(value))
	}
	if match checked.hirModule { Some(_) => false, None => true } {
		return Json.encode<MvpCheckTransport>(MvpCheckTransport {
			hirModule: None,
			diagnostics: diagnostics,
			exports: checked.exports,
		})
	}
	let hirValue = match checked.hirModule {
		Some(value) => value
		None => panic("Missing checked HIR module after presence check")
	}
	let mut functions: List<MvpHirFunction> = []
	for function in hirValue.functions {
		functions = List.append(functions, normalizeExternalVariantFunction(function, signatures))
	}
	return Json.encode<MvpCheckTransport>(MvpCheckTransport {
		hirModule: Some(MvpHirModule { functions: functions }),
		diagnostics: diagnostics,
		exports: checked.exports,
	})
}

fn compileMvpSource(
	source: ParsedMvpProjectSource,
	externalSignatures: List<ProjectExternalSignature>,
) -> Result<MvpCompilation, List<JsonError>> {
	let signatures = safeExternalSignatures(externalSignatures)
	let externalEncoded = Json.encode<List<ProjectExternalSignature>>(signatures)?
	let prepared = prepareExternalVariantInput(source.parsedEncoded, signatures)?
	let checked = checkMvpProjectJson(prepared, externalEncoded)?
	let normalized = normalizeExternalVariantHir(checked, signatures)?
	let emitted = emitMvpJson(normalized)?
	let raw = Json.parse(emitted)?
	return Json.decode<MvpCompilation>(raw)
}

fn runtimeImportLine() -> String {
	return "import { Err, None, Ok, Some, checkForeignBigInt, checkForeignBool, checkForeignFloat, checkForeignString, debugValue, decodeJsonValue, defensiveCopy, byteCreate, bytesConcat, bytesEmpty, bytesFromBase64, bytesFromHex, bytesFromUtf8, bytesGet, bytesLength, bytesReadInt32, bytesSet, bytesSlice, bytesToBase64, bytesToHex, bytesToUtf8, bytesWriteInt32, mutableBytesCreate, mutableBytesFill, mutableBytesFromBytes, mutableBytesGet, mutableBytesLength, mutableBytesSet, mutableBytesToBytes, durationHours, durationMilliseconds, durationMinutes, durationSeconds, durationToMilliseconds, encodeFfiValue, encodeJsonValue, floatToInt, int16Create, int16ToInt, int32Create, int32ToInt, int64Create, int64ToBigInt, int8Create, int8ToInt, intAdd, intDivide, intMultiply, intNegate, intRemainder, intSubtract, isPropagation, listAll, listAny, listAppend, listConcat, listDrop, listEnumerate, listFilter, listFind, listFirst, listFlatMap, listFold, listGet, listIsEmpty, listIsNotEmpty, listLast, listLength, listMap, listPrepend, listReverse, listTake, listUnique, listUniqueBy, listZip, makeRecord, makeVariant, mapEmpty, mapEntries, mapGet, mapHas, mapKeys, mapMapValues, mapMerge, mapRemove, mapSet, mapSize, mapValues, optionAndThen, optionCollect, optionFilter, optionMap, optionToResult, optionUnwrapOr, panic, parallel, parallelTry, parseJson, propagate, queueDequeue, queueEmpty, queueEnqueue, resultAndThen, resultCollect, resultCollectErrors, resultMap, resultMapError, resultOrElse, resultToOption, resultUnwrapOr, rootTaskContext, runDefers, runDefersAsync, safeCall, safeCallAsync, setAdd, setDifference, setEmpty, setFrom, setHas, setIntersection, setRemove, setSize, setToList, setUnion, stackEmpty, stackPop, stackPush, streamCollect, streamFilter, streamFromList, streamMap, streamTake, stringAt, stringCodePoints, stringContains, stringGraphemeLength, stringGraphemes, stringEndsWith, stringIsEmpty, stringIsNotEmpty, stringJoin, stringNormalizeNfc, stringNormalizeNfd, stringNormalizeNfkc, stringNormalizeNfkd, stringLength, stringReplace, stringSlice, stringSplit, stringStartsWith, stringToLowerCase, stringToUpperCase, stringTrim, stringTrimEnd, stringTrimStart, taskFirstOkBuiltin, taskMapParallelBuiltin, taskRaceBuiltin, taskRetryBuiltin, taskSleepBuiltin, taskSuperviseBuiltin, taskTimeoutBuiltin, uint16Create, uint16ToInt, uint32Create, uint32ToInt, uint64Create, uint64ToBigInt, uint8Create, uint8ToInt, updateRecord, valid, invalid, validationAndThen, validationCollect, validationMap, validateFfiValue, viruneEquals } from '@virune/runtime/v2/index.js';"
}

fn splitLines(value: String) -> List<String> {
	let mut lines: List<String> = []
	let mut current = ""
	for character in String.codePoints(value) {
		if character == "\n" {
			lines = List.append(lines, current)
			current = ""
		} else {
			current = current + character
		}
	}
	if current != "" {
		lines = List.append(lines, current)
	}
	return lines
}

fn outputPath(sourcePath: String) -> String {
	let suffix = ".virune"
	let length = String.length(sourcePath)
	let suffixLength = String.length(suffix)
	let base = if length >= suffixLength && String.slice(sourcePath, length - suffixLength, None) == suffix then String.slice(sourcePath, 0, Some(length - suffixLength)) else sourcePath
	return ".selfhost-output/" + base + ".js"
}

fn runtimeImportSpecifier(specifier: String) -> String {
	let suffix = ".virune"
	let length = String.length(specifier)
	let suffixLength = String.length(suffix)
	if length >= suffixLength && String.slice(specifier, length - suffixLength, None) == suffix {
		return String.slice(specifier, 0, Some(length - suffixLength)) + ".js"
	}
	return specifier
}

fn importBindingText(importedName: String, localName: String) -> String {
	if importedName == localName {
		return importedName
	}
	return importedName + " as " + localName
}

fn runtimeSafeName(name: String) -> String {
	let reserved = [
		"await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete",
		"do", "else", "export", "extends", "false", "finally", "for", "function", "if", "import", "in",
		"instanceof", "let", "new", "null", "return", "static", "super", "switch", "this", "throw", "true",
		"try", "typeof", "var", "void", "while", "with", "yield",
	]
	return if containsPath(reserved, name) then "$v_" + name else name
}

fn enumHasRuntimeValueImporter(
	modules: List<ParsedMvpProjectSource>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
	targetPath: String,
	enumName: String,
) -> Bool {
	if !enumIsPublicExport(exports, targetPath, enumName) {
		return false
	}
	for source in modules {
		if source.path != targetPath {
			for importValue in source.moduleValue.imports {
				if dependencyTargetPath(dependencies, source.path, importValue.specifier) == targetPath {
					for binding in importValue.bindings {
						if binding.importedName == enumName
							&& importLocalBindingCount(source.moduleValue.imports, binding.localName) == 1
							&& bindingAllowsValueSignature(
								projectModules,
								source.path,
								importValue.specifier,
								binding,
							) {
							return true
						}
					}
				}
			}
		}
	}
	return false
}

fn runtimeEnumExportCount(
	modules: List<ParsedMvpProjectSource>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
	targetPath: String,
) -> Int {
	let mut count = 0
	for value in exports {
		if value.modulePath == targetPath
			&& value.declarationKind == "EnumDeclaration"
			&& enumHasRuntimeValueImporter(
				modules,
				projectModules,
				exports,
				dependencies,
				targetPath,
				value.name,
			) {
			count = count + 1
		}
	}
	return count
}

fn runtimeMetadataFailure(path: String) -> ProjectRuntimeSummary {
	return ProjectRuntimeSummary {
		diagnostics: [loweringDiagnostic(path, "SHP3302", "Public enum runtime metadata is incomplete")],
		lines: [],
	}
}

fn publicEnumRuntimeLines(
	projectModule: ProjectLinkModulePayload,
	modules: List<ParsedMvpProjectSource>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
) -> Result<ProjectRuntimeSummary, List<JsonError>> {
	let exportCount = runtimeEnumExportCount(
		modules,
		projectModules,
		exports,
		dependencies,
		projectModule.path,
	)
	if exportCount == 0 {
		return Ok(ProjectRuntimeSummary { diagnostics: [], lines: [] })
	}
	let semanticEncoded = checkFrontendDataTypesJson(projectModule.source)?
	let semanticRaw = Json.parse(semanticEncoded)?
	let semantic = Json.decode<FrontendSemanticResult>(semanticRaw)?
	if !semantic.accepted {
		return Ok(runtimeMetadataFailure(projectModule.path))
	}
	let mut lines: List<String> = []
	let mut emittedNames: List<String> = []
	let mut emittedCount = 0
	for exportValue in exports {
		if exportValue.modulePath == projectModule.path
			&& exportValue.declarationKind == "EnumDeclaration"
			&& enumHasRuntimeValueImporter(
				modules,
				projectModules,
				exports,
				dependencies,
				projectModule.path,
				exportValue.name,
			) {
			let declarationValue = semanticDeclaration(semantic.declarations, exportValue.name)
			if match declarationValue { Some(_) => false, None => true } {
				return Ok(runtimeMetadataFailure(projectModule.path))
			}
			let declaration = match declarationValue {
				Some(value) => value
				None => panic("Missing public enum runtime declaration after presence check")
			}
			let sourceNodeValue = frontendNode(projectModule.parse.nodes, declaration.sourceNodeId)
			if declaration.kind != "enum"
				|| !declaration.isPublic
				|| declaration.name != exportValue.name
				|| containsPath(emittedNames, declaration.name)
				|| match sourceNodeValue { Some(_) => false, None => true } {
				return Ok(runtimeMetadataFailure(projectModule.path))
			}
			let sourceNode = match sourceNodeValue {
				Some(value) => value
				None => panic("Missing public enum frontend node after presence check")
			}
			if sourceNode.kind != "EnumDeclaration" || sourceNode.text != declaration.name {
				return Ok(runtimeMetadataFailure(projectModule.path))
			}
			emittedNames = List.append(emittedNames, declaration.name)
			emittedCount = emittedCount + 1
			let encodedTypeId = Json.encode<String>("project:" + projectModule.path + "#" + declaration.name)?
			let mut memberNames: List<String> = []
			let mut namespaceBindings = ""
			let mut firstMember = true
			lines = List.append(lines, "// enum " + declaration.name)
			for memberId in declaration.memberIds {
				let memberValue = semanticMember(semantic.members, memberId)
				if match memberValue { Some(_) => false, None => true } {
					return Ok(runtimeMetadataFailure(projectModule.path))
				}
				let member = match memberValue {
					Some(value) => value
					None => panic("Missing public enum runtime member after presence check")
				}
				if member.declarationId != declaration.id
					|| member.kind != "variant"
					|| String.length(member.name) == 0
					|| containsPath(memberNames, member.name) {
					return Ok(runtimeMetadataFailure(projectModule.path))
				}
				for typeId in member.typeIds {
					if match semanticType(semantic.types, typeId) { Some(_) => false, None => true } {
						return Ok(runtimeMetadataFailure(projectModule.path))
					}
				}
				memberNames = List.append(memberNames, member.name)
				let runtimeName = runtimeSafeName(member.name)
				if !firstMember {
					namespaceBindings = namespaceBindings + ", "
				}
				namespaceBindings = namespaceBindings + runtimeName
				firstMember = false
				let encodedVariant = Json.encode<String>(member.name)?
				if List.isEmpty(member.typeIds) {
					lines = List.append(lines, "export const " + runtimeName + " = Object.freeze(makeVariant(" + encodedVariant + ", [], " + encodedTypeId + "));")
				} else {
					let mut constructorArguments = ""
					let mut firstArgument = true
					let mut index = 0
					for payloadTypeId in member.typeIds {
						if !firstArgument {
							constructorArguments = constructorArguments + ", "
						}
						constructorArguments = constructorArguments + "$value" + Json.encode<Int>(index)?
						firstArgument = false
						index = index + 1
					}
					lines = List.append(lines, "export function " + runtimeName + "(" + constructorArguments + ") { return makeVariant(" + encodedVariant + ", [" + constructorArguments + "], " + encodedTypeId + "); }")
				}
			}
			lines = List.append(lines, "export const " + runtimeSafeName(declaration.name) + " = Object.freeze({ " + namespaceBindings + " });")
			lines = List.append(lines, "")
		}
	}
	if emittedCount != exportCount {
		return Ok(runtimeMetadataFailure(projectModule.path))
	}
	return Ok(ProjectRuntimeSummary { diagnostics: [], lines: lines })
}

fn valueImportLine(
	projectModule: ParsedMvpProjectSource,
	importValue: MvpImport,
	modules: List<ParsedMvpProjectSource>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
) -> Result<String, List<JsonError>> {
	let targetPath = dependencyTargetPath(dependencies, projectModule.path, importValue.specifier)
	let targetValue = findParsedMvpSource(modules, targetPath)
	if match targetValue { Some(_) => false, None => true } {
		return Ok("")
	}
	let target = match targetValue {
		Some(value) => value
		None => ParsedMvpProjectSource {
			path: "",
			parsedEncoded: "",
			moduleValue: MvpModule { imports: [], functions: [] },
		}
	}
	let mut bindings = ""
	let mut first = true
	for binding in importValue.bindings {
		let functionValue = findPublicFunction(target.moduleValue.functions, binding.importedName)
		let enumAllowed = importLocalBindingCount(projectModule.moduleValue.imports, binding.localName) == 1
			&& bindingAllowsValueSignature(
				projectModules,
				projectModule.path,
				importValue.specifier,
				binding,
			)
			&& enumIsPublicExport(exports, targetPath, binding.importedName)
		if match functionValue { Some(_) => true, None => false } || enumAllowed {
			if !first {
				bindings = bindings + ", "
			}
			bindings = bindings + importBindingText(
				binding.importedName,
				binding.localName,
			)
			first = false
		}
	}
	if first {
		return Ok("")
	}
	let encodedSpecifier = Json.encode<String>(runtimeImportSpecifier(importValue.specifier))?
	return Ok("import { " + bindings + " } from " + encodedSpecifier + ";")
}

fn modulePreamble(
	projectModule: ParsedMvpProjectSource,
	modules: List<ParsedMvpProjectSource>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
) -> Result<List<String>, List<JsonError>> {
	let mut lines: List<String> = [runtimeImportLine()]
	for importValue in projectModule.moduleValue.imports {
		let line = valueImportLine(projectModule, importValue, modules, projectModules, exports, dependencies)?
		if String.length(line) > 0 {
			lines = List.append(lines, line)
		}
	}
	return Ok(lines)
}

fn rejectedLowering(diagnostics: List<ProjectCompilerDiagnosticV1>) -> ProjectLoweringSummary {
	let modules: List<ProjectEmitterModule> = []
	return ProjectLoweringSummary {
		diagnostics: diagnostics,
		modules: modules,
		checkedModules: 0,
	}
}

fn lowerProjectSources(
	sources: List<ProjectCompilerSourceV1>,
	projectModules: List<ProjectLinkModulePayload>,
	exports: List<ProjectLinkExport>,
	dependencies: List<ProjectLinkDependency>,
) -> Result<ProjectLoweringSummary, List<JsonError>> {
	let mut diagnostics: List<ProjectCompilerDiagnosticV1> = []
	let mut parsedSources: List<ParsedMvpProjectSource> = []
	for source in sources {
		let lexed = lexMvpJson(source.text)?
		let parsedEncoded = parseMvpJson(lexed)?
		let raw = Json.parse(parsedEncoded)?
		let parsed = Json.decode<MvpParseTransport>(raw)?
		let hasParseDiagnostics = !List.isEmpty(parsed.diagnostics)
		for value in parsed.diagnostics {
			diagnostics = List.append(diagnostics, mvpDiagnostic(source.path, value))
		}
		let hasParsedModule = match parsed.parsedModule { Some(_) => true, None => false }
		if !hasParseDiagnostics && !hasParsedModule {
			diagnostics = List.append(diagnostics, loweringDiagnostic(
				source.path,
				"SHP3301",
				"MVP lowering parser returned no module without diagnostics",
			))
		}
		if !hasParseDiagnostics && hasParsedModule {
			parsedSources = appendParsedMvpProjectSource(
				parsedSources,
				source,
				parsedEncoded,
				parsed.parsedModule,
			)
		}
	}
	if !List.isEmpty(diagnostics) {
		return Ok(rejectedLowering(diagnostics))
	}

	let mut modules: List<ProjectEmitterModule> = []
	let mut checkedModules = 0
	for source in parsedSources {
		let projectModuleValue = findProjectModule(projectModules, source.path)
		if match projectModuleValue { Some(_) => false, None => true } {
			diagnostics = List.append(diagnostics, loweringDiagnostic(
				source.path,
				"SHP3302",
				"Public enum runtime metadata is incomplete",
			))
			continue
		}
		let projectModule = match projectModuleValue {
			Some(value) => value
			None => panic("Missing project module while emitting public enum runtime")
		}
		let runtimeSummary = publicEnumRuntimeLines(
			projectModule,
			parsedSources,
			projectModules,
			exports,
			dependencies,
		)?
		for value in runtimeSummary.diagnostics {
			diagnostics = List.append(diagnostics, value)
		}
		let compilation = compileMvpSource(
			source,
			importedSignatures(source, parsedSources, projectModules, exports, dependencies)?,
		)?
		checkedModules = checkedModules + 1
		for value in compilation.diagnostics {
			diagnostics = List.append(diagnostics, mvpDiagnostic(source.path, value))
		}
		if compilation.accepted && List.isEmpty(runtimeSummary.diagnostics) {
			let mut statements = runtimeSummary.lines
			for line in splitLines(compilation.codeBody) {
				statements = List.append(statements, line)
			}
			modules = List.append(modules, ProjectEmitterModule {
				sourcePath: source.path,
				outputPath: outputPath(source.path),
				preamble: modulePreamble(source, parsedSources, projectModules, exports, dependencies)?,
				statements: statements,
				sourceMap: "",
			})
		}
	}
	return Ok(ProjectLoweringSummary {
		diagnostics: diagnostics,
		modules: modules,
		checkedModules: checkedModules,
	})
}

fn semanticSymbols(modulePath: String, values: List<ProjectLinkExport>) -> List<ProjectSemanticSymbol> {
	let mut symbols: List<ProjectSemanticSymbol> = []
	for value in values {
		if value.modulePath == modulePath {
			symbols = List.append(symbols, ProjectSemanticSymbol {
				name: value.name,
				declarationKind: value.declarationKind,
				public: true,
				effect: "",
			})
		}
	}
	return symbols
}

fn semanticRequest(modules: List<ProjectLinkModulePayload>, exports: List<ProjectLinkExport>) -> ProjectSemanticRequest {
	let mut values: List<ProjectSemanticModule> = []
	for projectModule in modules {
		values = List.append(values, ProjectSemanticModule {
			path: projectModule.path,
			allowedEffects: emptyTextList(),
			symbols: semanticSymbols(projectModule.path, exports),
			references: emptySemanticReferences(),
		})
	}
	return ProjectSemanticRequest { modules: values }
}

fn compilerDependencies(values: List<ProjectLinkDependency>) -> List<ProjectCompilerDependencyV1> {
	let mut result: List<ProjectCompilerDependencyV1> = []
	for value in values {
		result = List.append(result, ProjectCompilerDependencyV1 {
			modulePath: value.modulePath,
			sourceKind: value.sourceKind,
			specifier: value.specifier,
			resolvedPath: value.resolvedPath,
			typeOnly: value.typeOnly,
			public: value.public,
		})
	}
	return result
}

fn compilerExports(values: List<ProjectLinkExport>) -> List<ProjectCompilerExportedSymbolV1> {
	let mut result: List<ProjectCompilerExportedSymbolV1> = []
	for value in values {
		result = List.append(result, ProjectCompilerExportedSymbolV1 {
			modulePath: value.modulePath,
			name: value.name,
			declarationKind: value.declarationKind,
		})
	}
	return result
}

fn emitterDependencies(values: List<ProjectLinkDependency>) -> List<ProjectEmitterDependency> {
	let mut result: List<ProjectEmitterDependency> = []
	for value in values {
		result = List.append(result, ProjectEmitterDependency {
			modulePath: value.modulePath,
			sourceKind: value.sourceKind,
			specifier: value.specifier,
			resolvedPath: value.resolvedPath,
			typeOnly: value.typeOnly,
			public: value.public,
		})
	}
	return result
}

fn emitterExports(values: List<ProjectLinkExport>) -> List<ProjectEmitterExport> {
	let mut result: List<ProjectEmitterExport> = []
	for value in values {
		result = List.append(result, ProjectEmitterExport {
			modulePath: value.modulePath,
			name: value.name,
			declarationKind: value.declarationKind,
		})
	}
	return result
}

fn compilerModules(values: List<ProjectEmittedModule>) -> List<ProjectCompilerEmittedModuleV1> {
	let mut result: List<ProjectCompilerEmittedModuleV1> = []
	for value in values {
		result = List.append(result, ProjectCompilerEmittedModuleV1 {
			sourcePath: value.sourcePath,
			outputPath: value.outputPath,
			code: value.code,
			sourceMap: value.sourceMap,
		})
	}
	return result
}

fn appendLinkDiagnostics(
	diagnostics: List<ProjectCompilerDiagnosticV1>,
	values: List<ProjectLinkDiagnostic>,
) -> List<ProjectCompilerDiagnosticV1> {
	let mut result = diagnostics
	for value in values {
		result = List.append(result, linkDiagnostic(value))
	}
	return result
}

fn appendSemanticDiagnostics(
	diagnostics: List<ProjectCompilerDiagnosticV1>,
	values: List<ProjectSemanticDiagnostic>,
) -> List<ProjectCompilerDiagnosticV1> {
	let mut result = diagnostics
	for value in values {
		result = List.append(result, semanticDiagnostic(value))
	}
	return result
}

fn encodeResult(
	request: ProjectCompilerRequestV1,
	accepted: Bool,
	diagnostics: List<ProjectCompilerDiagnosticV1>,
	emittedModules: List<ProjectCompilerEmittedModuleV1>,
	dependencies: List<ProjectCompilerDependencyV1>,
	exportedSymbols: List<ProjectCompilerExportedSymbolV1>,
	parsedModules: Int,
	checkedModules: Int,
) -> Result<String, List<JsonError>> {
	return Json.encode<ProjectCompilerResultV1>(ProjectCompilerResultV1 {
		contractVersion: "1",
		languageVersion: "1.0",
		platform: "node",
		entryPath: request.entryPath,
		accepted: accepted,
		diagnostics: diagnostics,
		emittedModules: emittedModules,
		dependencies: dependencies,
		exportedSymbols: exportedSymbols,
		stats: stats(parsedModules, checkedModules, List.length(emittedModules)),
	})
}

fn rejectedResult(
	request: ProjectCompilerRequestV1,
	diagnostics: List<ProjectCompilerDiagnosticV1>,
	dependencies: List<ProjectCompilerDependencyV1>,
	exportedSymbols: List<ProjectCompilerExportedSymbolV1>,
	parsedModules: Int,
	checkedModules: Int,
) -> Result<String, List<JsonError>> {
	return encodeResult(
		request,
		false,
		diagnostics,
		emptyCompilerModules(),
		dependencies,
		exportedSymbols,
		parsedModules,
		checkedModules,
	)
}

pub fn projectCompilerCapabilityJson() -> Result<String, List<JsonError>> {
	return Json.encode<ProjectCompilerCapabilityV1>(ProjectCompilerCapabilityV1 {
		contractVersion: "1",
		ready: true,
		requestSchema: "virune.selfhost.project-compiler.request.v1",
		resultSchema: "virune.selfhost.project-compiler.result.v2",
		blockers: [],
	})
}

pub fn compileProjectMvpJson(encoded: String) -> Result<String, List<JsonError>> {
	let raw = Json.parse(encoded)?
	let request = Json.decode<ProjectCompilerRequestV1>(raw)?
	let requestDiagnostics = validateRequest(request)
	if !List.isEmpty(requestDiagnostics) {
		return rejectedResult(request, requestDiagnostics, emptyCompilerDependencies(), emptyCompilerExports(), 0, 0)
	}

	let parsed = parseProjectSources(request.sources)?
	if !List.isEmpty(parsed.diagnostics) {
		return rejectedResult(request, parsed.diagnostics, emptyCompilerDependencies(), emptyCompilerExports(), parsed.parsedModules, 0)
	}

	let linkRequest = Json.encode<ProjectLinkRequestPayload>(ProjectLinkRequestPayload {
		entryPath: request.entryPath,
		modules: parsed.modules,
	})?
	let linkEncoded = linkProjectJson(linkRequest)?
	let linkRaw = Json.parse(linkEncoded)?
	let linked = Json.decode<ProjectLinkResult>(linkRaw)?
	let dependencies = compilerDependencies(linked.dependencies)
	let exportedSymbols = compilerExports(linked.exportedSymbols)
	if !linked.accepted {
		return rejectedResult(
			request,
			appendLinkDiagnostics(emptyCompilerDiagnostics(), linked.diagnostics),
			dependencies,
			exportedSymbols,
			parsed.parsedModules,
			0,
		)
	}

	let semantics: ProjectSemanticResult = checkProjectSemantics(semanticRequest(parsed.modules, linked.exportedSymbols))
	if !semantics.accepted {
		return rejectedResult(
			request,
			appendSemanticDiagnostics(emptyCompilerDiagnostics(), semantics.diagnostics),
			dependencies,
			exportedSymbols,
			parsed.parsedModules,
			semantics.checkedModules,
		)
	}

	let lowered = lowerProjectSources(request.sources, parsed.modules, linked.exportedSymbols, linked.dependencies)?
	if !List.isEmpty(lowered.diagnostics) {
		return rejectedResult(
			request,
			lowered.diagnostics,
			dependencies,
			exportedSymbols,
			parsed.parsedModules,
			lowered.checkedModules,
		)
	}

	let emitted: ProjectEmitterResult = emitProject(ProjectEmitterRequest {
		entryPath: request.entryPath,
		modules: lowered.modules,
		dependencies: emitterDependencies(linked.dependencies),
		exportedSymbols: emitterExports(linked.exportedSymbols),
	})
	if !emitted.accepted {
		return rejectedResult(
			request,
			[diagnostic("SHP4000", "Deterministic project emission rejected the normalized module set")],
			dependencies,
			exportedSymbols,
			parsed.parsedModules,
			lowered.checkedModules,
		)
	}

	return encodeResult(
		request,
		true,
		emptyCompilerDiagnostics(),
		compilerModules(emitted.emittedModules),
		dependencies,
		exportedSymbols,
		parsed.parsedModules,
		lowered.checkedModules,
	)
}
